      // ── case ──
      const fill = (p) => { $('[data-cat]').textContent = p.category + ' · ' + yearOf(p.ended); titleEl.textContent = p.name;
        $('[data-approach]').textContent = p.approach || ''; $('[data-role]').textContent = p.role || '';
        $('[data-services]').textContent = (p.services || []).join(', '); $('[data-stack]').textContent = (p.stack || []).join(', ');
