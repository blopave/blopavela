      const placeTicks = () => { const y = caseLineY(); ticks.forEach((t, j) => { t.style.transform = `translate(${W * (0.2 + 0.2 * j)}px, ${y}px) translate(-50%,-100%)`; }); };

      // ── pantalla ──
