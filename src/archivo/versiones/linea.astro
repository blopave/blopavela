        setTimeout(() => { if (inCase) titleEl.focus({ preventScroll: true }); }, reduce ? 0 : 650); };
      const placeScrFor = (slug) => { const r = selRect(idxOf(slug)); scr.dataset.side = r.side; setRect(r, true); };
      const switchCase = (slug) => { if (slug === cur) return; infoEl.classList.add('swap');
        setTimeout(() => { openCase(slug, { push: false }); history.replaceState(null, '', '#' + slug); infoEl.classList.remove('swap'); }, reduce ? 0 : 220); };
      const closeCase = (push = true) => { if (!inCase) return; inCase = false; body.classList.remove('in-case'); syncInert();
