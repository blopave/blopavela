        if (push) { if (pushed) { pushed = false; history.back(); } else history.replaceState(null, '', location.pathname + location.search); }
        const keep = cur; media(keep, false); placeScr(false); targets();
        if (coarse && !lastKey) { /* táctil: queda señalado, listo para volver a abrir */ }
        const row = rows.find((r) => r.dataset.slug === keep); if (row && lastKey) setTimeout(() => row.focus({ preventScroll: true }), 60); };

      // ── entrada: puntero, foco, toque, teclado ──
      let leaveT = 0;
      rows.forEach((row) => { const s = row.dataset.slug;
        if (!coarse) { row.addEventListener('pointerenter', () => { clearTimeout(leaveT); select(s); });
          row.addEventListener('pointerleave', () => { clearTimeout(leaveT); leaveT = setTimeout(() => select(null), 160); }); }
        row.addEventListener('focus', () => { clearTimeout(leaveT); select(s); });
