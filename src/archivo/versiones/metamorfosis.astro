        if (push) pushHash('proyectos'); };
      // tilt de la lámina: el puntero sólo fija el TARGET; el rAF lo persigue con lerp
      addEventListener('pointermove', (e) => { if (!inCase) return;
        tilt.tx = (e.clientY / innerHeight - 0.5) * 2; tilt.ty = (e.clientX / innerWidth - 0.5) * 2;
      });
      // shared-element: el nombre clickeado VIAJA hasta convertirse en el título del case,
      // usando el hold del estallido como ventana; el crossfade final tapa el cambio de wrap
      const flipName = (row) => {
        if (reduceMotion) return;
        const src = row.querySelector('.prow__name');
        const a = src.getBoundingClientRect(), b = nameEl.getBoundingClientRect();
        if (!a.width || !b.width) return;
        const cs = getComputedStyle(src);
        const g = document.createElement('span'); g.className = 'flip-name'; g.textContent = src.textContent;
        g.style.left = a.left + 'px'; g.style.top = a.top + 'px';
        g.style.fontSize = cs.fontSize; g.style.letterSpacing = cs.letterSpacing;
        document.body.appendChild(g); caseEl.classList.add('flip');
        const dur = 850, ease = 'cubic-bezier(.22,1,.36,1)';
        g.animate([{ transform: 'translate(0,0) scale(1)' },
          { transform: 'translate(' + (b.left - a.left) + 'px,' + (b.top - a.top) + 'px) scale(' + (b.width / a.width) + ')' }],
          { duration: dur, easing: ease, fill: 'forwards' });
        g.animate([{ opacity: 1 }, { opacity: 1, offset: .7 }, { opacity: 0 }], { duration: dur + 150, easing: 'linear', fill: 'forwards' });
        setTimeout(() => caseEl.classList.remove('flip'), dur - 120);
        setTimeout(() => g.remove(), dur + 200);
      };
      // índice: nombres a la izquierda; la gema queda a la derecha (ambiente). click → case
      // señalar un proyecto (hover en desktop, foco táctil en mobile): la gema escucha y muestra ese sitio
      const point = (row) => { if (!row) return; const proj = projects.find((x) => x.slug === row.dataset.slug);
        const [r, g, b] = hexRGB(row.style.getPropertyValue('--c').trim());
        gemTint.r = r; gemTint.g = g; gemTint.b = b; gemTint.amt = 1;
        hoverProj = proj || null;   // la gema registra qué proyecto señalás
        preloadShots(row.dataset.slug); };
      const unpoint = () => { gemTint.amt = 0; hoverProj = null; };
      // ── foco táctil ──
      // arrastrar el dedo sobre los nombres los recorre (scrub); soltar deja el foco puesto; tocar abre.
      // sin tocar, el foco cicla solo por los proyectos: la gema va mostrando cada sitio (mismo impacto que el hover)
      let focusRow = null, cycleT = 0, idleT = 0;
      const hintEl = document.querySelector('[data-hint]');
      const setFocus = (row) => { if (row === focusRow) return;
        if (focusRow) focusRow.classList.remove('is-focus');
        focusRow = row; indexEl.classList.toggle('has-focus', !!row);
        if (row) { row.classList.add('is-focus'); point(row); } else unpoint(); };
      const cycle = () => { clearTimeout(cycleT);
        if (!coarse || inCase || !entered) return;
        const i = focusRow ? (rows.indexOf(focusRow) + 1) % rows.length : 0;
        setFocus(rows[i]); cycleT = setTimeout(cycle, 4200); };
      const startCycle = (delay) => { clearTimeout(cycleT); if (coarse) cycleT = setTimeout(cycle, delay); };
      if (coarse) {
        let scrubbing = false, sx = 0, sy = 0;
        const rowAt = (x, y) => { const el = document.elementFromPoint(x, y); return el && el.closest ? el.closest('[data-row]') : null; };
        // la banda de nombres entera es superficie de scrub: la fila más cercana en vertical al dedo
        const nearestRow = (y) => { let best = null, bd = 1e9;
          rows.forEach((r) => { const b = r.getBoundingClientRect(), d = Math.abs(b.top + b.height / 2 - y); if (d < bd) { bd = d; best = r; } }); return best; };
        indexEl.addEventListener('pointerdown', (e) => { if (inCase) return; scrubbing = true; sx = e.clientX; sy = e.clientY;
          clearTimeout(cycleT); clearTimeout(idleT); hintEl.classList.remove('on'); setFocus(rowAt(e.clientX, e.clientY) || nearestRow(e.clientY)); });
        indexEl.addEventListener('pointermove', (e) => { if (!scrubbing || inCase) return; setFocus(nearestRow(e.clientY)); });
        const end = () => { if (!scrubbing) return; scrubbing = false; startCycle(7000); };
        indexEl.addEventListener('pointerup', end); indexEl.addEventListener('pointercancel', end);
        // tocar sin arrastrar = abrir; si el dedo arrastró (scrub), el click se descarta antes de llegar a la fila
        indexEl.addEventListener('click', (e) => { if (Math.hypot(e.clientX - sx, e.clientY - sy) > 12) { e.stopPropagation(); e.preventDefault(); } }, true);
      }
      rows.forEach((row) => {
        const tintOn = () => { if (!coarse) point(row); };
        const tintOff = () => { if (!coarse) unpoint(); };
        row.addEventListener('pointerenter', tintOn); row.addEventListener('focus', () => point(row));
        row.addEventListener('pointerleave', tintOff); row.addEventListener('blur', () => { if (!coarse) unpoint(); });
        row.addEventListener('click', () => {
          openCase(row.dataset.slug);
          flipName(row);   // mide el título recién ubicado, por eso va después de openCase
          row.style.transition = 'none'; row.style.opacity = '0';   // el ghost lo reemplaza al instante
          gemTint.amt = 0; hoverProj = null;   // suelta: el ghost del DOM toma la posta
          clearTimeout(cycleT); if (focusRow) { focusRow.classList.remove('is-focus'); focusRow = null; indexEl.classList.remove('has-focus'); }
        });
      });
      document.querySelector('[data-back]').addEventListener('click', () => closeCase());
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && body.classList.contains('in-case')) closeCase(); });
      // home: vuelve a la entrada (cierra el case y rearma la gema)
      const goHome = (push = true) => { clearTimeout(closeT); inCase = false; gemBroken = false; entered = false; caseProj = null;
        clearTimeout(cycleT); setFocus(null);
        tilt.tx = 0; tilt.ty = 0;
        body.classList.remove('in-case'); body.classList.remove('entered'); caseEl.setAttribute('aria-hidden', 'true');
        rows.forEach((r) => { r.style.transition = ''; r.style.opacity = ''; r.style.transitionDelay = '0s'; });
        document.title = 'blopa';
        bootT0 = performance.now();   // volver al home rearma la gema (mismo idioma que la carga)
        if (push) pushHash(''); };
      document.querySelector('[data-home]').addEventListener('click', () => goHome());

      // back/forward del navegador navegan los estados; la carga con hash entra directo
      addEventListener('popstate', () => {
        const h = location.hash.replace('#', '');
        if (projects.some((x) => x.slug === h)) { if (!entered) enter(false); openCase(h, { push: false }); }
        else if (h === 'proyectos') { if (inCase) closeCase(false); else enter(false); }
        else goHome(false);
      });
      { const h = location.hash.replace('#', '');
        if (h === 'proyectos') enter(false);
        else if (projects.some((x) => x.slug === h)) { enter(false); openCase(h, { push: false, instant: true }); } }

      // ── cristal (entrada): icosaedro de hielo con "blopa", idle + parallax; al entrar se achica arriba ──
      const shard = document.querySelector('[data-shard]');
      const gl = shard.getContext('webgl', { alpha: true, premultipliedAlpha: false, antialias: true, powerPreference: 'low-power' });
      if (gl) {
        const STEPS = coarse ? 72 : 110, INSTEPS = coarse ? 26 : 42;
        const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
        const FRAG = `precision highp float;
          uniform vec2 uRes; uniform vec2 uCenter; uniform float uScale; uniform mat3 uRot; uniform float uAber;
          uniform sampler2D uWord; uniform float uWordAmt; uniform float uTime; uniform float uBreak;
          uniform vec3 uTint; uniform float uTintAmt;
          uniform float uWordMode;   // 0 = texto (nombre) · 1 = imagen del sitio (ventana)
          uniform float uRipple;     // onda de superficie (carácter: waveform)
          uniform float uWinFrac;    // alto de la ventana visible dentro del strip (1 = imagen entera)
          uniform float uScroll;     // desplazamiento vertical (scroll del sitio dentro de la gema)
          uniform float uMorph;      // METAMORFOSIS: 0 = gema (icosaedro) · 1 = lámina de cristal 16:10
          uniform sampler2D uVid;    // el sitio en video (o su captura mientras el video llega)
          uniform float uVidAmt;     // cuánto se ve el sitio adentro
          uniform vec2 uSlab;        // medio ancho / medio alto de la lámina (espacio objeto)
          #define PHI 1.61803398875
          float smax(float a,float b,float k){ float h=clamp(0.5+0.5*(a-b)/k,0.,1.); return mix(b,a,h)+k*h*(1.0-h); }
          float sdIco(vec3 p){ p=abs(p); float k=0.034;   /* ESTUDIO: corte más filoso (antes 0.072, se leía gelatina) */
            float d=dot(p,normalize(vec3(1.,1.,1.)));
            d=smax(d,dot(p,normalize(vec3(0.,1.,PHI+1.))),k);
            d=smax(d,dot(p,normalize(vec3(PHI+1.,0.,1.))),k);
            d=smax(d,dot(p,normalize(vec3(1.,PHI+1.,0.))),k);
            return d-1.0; }
          // fractura: al romperse, la superficie se agrieta con celdas de alta frecuencia que laten
          float fracture(vec3 p){ return sin(9.0*p.x+uTime*5.0)*sin(9.0*p.y-uTime*3.0)*sin(9.0*p.z+uTime*2.0); }
          /* METAMORFOSIS: la lámina es una caja de bordes redondeados, fina como un vidrio grueso.
             El morph mezcla las DISTANCIAS (no las formas): en el medio la piedra se aplana y estira,
             se lee como un solo objeto que cambia de estado, no como un fundido entre dos cosas */
          float sdSlab(vec3 p){ vec3 b=vec3(uSlab,0.055); float r=0.05; vec3 q=abs(p)-b+r;
            return length(max(q,0.))+min(max(q.x,max(q.y,q.z)),0.)-r; }
          float sdC(vec3 p){
            // ramas reales (no ternarios: el compilador los aplana y calcula las dos formas siempre)
            /* morph por ETAPAS (se lee como un objeto con intención, no como una mezcla):
               1) 0→0.55: la piedra se aplana en z y se ensancha, CONSERVANDO las facetas (gema tallada plana)
               2) 0.45→1: esa gema plana se funde en la lámina */
            float d; float lip=0.008 + 0.008*sin(uTime*0.7);
            float sq=smoothstep(0.0,0.55,uMorph), bl=smoothstep(0.45,1.0,uMorph);
            if(uMorph<0.001){ d=sdIco(p) - lip; }
            else if(bl>0.999){ d=sdSlab(p); }
            else {
              vec3 k=vec3(mix(1.,1.2,sq), mix(1.,0.84,sq), mix(1.,0.26,sq));
              d=(sdIco(p/k) - lip)*min(k.x,min(k.y,k.z));   // escala no uniforme: cota inferior conservadora
              if(bl>0.001) d=mix(d, sdSlab(p), bl);
            }
            d += uBreak*(1.0-uMorph)*(0.30*fracture(p) + 0.15*fracture(p*2.3));
            d += uRipple*(1.0-uMorph)*0.025*sin(9.0*p.y + uTime*5.0);   // carácter: onda viajera (waveform)
            return d; }
          /* plano medio de la lámina: dónde "vive" la pantalla. El rayo refractado lo corta;
             cada canal con su propio índice → nítido en el centro, dispersado en los cantos */
          vec2 vidUV(vec3 po, vec3 dir){ float t=-po.z/dir.z; return (po.xy+dir.xy*t)/uSlab*0.5+0.5; }
          float inside(vec2 q){ return smoothstep(0.0,0.004,q.x)*(1.0-smoothstep(0.996,1.0,q.x))
                                     *smoothstep(0.0,0.006,q.y)*(1.0-smoothstep(0.994,1.0,q.y)); }
          vec3 nrm(vec3 p){ vec2 e=vec2(0.006,0.);
            return normalize(vec3(sdC(p+e.xyy)-sdC(p-e.xyy),sdC(p+e.yxy)-sdC(p-e.yxy),sdC(p+e.yyx)-sdC(p-e.yyx))); }
          // normal "gruesa": donde diverge de la fina hay una arista → línea de facetado
          vec3 nrmC(vec3 p){ vec2 e=vec2(0.05,0.);
            return normalize(vec3(sdC(p+e.xyy)-sdC(p-e.xyy),sdC(p+e.yxy)-sdC(p-e.yxy),sdC(p+e.yyx)-sdC(p-e.yyx))); }
          /* ESTUDIO: el cristal refracta un estudio de fotografía de producto — paneles rectangulares
             con borde suave (softbox) en vez de lóbulos chicos. Las tiras laterales llevan gelatina
             cian y roja: la firma de color sale de la LUZ y se mueve con la piedra (no fija en pantalla).
             Al señalar un proyecto, las gelatinas toman su accent. */
          float box(vec3 d,vec3 c,vec3 up,vec2 sz,float soft){ c=normalize(c); float k=dot(d,c); if(k<=0.) return 0.;
            vec3 q=d/k-c; vec3 r=normalize(cross(up,c)); vec3 u=cross(c,r);
            vec2 a=abs(vec2(dot(q,r),dot(q,u)));
            return (1.0-smoothstep(sz.x-soft,sz.x,a.x))*(1.0-smoothstep(sz.y-soft,sz.y,a.y)); }
          vec3 env(vec3 d){
            float ea=uTime*0.06; float ec=cos(ea), es=sin(ea); d.xz=mat2(ec,-es,es,ec)*d.xz;
            vec3 gelA=mix(vec3(0.20,0.88,1.0),uTint,uTintAmt*0.8), gelB=mix(vec3(1.0,0.22,0.36),uTint,uTintAmt*0.8);
            vec3 c=mix(vec3(0.010,0.011,0.016),vec3(0.045,0.050,0.066),clamp(d.y*0.5+0.5,0.,1.));
            c+=vec3(1.0,0.99,0.97)*1.5*box(d,vec3(0.,1.,0.15),vec3(0.,0.,1.),vec2(0.55,0.32),0.14);   // softbox cenital
            // gelatinas DETRÁS de la piedra (lo que se ve por refracción) + filetes laterales (lo que refleja el canto)
            c+=gelA*1.6*box(d,vec3(-0.85,0.05,-0.45),vec3(0.,1.,0.),vec2(0.30,1.1),0.14);
            c+=gelB*1.5*box(d,vec3(0.85,-0.05,-0.45),vec3(0.,1.,0.),vec2(0.30,1.1),0.14);
            c+=gelA*1.2*box(d,vec3(-1.,0.05,0.25),vec3(0.,1.,0.),vec2(0.10,0.95),0.05);
            c+=gelB*1.1*box(d,vec3(1.,-0.05,0.2),vec3(0.,1.,0.),vec2(0.10,0.95),0.05);
            c+=vec3(0.80,0.86,1.0)*0.62*box(d,vec3(0.,0.25,-1.),vec3(0.,1.,0.),vec2(0.55,0.5),0.45);  // panel trasero: luz que atraviesa
            c+=vec3(1.0)*1.1*box(d,vec3(-0.35,0.45,1.),vec3(0.,1.,0.),vec2(0.06,0.06),0.025);         // catchlight frontal
            c+=vec3(0.05,0.85,1.0)*pow(max(0.,dot(d,normalize(vec3(-0.55,0.35,0.75)))),6.0)*uAber*1.8;
            c+=vec3(1.0,0.20,0.32)*pow(max(0.,dot(d,normalize(vec3(0.65,-0.25,0.6)))),6.0)*uAber*1.8;
            return c; }
          vec4 shade(vec2 frag, out float ef){ ef=0.;
            vec2 uv=(frag-0.5*uRes)/uRes.y; uv=(uv-uCenter)*uScale;
            vec3 ro=vec3(0.,0.,3.0); vec3 rd=normalize(vec3(uv,-1.75));
            float t=0.; float hit=-1.; float md=1e9;
            for(int i=0;i<${STEPS};i++){ vec3 q=uRot*(ro+rd*t); float d=sdC(q); md=min(md,d);
              if(d<0.0008+0.0007*t){hit=t;break;} t+=d*0.8; if(t>7.)break; }
            float bf=(1.0-smoothstep(0.35,0.9,uBreak));   // se apaga al romperse (sin fantasma)
            if(hit<0.){
              ef=step(md,0.02);
              float e=smoothstep(0.012,0.0,md); float glow=smoothstep(0.20,0.0,md);
              if(e<=0.001&&glow<=0.001){ return vec4(0.); }
              vec3 hc=mix(vec3(0.62,0.72,0.84),uTint,uTintAmt*0.6);   /* ESTUDIO: silueta neutra (el color lo ponen las luces) */
              return vec4((hc*e*0.8+vec3(0.12,0.16,0.24)*glow*glow*0.5)*bf, max(e*0.8,glow*glow*0.32)*bf);
            }
            /* refina el impacto: estabiliza la normal en rayos rasantes (sin esto el borde "puntea") */
            for(int i=0;i<3;i++){ hit+=sdC(uRot*(ro+rd*hit))*0.8; }
            vec3 po=uRot*(ro+rd*hit); vec3 n=nrm(po); vec3 nw=n*uRot;
            float ci=clamp(dot(-rd,nw),0.,1.); float fres=0.04+0.96*pow(1.0-ci,4.0);
            ef=1.0-smoothstep(0.10,0.17,ci);   // sólo el rasante extremo (la silueta misma)
            float iorG=1.52; float disp=0.065+uAber*0.11;   /* ESTUDIO: más 'fuego' (dispersión) en los cantos de las tiras */ vec3 col;
            vec3 rin=refract(rd,nw,1.0/iorG);
            vec3 vc=vec3(0.); float vis=0.;
            if(length(rin)<0.5){ col=env(reflect(rd,nw)); }
            else{
              vec3 rinObj=uRot*rin; float ti=0.02;
              if(uVidAmt>0.001 && rinObj.z<-0.08){
                float vd=disp*1.4;
                vec3 dR=uRot*refract(rd,nw,1.0/(iorG+vd)), dB=uRot*refract(rd,nw,1.0/(iorG-vd));
                vec2 qG=vidUV(po,rinObj), qR=vidUV(po,dR), qB=vidUV(po,dB);
                vc=vec3(texture2D(uVid,qR).r, texture2D(uVid,qG).g, texture2D(uVid,qB).b);
                vis=uVidAmt*inside(qG)*smoothstep(0.08,0.35,-rinObj.z);
              }
              for(int i=0;i<${INSTEPS};i++){ float d=sdC(po+rinObj*ti); if(d>0.)break; ti+=max(0.01,-d)*0.9; if(ti>6.)break; }
              vec3 pe=po+rinObj*ti; vec3 neW=(-nrm(pe))*uRot;
              vec3 oR=refract(rin,neW,iorG+disp),oG=refract(rin,neW,iorG),oB=refract(rin,neW,iorG-disp);
              if(length(oR)<0.5)oR=reflect(rin,neW); if(length(oG)<0.5)oG=reflect(rin,neW); if(length(oB)<0.5)oB=reflect(rin,neW);
              col=vec3(env(oR).r,env(oG).g,env(oB).b);
              col*=exp(-ti*vec3(0.55,0.42,0.28)*0.32)*1.15;
            }
            vec3 rfl=env(reflect(rd,nw)); col=mix(col,rfl,fres*0.7);
            /* curvatura (fina vs gruesa): alta en vértices y uniones de aristas */
            float dnn=1.0-dot(n,nrmC(po));
            /* rim en dos capas: halo suave + línea tensa; atenuado en vértices para que
               las uniones se fundan en vez de "pinchar" con un punto caliente */
            float rim=pow(1.0-ci,2.6), rimT=pow(1.0-ci,4.0);
            float vsoft=1.0-0.55*smoothstep(0.10,0.55,dnn);
            /* ESTUDIO: el rim deja de ser un neón partido cian|rojo; queda una línea fría tenue
               y los colores aparecen sólo donde la piedra refleja las tiras con gelatina */
            vec3 rimC=mix(vec3(0.80,0.88,1.0),uTint,uTintAmt*0.5);
            col+=(rim*0.06+rimT*0.34)*(1.0+uAber*2.6)*rimC*vsoft;
            /* glint de aristas: línea fina de luz donde se quiebran las facetas
               (apagado en la silueta, donde la normal gruesa es inestable y puntea) */
            float eg=smoothstep(0.06,0.5,dnn)*smoothstep(0.0,0.25,ci);
            col+=eg*(0.33+uAber*0.7)*mix(rimC,vec3(0.9,0.95,1.0),0.6);
            col=col/(1.0+col*0.35);   /* ESTUDIO: tone-map suave, los softbox no queman a blanco plano */
            if(vis>0.001){
              /* el sitio queda DEBAJO del vidrio: encima, el reflejo del estudio (fresnel + un velo
                 leve del softbox que se desliza al inclinar) y la línea fría del canto */
              vec3 top=rfl*(fres*0.55+0.035) + (rim*0.06+rimT*0.34)*rimC*vsoft*0.8 + eg*0.25*vec3(0.9,0.95,1.0);
              col=mix(col, vc*0.96 + top, vis);
            }
            if(uWordAmt>0.001){
              float vsc = uWordMode > 0.5 ? 1.0 : 2.7;   // imagen: mapeo cuadrado · texto: comprimido
