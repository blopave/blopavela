      };
      // cierre coreografiado: el collage se comprime de vuelta al centro (cascada inversa)
      // y recién cuando llega el último pane la gema empieza a rearmarse
      const closeCase = (push = true) => { if (!inCase) return;
        // la lámina se repliega en gema (resorte en el render); el dossier se va primero
        inCase = false; tilt.tx = 0; tilt.ty = 0;
        clearTimeout(closeT);
        body.classList.remove('in-case'); caseEl.setAttribute('aria-hidden', 'true');
        rows.forEach((r, i) => { r.style.transition = ''; r.style.opacity = ''; r.style.transitionDelay = (0.35 + i * 0.05).toFixed(2) + 's'; });
        closeT = setTimeout(() => { if (!inCase) { caseProj = null; rows.forEach((r) => { r.style.transitionDelay = '0s'; }); } }, 1100);
        onIndex();   // táctil: el foco vuelve a ciclar
