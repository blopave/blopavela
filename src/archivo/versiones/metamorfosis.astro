          const scMod = 1 - (beat * 0.06 - breathe * 0.045) * (1 - mm);   // el temperamento es de la gema, no de la lámina
          gl.uniform2f(uRes, shard.width, shard.height); gl.uniform2f(uCenter, cx + fx, cy + fyy); gl.uniform1f(uScale, sc * birth * scMod);
          gl.uniform1f(uAber, aber); gl.uniform1f(uWordAmt, wordAmt); gl.uniform1f(uTime, performance.now() * 0.001);
          gl.uniform1f(uBreak, brk); gl.uniform3f(uTint, tintR, tintG, tintB); gl.uniform1f(uTintAmt, tintAmt);
          gl.uniform1f(uWordMode, wordMode); gl.uniform1f(uRipple, chRip * 0.7);
          gl.uniform1f(uWinFrac, winFracV); gl.uniform1f(uScroll, scrollV);
          gl.uniform1f(uMorph, mm); gl.uniform1f(uVidAmt, vidAmt); gl.uniform2f(uSlab, SLAB[0], SLAB[1]);
          gl.uniformMatrix3fv(uRot, false, m);
          gl.clear(gl.COLOR_BUFFER_BIT);
          if (brk < 0.93) gl.drawArrays(gl.TRIANGLES, 0, 3);   // gema rota y apagada (case abierto): no raymarchear de fondo
        };
        // METAMORFOSIS: siempre en loop (la lámina muestra un sitio vivo); con reduced-motion no hay idle ni resortes
        const loop = (t) => { render(t); requestAnimationFrame(loop); }; requestAnimationFrame(loop);
      }
    </script>
  </body>
</html>
