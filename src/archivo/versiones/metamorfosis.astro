---
// VERSIÓN metamorfosis (exploración, ver src/data/versiones.ts) — parte de /v/estudio (material de estudio).
// METAMORFOSIS: la gema no se rompe: se TRANSFORMA en una lámina de cristal 16:10 y el sitio corre adentro (video).
// la gema es la ENTRADA; al hacer click se corre y aparecen los proyectos
// (nombres a la izquierda, gema ambiente a la derecha). Click en un nombre abre el case.
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>blopa</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="blopa — portfolio de Pablo Vela: sitios con firma visual propia, desde Buenos Aires." />
    <meta property="og:title" content="blopa" />
    <meta property="og:description" content="Portfolio de Pablo Vela — sitios con firma visual propia. Buenos Aires." />
    <meta property="og:image" content="https://www.blopavela.com/img/og.jpg" />
    <meta property="og:url" content="https://www.blopavela.com/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://www.blopavela.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-500.woff2') format('woff2'); font-weight:500; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      /* mono de la interfaz (nav, botones, etiquetas): Fragment Mono, igual en todas las compus. Métricas ≈ SF Mono,
         así que el tracking ajustado antes se mantiene. Versión 1.21 del repo oficial (Google Fonts sirve la 1.011),
         subset latin + latin-ext + flechas (↗ → ‹ ·) */
      @font-face { font-family:'Fragment Mono'; src:url('/fonts/FragmentMono-Regular.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --mid:#9c9ea7; --soft:#7b7d86; --dim:#4b4d55; --hair:#22222a;
        --aqua:#24e2e8; --red:#ff3a54;
        --display:'Bebas Neue',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:'Fragment Mono',ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.3rem,4vw,4rem); }
      /* textos chicos: 3 niveles de color (ink 17.7:1 · mid 7.4:1 · soft 4.8:1, todos ≥ WCAG AA 4.5:1; --dim sólo para
         bordes/filetes), 2 tamaños de mono (11px etiquetas · 12px lo accionable, piso de Apple HIG / M3 / Carbon) y un único
         tracking de mayúsculas .08em (Butterick: +5–12%); el wordmark conserva su .16em como firma */
      *{box-sizing:border-box;margin:0}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);min-height:100svh;overflow-x:hidden;
        -webkit-font-smoothing:antialiased;line-height:1.5}
      a{color:inherit;text-decoration:none}
      /* etiquetas en mayúsculas: forma de caja alta para la puntuación de Fragment Mono (· ‹ & quedan centrados en la altura de las mayúsculas) */
      .nav__home,.kase__back,.case__eye,.case__role,.kase__slabel,.kase__stackline,.case__live,:global(.kase__stack li){font-feature-settings:"case"}
      canvas.shard{position:fixed;inset:0;z-index:1;pointer-events:none}

      /* nav: sólo aparece dentro (proyectos/case); la ENTRADA queda limpia, sólo la gema */
      .nav{position:fixed;top:0;left:0;right:0;z-index:8;display:flex;justify-content:space-between;align-items:baseline;
        padding:var(--gut);font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);
        opacity:0;pointer-events:none;transition:opacity .5s var(--ease)}
      /* la BARRA nunca captura clicks (taparía botones que queden bajo su franja de padding,
         como el "‹ Proyectos" en desktop); sólo sus hijos son interactivos */
      body.entered .nav{opacity:1;transition-delay:.3s}
      body.entered .nav .nav__home,body.entered .nav .nav__contact{pointer-events:auto}
      .nav__home{appearance:none;background:none;border:0;font:inherit;font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;
        color:var(--mid);cursor:pointer;transition:color .25s var(--ease),text-shadow .25s var(--ease)}
      /* METAMORFOSIS: la aberración es un EVENTO (hover/foco), nunca un estado de reposo */
      .nav__home:hover{color:var(--ink);text-shadow:-.7px 0 rgba(255,58,84,.6),.7px 0 rgba(36,226,232,.6)}
      .nav__contact{text-transform:none;letter-spacing:0;color:var(--mid);white-space:nowrap;transition:color .25s var(--ease)}
      .nav__mail{color:var(--mid)}
      .nav__contact:hover{color:var(--ink)} .nav__contact:hover .nav__mail{color:var(--ink)}
      /* mobile: se oculta el nombre y queda el MAIL visible (contacto accionable, sin adivinar) */
      @media(max-width:640px){ .nav__who{display:none} }

      /* landing: sólo el disparador; la gema es todo */
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer}
      body.entered .enter{pointer-events:none}

      /* la gema es la ENTRADA y permanece: al entrar se corre a la derecha y deja los nombres a la izquierda */
      canvas.shard{transition:opacity .8s var(--ease)}

      /* índice: nombres alineados a la izquierda; la gema queda a la derecha (ambiente) */
      .index{position:fixed;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:center;
        gap:.2rem;padding:clamp(5rem,12vh,9rem) var(--gut) 4rem;max-width:min(46vw,40rem);
        opacity:0;pointer-events:none;transition:opacity .7s var(--ease)}
      body.entered .index{opacity:1;pointer-events:auto;transition-delay:.3s}
      body.in-case .index{pointer-events:none}
      .prow{appearance:none;background:none;border:0;cursor:pointer;text-align:left;
        display:flex;align-items:baseline;flex-wrap:wrap;gap:.3rem 1rem;padding:.55rem 0;position:relative;isolation:isolate;
        transition:padding .35s var(--ease),opacity .45s var(--ease),transform .45s var(--ease)}
      .prow:hover{padding-left:1rem}
      /* jerarquía: el contenido primario descansa en ink; la aberración cromática es un EVENTO
         (hover/focus), no el estado de reposo — y los hermanos se apagan al elegir uno */
      .prow__name{font-family:var(--display);font-weight:400;font-size:clamp(2.6rem,5.4vw,4.4rem);
        letter-spacing:.01em;line-height:1.0;color:var(--ink);white-space:nowrap;
        transition:color .35s var(--ease),text-shadow .35s var(--ease)}
      .index:hover .prow:not(:hover) .prow__name{color:var(--soft)}
      .prow:hover .prow__name,.prow:focus-visible .prow__name{color:var(--ink);
        text-shadow:-2px 0 var(--red),2px 0 var(--aqua)}
      .prow:focus-visible{outline:none}
      /* METAMORFOSIS: en táctil no hay hover — el FOCO (arrastrar el dedo sobre los nombres, o el ciclo automático)
         cumple el mismo papel: el nombre se enciende, los hermanos se apagan y la gema muestra ese sitio */
      .index.has-focus .prow:not(.is-focus) .prow__name{color:var(--soft)}
      .prow.is-focus .prow__name{color:var(--ink);text-shadow:-2px 0 var(--red),2px 0 var(--aqua)}
      .prow.is-focus{padding-left:1rem}
      .prow.is-focus .prow__arrow{opacity:1;transform:translateX(0)}
      @media(pointer:coarse){ .index{touch-action:none} }
      /* pista táctil: aparece una vez, bajo los nombres */
      .tap-hint{position:fixed;left:var(--gut);bottom:calc(var(--gut) + env(safe-area-inset-bottom,0px));z-index:3;font-family:var(--mono);
        font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);opacity:0;pointer-events:none;
        transition:opacity .6s var(--ease);font-feature-settings:"case"}
      body.entered:not(.in-case) .tap-hint.on{opacity:1}
      @media(pointer:fine){ .tap-hint{display:none} }
      .prow__arrow{opacity:0;color:var(--c);transform:translateX(-6px);
        transition:opacity .3s var(--ease),transform .3s var(--ease)}
      .prow:hover .prow__arrow{opacity:1;transform:translateX(0)}
      /* portrait: la gema queda arriba (mismo criterio W<H del render); los nombres se centran
         en la banda libre bajo la gema — --gemclear lo calcula el JS con la posición/escala reales */
      @media(orientation:portrait){
        .prow{padding:.4rem 0}
        .index{max-width:none;justify-content:center;
          padding-top:calc(var(--gemclear,46svh) + .6rem);
          padding-bottom:clamp(4rem,9vh,5.5rem)}
      }

      /* case como UNA composición: info + stack + collage, centrado, tras el estallido */
      /* el case SCROLLEA cuando no entra (pantallas bajas / mobile): la franja superior queda reservada
         para nav + "‹ Proyectos" (--top) y el contenido se desvanece al pasar por debajo, nunca se pisa */
      .kase{--top:calc(var(--gut) + 5.4rem);position:fixed;inset:0;z-index:6;display:flex;flex-direction:column;
        overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;
        padding:var(--top) var(--gut) calc(clamp(2.5rem,7vh,5rem) + env(safe-area-inset-bottom,0px));
        -webkit-mask-image:linear-gradient(to bottom,transparent calc(var(--top) - 1.4rem),#000 calc(var(--top) - .2rem));
        mask-image:linear-gradient(to bottom,transparent calc(var(--top) - 1.4rem),#000 calc(var(--top) - .2rem));
        opacity:0;visibility:hidden;pointer-events:none;transition:opacity .5s var(--ease),visibility .5s var(--ease)}
      body.in-case .kase,body.in-case .kase__back{opacity:1;visibility:visible;pointer-events:auto;transition-delay:.62s}   /* METAMORFOSIS: el dossier llega cuando la lámina ya casi tomó forma */
      /* al abrir, los nombres se van UNO a UNO (stagger por JS), no en fade grupal */
      body.in-case .prow{opacity:0;transform:translateX(-16px)}

      /* margin:auto centra cuando entra y, cuando no, deja scrollear sin recortar el borde superior */
      .kase__board{margin:auto;flex:none;width:min(100%,84rem);display:grid;grid-template-columns:minmax(0,20rem) 1fr;
        gap:clamp(1.5rem,3vw,3.5rem);align-items:center}

      /* la nav (marca + contacto) queda visible también en el case; el volver va debajo de la marca */
      .kase__back{position:fixed;left:var(--gut);top:calc(var(--gut) + 2.4rem);z-index:9;appearance:none;cursor:pointer;
        display:inline-flex;align-items:center;gap:.55rem;padding:.6rem 1rem .6rem .8rem;border-radius:999px;
        border:1px solid var(--hair);background:rgba(12,12,16,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
        font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);
        opacity:0;visibility:hidden;pointer-events:none;
        transition:opacity .5s var(--ease),visibility .5s var(--ease),color .25s var(--ease),border-color .25s var(--ease),background .25s var(--ease)}
      .kase__back svg{width:.9em;height:.9em;stroke:currentColor;fill:none;stroke-width:2}
      .kase__back:hover{color:var(--ink);border-color:var(--soft);background:rgba(20,20,26,.7)}

      .kase__info{min-width:0}
      .case__eye{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid)}
      /* entrar a un proyecto tiene que sentirse MÁS grande que la lista, no igual */
      .case__title{font-family:var(--display);font-weight:400;font-size:clamp(3.2rem,6vw,5.5rem);line-height:.9;
        letter-spacing:.01em;margin:.4rem 0 0;   /* METAMORFOSIS: título en ink limpio (la aberración es evento) */
        transition:opacity .3s var(--ease)}
      /* shared-element: mientras el ghost del nombre viaja, el título real espera */
      .kase.flip .case__title{opacity:0}
      :global(.flip-name){position:fixed;z-index:10;margin:0;pointer-events:none;font-family:var(--display);
        font-weight:400;line-height:1.0;color:var(--ink);white-space:nowrap;transform-origin:top left;will-change:transform}
      .case__role{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;
        color:var(--mid);margin-top:.7rem}
      .case__approach{margin-top:1rem;color:#c9cbd2;line-height:1.5;font-size:.92rem;max-width:38ch}
      .kase__slabel{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);
        margin:1.6rem 0 .6rem;display:flex;align-items:center;gap:.7rem}
      .kase__slabel::after{content:"";flex:1;height:1px;background:var(--hair)}
      /* jerarquía real: servicios (lo que hiciste) = chips presentes; stack (con qué) = una línea mono terciaria */
      .kase__stack{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem;margin:0;padding:0}
      :global(.kase__stack li){font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);
        border:1px solid #2e2e38;border-radius:6px;padding:.42rem .7rem;white-space:nowrap;
        background:rgba(255,255,255,.02);transition:border-color .25s var(--ease),color .25s var(--ease)}
      :global(.kase__stack li:hover){border-color:var(--soft)}
      .kase__stackline{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;
        color:var(--mid);margin:0}
      .case__live{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.5rem;font-family:var(--mono);font-size:.75rem;
        letter-spacing:.08em;text-transform:uppercase;color:var(--ink);border:1px solid rgba(242,243,245,.26);border-radius:999px;
        padding:.7rem 1.2rem;transition:border-color .3s var(--ease)}
      .case__live span{color:var(--aqua)} .case__live:hover{border-color:var(--aqua)}

      /* METAMORFOSIS: el slot es el lugar que ocupa la lámina — el WebGL lo mide cada cuadro y se apoya encima
         (así la lámina scrollea con el case en mobile y respeta la grilla en desktop) */
      .kase__slot{width:100%;aspect-ratio:16/10;justify-self:center;max-height:calc(100svh - var(--top) - 6rem);pointer-events:none}
      .case__live{position:relative}
      /* indicador de reproducción: el sitio corre, no es una foto */
      .kase__rec{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.1rem;font-family:var(--mono);font-size:.6875rem;
        letter-spacing:.08em;text-transform:uppercase;color:var(--soft);font-feature-settings:"case"}
      .kase__rec i{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(255,58,84,.6);animation:rec 1.6s ease-out infinite}
      @keyframes rec{0%{box-shadow:0 0 0 0 rgba(255,58,84,.55)}100%{box-shadow:0 0 0 8px rgba(255,58,84,0)}}
      @media(max-width:860px){
        .kase__board{margin:0 auto;grid-template-columns:1fr;gap:1.5rem}
        .kase__slot{order:-1;max-height:none}
      }

      @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
    </style>
  </head>
  <body>
    <canvas class="shard" data-shard aria-hidden="true"></canvas>
    <div class="enter" data-enter role="button" tabindex="0" aria-label="Entrar"></div>

    <nav class="nav" aria-label="Navegación">
      <button type="button" class="nav__home" data-home>blopa</button>
      <a class="nav__contact" href="mailto:blopave@pm.me"><span class="nav__who">Pablo Vela<span class="nav__sep" aria-hidden="true"> · </span></span><span class="nav__mail">blopave@pm.me ↗</span></a>
    </nav>
    <section class="index" data-index>
      {projects.map((p) => (
        <button type="button" class="prow" data-row data-slug={p.slug} style={`--c:${p.accent}`}>
          <span class="prow__name">{p.name}</span>
          <span class="prow__arrow" aria-hidden="true">→</span>
        </button>
      ))}
    </section>

    <p class="tap-hint" data-hint aria-hidden="true">Deslizá sobre los nombres · tocá para abrir</p>
    <section class="kase" data-case aria-hidden="true">
      <div class="kase__board">
        <div class="kase__info">
          <p class="case__eye" data-cat></p>
          <h2 class="case__title" data-name></h2>
          <p class="case__role" data-role></p>
          <p class="case__approach" data-approach></p>
          <p class="kase__slabel">Servicios</p>
          <ul class="kase__stack" data-services></ul>
          <p class="kase__slabel">Stack</p>
          <p class="kase__stackline" data-stack></p>
          <a class="case__live" data-live target="_blank" rel="noopener">Ver en vivo <span aria-hidden="true">↗</span></a>
          <p class="kase__rec"><i aria-hidden="true"></i>El sitio, recorrido en vivo</p>
        </div>
        <div class="kase__slot" data-slot aria-hidden="true"></div>
      </div>
    </section>
    <button type="button" class="kase__back" data-back aria-label="Volver a proyectos">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Proyectos
    </button>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const DPR = Math.min(coarse ? 1.4 : 2, window.devicePixelRatio || 1);

      // ── entrada / galería / case ──
      // balance del índice en portrait: los nombres se centran en la banda libre bajo la gema.
      // MOB_SC / MOB_CY son la escala y altura de la gema en el índice mobile (las usa también el render).
      const MOB_SC = 2.1, MOB_CY = 0.28;
      const indexEl = document.querySelector('[data-index]');
      const balanceIndex = () => {
        const W = innerWidth, H = innerHeight;
        if (W >= H) { indexEl.style.removeProperty('--gemclear'); return; }
        const fit = 0.6 + 0.7 * (H / W);
        const gemBottom = (0.5 - MOB_CY + 1 / (MOB_SC * fit)) * H;   // borde inferior de la gema, en px
        indexEl.style.setProperty('--gemclear', Math.round(gemBottom) + 'px');
      };
      balanceIndex(); addEventListener('resize', balanceIndex);

      let entered = false;
      let bootT0 = performance.now();   // carga: la gema se ARMA (el quiebre del case, invertido)
      // la URL refleja el estado (#proyectos / #slug) para que back/forward y los deep-links funcionen.
      // Embebido (p.ej. en /ver, donde dos copias comparten el historial de la ventana) se usa
      // replaceState: la URL del marco se mantiene sin apilar entradas cruzadas entre iframes.
      const FRAMED = (() => { try { return window.self !== window.top; } catch { return true; } })();
      const pushHash = (h) => { const target = h ? '#' + h : '';
        if (location.hash === target) return;
        const url = location.pathname + target;
        if (FRAMED) history.replaceState(null, '', url); else history.pushState(null, '', url); };
      const enter = (push = true) => { if (entered) return; entered = true; body.classList.add('entered');
        if (push) pushHash('proyectos'); onIndex(); };
      // índice visible: en táctil, la pista aparece y el foco empieza a ciclar solo
      let hintShown = false;
      const onIndex = () => { if (typeof startCycle !== 'function') return;
        startCycle(1600);
        if (coarse && !hintShown) { hintShown = true; setTimeout(() => { if (!inCase) hintEl.classList.add('on'); }, 1200);
          setTimeout(() => hintEl.classList.remove('on'), 7000); } };
      const enterEl = document.querySelector('[data-enter]');
      enterEl.addEventListener('click', () => enter());
      enterEl.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enter(); } });
      addEventListener('wheel', (e) => { if (!entered && e.deltaY > 6) enter(); }, { passive: true });

      // case en el mismo lugar: la gema se rompe → ficha (izq) + collage (der)
      let inCase = false, caseT0 = 0, gemBroken = false, closeT = 0;
      let caseProj = null, morphInstant = false;   // METAMORFOSIS: proyecto cuyo sitio corre dentro de la lámina (gemBroken queda siempre false: no hay quiebre)
      const caseEl = document.querySelector('[data-case]');
      const catEl = caseEl.querySelector('[data-cat]'), nameEl = caseEl.querySelector('[data-name]'),
        approachEl = caseEl.querySelector('[data-approach]'), servicesEl = caseEl.querySelector('[data-services]'),
        liveEl = caseEl.querySelector('[data-live]'), slotEl = caseEl.querySelector('[data-slot]'),
        stackEl = caseEl.querySelector('[data-stack]'), roleEl = caseEl.querySelector('[data-role]');
      const rows = Array.from(document.querySelectorAll('[data-row]'));
      // precarga predictiva: al apuntar un proyecto ya se piden sus capturas
      const preloaded = new Set();
      const preloadShots = (slug) => { if (preloaded.has(slug)) return; preloaded.add(slug);
        const p = projects.find((x) => x.slug === slug);
        ((p && p.shots) || []).forEach((u) => { const im = new Image(); im.src = u; }); };
      // la gema dialoga con el índice: el hover tiñe su rim con el accent del proyecto (lo lee el render)
      const gemTint = { r: 1, g: 1, b: 1, amt: 0 };
      // interacción pre-click gema↔proyecto (definida en /lab): la gema escucha (cabeceo),
      // muestra el sitio refractado en scroll (ventana) y toma el temperamento del proyecto (carácter).
      // la fractura queda exclusiva del click: el estallido al entrar.
      let hoverProj = null;    // proyecto señalado (o null)
      // carácter (B): el temperamento de cada proyecto vive en projects.ts (campo `character`)
      const NEUTRAL = { spin: 1, ripple: 0, pulse: 0, breathe: 0 };
      const hexRGB = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
      // tilt de la lámina (-1..1): el puntero fija el target; el render lo persigue y gira el OBJETO 3D
      const tilt = { tx: 0, ty: 0 };
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      // instant = deep-link al cargar: sin re-animar el estallido (la gema entra ya rota)
      const openCase = (slug, { push = true, instant = false } = {}) => {
        const p = projects.find((x) => x.slug === slug); if (!p) return;
        clearTimeout(closeT); caseEl.scrollTop = 0;
        catEl.textContent = p.category + ' · ' + yearOf(p.ended);
        nameEl.textContent = p.name; roleEl.textContent = p.role || ''; approachEl.textContent = p.approach || '';
        servicesEl.innerHTML = (p.services || []).map((s) => '<li>' + s + '</li>').join('');
        stackEl.textContent = (p.stack || []).join(' · ');
        if (p.url) { liveEl.href = p.url; liveEl.style.display = ''; } else { liveEl.style.display = 'none'; }
        // METAMORFOSIS: no hay collage — la gema misma se vuelve la pantalla (ver render: morph + video)
        caseProj = p;
        // los nombres se van uno a uno hacia la izquierda
        rows.forEach((r, i) => { r.style.transitionDelay = instant ? '0s' : (i * 0.045).toFixed(3) + 's'; });
        caseT0 = performance.now() - (instant ? 1400 : 0); morphInstant = instant;
        inCase = true; body.classList.add('in-case'); caseEl.setAttribute('aria-hidden', 'false');
        document.title = 'blopa — ' + p.name;
