          const dimT = inCase ? 0.035 : entered ? (mob ? 0.14 : 0.24) : 0.28;
          dimV += (dimT - dimV) * lp(3);
          gl.uniform2f(uWallOff, offX, offY); gl.uniform1f(uWallH, wallHpx); const magT = gemBroken ? 2.9 : (hoverProj || look ? 1.12 : 1.45);   // al abrir: zoom que "absorbe" el sitio
          magV += (magT - magV) * lp(gemBroken ? 7 : 3); gl.uniform1f(uMag, magV);
          const ex = (look && EXPO[look.slug]) || 1; expoV += (ex - expoV) * lp(4); gl.uniform1f(uExpo, expoV);
