          } else if (!drag && !reduceMotion) { const dv = entered ? 1 : 3.2; offX += dt * 14 * dv; offY += dt * 6 * dv; }   // deriva: el muro corre (más en la entrada, se ve pasar dentro de la lente)
          setVideo(look && entered && brk < 0.9 ? look.slug : null);   // un solo video: al apagarse la gema, queda sólo el del case
          const touring = !!(look && !hoverProj);
          if (look !== lookShown || touring !== touringShown) { lookShown = look; touringShown = touring;
            rows.forEach((r) => { const on = !!look && r.dataset.slug === look.slug; r.classList.toggle('is-look', on); r.classList.toggle('touring', on && touring); });
            indexEl.classList.toggle('has-look', !!look); }
          // señal: mientras la lupa recorre sola en táctil, debajo se insinúa que se puede arrastrar
          const hintOn = entered && !inCase && !dragged && (mob || !hasPointer);
          if (hintOn !== hintShown) { hintShown = hintOn; hintEl.classList.toggle('on', hintOn); }
          if (hintOn) hintEl.style.top = Math.round(gemPos.y + gemPos.r * 1.3 + 14) + 'px';
          if (touring) { const r = rows[projects.indexOf(look)]; if (r) r.style.setProperty('--prog', Math.min(1, tourT / 4.6).toFixed(3)); }
          const vv = vidSlug && vids[vidSlug];
          const vOk = vv && vv.readyState >= 2;
          if (vOk) { gl.activeTexture(gl.TEXTURE2); gl.bindTexture(gl.TEXTURE_2D, vidTex); gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, vv); }
          vidAmt += (((vOk && look) ? 1 : 0) - vidAmt) * lp(5);
          const vIdx = vidSlug ? projects.findIndex((x) => x.slug === vidSlug) : 0;
          // qué sostiene la gema: landing = wordmark 'blopa'; índice = ventana (el sitio en scroll)
          let token = null, winFracV = 1, scrollV = 0;
          if (!entered) token = 'blopa';   // landing: el wordmark flota sobre el muro aumentado
          applyTexture(token);
          const wt = (wordReady && token && !gemBroken && brk < 0.12) ? 1 : 0;
          wordAmt += (wt - wordAmt) * lp(entered ? 8.5 : 3.7);
          pmx += (mtx - pmx) * lp(3.7); pmy += (mty - pmy) * lp(3.7);
          const vel = Math.hypot(mtx - pmx, mty - pmy) * (0.0166 / Math.max(dt, 0.008));
          aber += ((Math.min(1, vel * 30) * 0.5) - aber) * lp(6.3);
          aber = Math.max(aber, burst * 1.4, Math.min(0.8, Math.hypot(gvx, gvy) * 0.9));   // la velocidad de la lupa abre la dispersión
          // idle: mecido desincronizado + mira al cursor (menos parallax cuando es motivo chico)
          // al escuchar (att), sigue al cursor con más ganas: se "clava" en el nombre señalado
          const pk = (1 - ent * 0.7) * (1 + att * 1.3);
          // sesgo de orientación hacia los nombres: desktop están a la izquierda (yaw); mobile abajo (pitch)
          const aimYaw = mob ? 0 : -0.5 * att;
          const aimPitch = mob ? 0.32 * att : 0;
          // rotación orgánica: varias frecuencias desincronizadas (no mecánico) + parallax + atención
          const ay = gvx * 0.35 + (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07 + Math.sin(a * 0.12 + 1.3) * 0.055) + pmx * 0.6 * pk + aimYaw;
          const ax = -gvy * 0.35 + (0.12 + Math.sin(a * 0.33) * 0.07 + Math.sin(a * 0.17 + 0.6) * 0.045) - pmy * 0.45 * pk + aimPitch;
          const az = Math.sin(a * 0.21 + 2.0) * 0.06 + Math.sin(a * 0.09) * 0.04;   // roll sutil: tumble orgánico
