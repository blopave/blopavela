        let a = 0, aber = 0, ent = 0, sc = 0, cx = 0, cy = 0, gvx = 0, gvy = 0, wordAmt = 0, brk = reduceMotion ? 0 : 0.85, last = 0, scInit = false, att = 0;
        let chSpin = 1, chRip = 0, chPulse = 0, chBreath = 0;   // carácter (B) suavizado
        let tintR = 1, tintG = 1, tintB = 1, tintAmt = 0, tX = 0, tY = 0, dimV = 0, magV = 1.45, lookShown = null, touringShown = false, hintShown = false, expoV = 1;
        const EXPO = { basslayer: 3.6 };   // homes tenues: exposición propia dentro de la lente
