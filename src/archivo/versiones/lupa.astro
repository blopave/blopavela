          gl.uniform1f(uBreak, brk); gl.uniform3f(uTint, tintR, tintG, tintB); gl.uniform1f(uTintAmt, tintAmt);
          gl.uniform1f(uWordMode, wordMode); gl.uniform1f(uRipple, chRip * 0.7);
          gl.uniform1f(uWinFrac, winFracV); gl.uniform1f(uScroll, scrollV);
          gl.uniformMatrix3fv(uRot, false, m);
