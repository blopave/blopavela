            const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const x = cs / 1.15; brkT = 0.85 * Math.pow(1 - x, 3); }
          }
          // tinte del rim (accent del proyecto hovereado) + micro-pulso de fractura en hover
          if (lookShown && !hoverProj && !gemBroken) { const [r, g, b] = hexRGB(lookShown.accent); gemTint.r = r; gemTint.g = g; gemTint.b = b; gemTint.amt = 1; }
          else if (!hoverProj) gemTint.amt = 0;
          tintAmt += (gemTint.amt - tintAmt) * lp(6);
          tintR += (gemTint.r - tintR) * lp(6); tintG += (gemTint.g - tintG) * lp(6); tintB += (gemTint.b - tintB) * lp(6);
          // LUPA: sin temblor de fractura en hover (manchaba la lente)
          brk += (brkT - brk) * lp(gemBroken ? 30 : 7.5);
          const burst = brk * (1 - brk) * 4.0;
          // nacimiento: la gema se origina en el centro y crece hacia afuera mientras se arma
          // (uScale es inverso: más grande = gema más chica en pantalla)
          let birth = 1;
          if (!inCase && !reduceMotion) { const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const g = 1 - Math.pow(1 - cs / 1.15, 3); birth = 1 / (0.06 + 0.94 * g); } }
          const mob = W < H; const fit = mob ? 0.6 + 0.7 * (H / W) : 1;
          // landing: grande y centrado; índice: la gema se corre a la derecha (nombres a la izquierda)
          const scT = (entered ? (mob ? MOB_SC : (hoverProj ? 1.95 : 2.6)) : (mob ? 1.7 : 1.95)) * fit * (1 + brk * 0.75);
          if (!scInit) { sc = scT; scInit = true; }   // sin zoom-lerp inicial: el nacimiento manda
          sc += (scT - sc) * lp(3.7);
          // LUPA: la gema sigue al cursor (con inercia) — en la entrada apenas se asoma hacia él (así se descubre);
          // al señalar un nombre vuelve a su lugar a la derecha y el muro trae ESE sitio debajo
          const asp = W / Math.max(H, 1), curX = mtx * asp, curY = -mty;
          let cxT, cyT;
          // deriva: la lupa recorre sola (lenta, desincronizada); el resorte convierte esa deriva en velocidad
          // → inclinación + dispersión viva desde el primer cuadro. Más amplia en la entrada; sutil en el índice
          const wa = reduceMotion ? 0 : (!entered ? (mob ? 0.05 : 0.085) : (hoverProj ? 0.012 : 0.03)), tw = now / 1000;
          const wx = wa * (Math.sin(tw * 0.53) + 0.45 * Math.sin(tw * 1.31 + 1.7)), wy = wa * 0.7 * (Math.sin(tw * 0.41 + 0.9) + 0.4 * Math.sin(tw * 1.07));
          if (mob || !hasPointer) { cxT = entered ? 0 : 0; cyT = entered ? (mob ? MOB_CY : 0) : 0.02; }
          else if (!entered) { cxT = curX * 0.22; cyT = 0.02 + curY * 0.22; }
          else if (hoverProj) { cxT = 0.30; cyT = 0; }
          else { cxT = Math.max(-asp * 0.5 + 0.2, Math.min(asp * 0.5 - 0.2, curX)); cyT = Math.max(-0.32, Math.min(0.32, curY)); }
          // resorte críticamente amortiguado (sin rebote, con inercia real): la VELOCIDAD inclina la gema y
          // abre la dispersión — la lupa "pesa" al moverla
          cxT += wx; cyT += wy;
          if (gemBroken) { cxT = cx; cyT = cy; gvx = 0; gvy = 0; }   // al abrir, la lupa se queda: de ahí nace el visor
          const om = entered && !hoverProj ? 8.5 : 6.5;
          gvx += ((cxT - cx) * om * om - 2 * om * gvx) * dt; gvy += ((cyT - cy) * om * om - 2 * om * gvy) * dt;
          cx += gvx * dt; cy += gvy * dt;
          if (reduceMotion) { cx = cxT; cy = cyT; gvx = 0; gvy = 0; }
          // muro: qué proyecto mira la lupa (hover, o el recorrido automático en táctil/inactivo)
          const idle = (now - lastTouch) > 3200;
          let look = (hoverProj && !gemBroken) ? hoverProj : null;
          if (gemBroken && brk < 0.9 && curSlug) look = projects.find((x) => x.slug === curSlug) || null;   // absorbe el sitio abierto
          if (!look && entered && !gemBroken && (mob || !hasPointer) && idle) {
            tourT += dt; if (tourT > 4.6) { tourT = 0; tourI = (tourI + 1) % projects.length; }
            look = projects[tourI]; }
          const wallHpx = wallHOf();
          if (look) { const i = projects.indexOf(look), sl = slotOf(i);
            const gx = sl[0] + sl[2] / 2, gy = sl[1] + sl[3] / 2;
            // el centro de la gema (cx,cy en pantalla) cae sobre el centro de la captura grande
            const tx = gx - cx * wallHpx, ty = gy + cy * wallHpx;
