        addEventListener('pointerup', () => { if (!entered || inCase || !(innerWidth < innerHeight || !hasPointer)) return;
          const hw = wallHOf(), lx = offX + cx * hw, ly = offY - cy * hw; let best = 0, bd = 1e12;
          projects.forEach((_, i) => { const sl = slotOf(i), gx = sl[0] + sl[2] / 2, gy = sl[1] + sl[3] / 2;
            const dx = nearest(gx, lx, WALL_W) - lx, dy = nearest(gy, ly, WALL_H) - ly, d = dx * dx + dy * dy; if (d < bd) { bd = d; best = i; } });
