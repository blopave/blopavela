      // ── orientaciones: 4 caras reales del icosaedro (subconjunto tetraédrico de las normales (±1,±1,±1)) ──
      const nrz = (v) => { const l = Math.hypot(v[0], v[1], v[2]); return [v[0] / l, v[1] / l, v[2] / l]; };
