---
// VERSIÓN facetas (fue el home hasta 2026-11-04; ahora exploración, ver src/data/versiones.ts).
// La gema deja de ser logo y pasa a ser LA INTERFAZ:
//  · entrada = la gema sola con BLOPA (sin texto), respira hacia el usuario.
//  · índice = 4 facetas reales del icosaedro son los 4 proyectos. Drag / rueda / flechas / swipe / giroscopio
//    la giran con un resorte críticamente amortiguado y SNAP a cada faceta. Un haz fijo entra a la piedra;
//    la faceta de frente lo proyecta sobre una pantalla. El desenfoque y la separación cian/rojo salen del
//    DESALINEO real entre la normal de esa faceta y la dirección de la pantalla: al encajar, las tintas
//    registran a blanco ("Registro": la aberración significa una sola cosa = enfocar).
//  · case = la composición viaja por el haz: la gema sube como proyector y la pantalla se vuelve el visor
//    del case (video recto, sin glow); volver deshace el mismo camino.
// Técnica: UN contexto WebGL. Pase 1 = sala (haz, abanico, polvo, pantalla con el video) a pantalla
// completa; pase 2 = gema raymarcheada SÓLO en su caja (viewport+scissor), con 3 rebotes internos y TIR.
// Presupuesto: canvas ≤ ~2,5 Mpx, DPR adaptativo por tiempo de frame, un solo video decodificando,
// contexto perdido/restaurado, fallback HTML sin WebGL, reduced-motion = render por demanda.
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>blopa</title>
    <meta name="description" content="blopa — portfolio de Pablo Vela: sitios con firma visual propia, desde Buenos Aires." />
    <meta property="og:title" content="blopa" />
    <meta property="og:description" content="Portfolio de Pablo Vela — sitios con firma visual propia. Buenos Aires." />
    <meta property="og:image" content="https://www.blopavela.com/img/og.jpg" />
    <meta property="og:url" content="https://www.blopavela.com/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://www.blopavela.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Fragment Mono'; src:url('/fonts/FragmentMono-Regular.woff2') format('woff2'); font-weight:400; font-display:swap; }
      /* sistema (reglas de la auditoría) — un solo borde (--gut), dos tamaños de mono (11/13px), un tracking,
         3 grises ≥ 4.5:1; la aberración sólo como evento (enfocar / hover de un nombre) */
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --mid:#9c9ea7; --soft:#7b7d86; --hair:#24242c;
        --aqua:#24e2e8; --red:#ff3a54;
        --display:'Bebas Neue',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:'Fragment Mono',ui-monospace,'SF Mono',Menlo,monospace; --m11:.6875rem; --m13:.8125rem; --trk:.08em;
        --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.25rem,4.4vw,4rem); --top:calc(var(--gut) + 4.6rem); }
      *{box-sizing:border-box;margin:0}
      html,body{height:100%}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);overflow:hidden;
        -webkit-font-smoothing:antialiased;line-height:1.5}
      a{color:inherit;text-decoration:none}
      button{font:inherit;color:inherit}
      :focus{outline:none}
      :focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:2px}
      .prow:focus-visible{outline-offset:6px}
      .mono{font-family:var(--mono);letter-spacing:var(--trk);text-transform:uppercase;font-feature-settings:"case"}

      canvas.gl{position:fixed;inset:0;z-index:1;pointer-events:none}
      /* slots: sólo MEDIDAS (dónde va la gema / la pantalla en cada estado); el JS los mide y la luz los sigue */
      .slot{position:fixed;visibility:hidden;pointer-events:none}
      #g-land{left:50%;top:50%;width:min(68vh,58vw);aspect-ratio:1;transform:translate(-50%,-50%)}
      #g-idx{left:34.5vw;top:50%;width:min(28vh,19vw);aspect-ratio:1;transform:translate(-50%,-50%)}
      #s-idx{left:54vw;width:min(41.5vw,78vh);aspect-ratio:16/10;top:50%;transform:translateY(-50%)}

      /* entrada: toda la pantalla es el disparador (la gema es todo) */
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer;background:none;border:0}
      body.entered .enter{display:none}

      .nav{position:fixed;top:0;left:0;right:0;z-index:8;display:flex;justify-content:space-between;align-items:baseline;
        padding:var(--gut);font-size:var(--m11);color:var(--mid);opacity:0;transition:opacity .6s var(--ease);pointer-events:none}
      body.entered .nav{opacity:1;transition-delay:.35s}
      .nav a,.nav button{pointer-events:auto}
      .nav__home{appearance:none;background:none;border:0;cursor:pointer;letter-spacing:.16em;color:var(--mid);
        font-size:.75rem;transition:color .25s,text-shadow .25s}
      .nav__home:hover{color:var(--ink);text-shadow:-.7px 0 rgba(255,58,84,.6),.7px 0 rgba(36,226,232,.6)}
      .nav__snd{appearance:none;background:none;border:0;cursor:pointer;color:var(--soft);font-size:var(--m11);display:inline-flex;align-items:center;
        gap:3px;padding:15px 10px;margin:-15px auto -15px 1.4rem;transition:color .25s}
      .nav__snd i{display:block;width:2px;height:4px;background:currentColor;border-radius:1px;transition:height .3s var(--ease)}
      .nav__snd span{margin-left:.5rem}
      .nav__snd[aria-pressed="true"]{color:var(--ink)}
      .nav__snd[aria-pressed="true"] i{animation:eq 1.1s ease-in-out infinite}
      .nav__snd[aria-pressed="true"] i:nth-child(2){animation-delay:-.35s} .nav__snd[aria-pressed="true"] i:nth-child(3){animation-delay:-.7s}
      @keyframes eq{0%,100%{height:4px}50%{height:11px}}
      @media(max-width:640px){ .nav__snd span{display:none} .nav__snd{margin-left:.6rem} }
      .nav__contact{text-transform:none;letter-spacing:0;white-space:nowrap;transition:color .25s;font-size:.75rem;padding:15px 0;margin:-15px 0}   /* ≥12px y zona táctil 44px */
      .nav__contact:hover{color:var(--ink)}
      @media(max-width:640px){ .nav__who{display:none} }

      /* zona de arrastre del índice (detrás de los nombres) */
      .drag{position:fixed;inset:0;z-index:4;touch-action:pan-y;cursor:grab;display:none}   /* encima de la pantalla: arrastrar en cualquier lado gira; un tap sobre la pantalla abre */
      body.entered:not(.in-case) .drag{display:block}
      .drag:active{cursor:grabbing}
      /* la pantalla del índice es clickeable (abre el proyecto en foco) */
      .scrhit{position:fixed;z-index:3;cursor:pointer;background:none;border:0;padding:0;display:none}
      body.entered:not(.in-case) .scrhit{display:block}
      .scr__label{position:fixed;z-index:3;font-size:var(--m11);color:var(--mid);display:flex;justify-content:space-between;gap:1rem;
        opacity:0;transition:opacity .5s var(--ease);pointer-events:none}
      body.entered:not(.in-case) .scr__label{opacity:1;transition-delay:.7s}
      .scr__label b{font-weight:400;color:var(--ink)}
      .ticks{display:flex;gap:5px;align-items:center;margin:0 auto}
      .ticks i{display:block;width:14px;height:2px;background:var(--hair);transition:background .35s var(--ease),width .35s var(--ease)}
      .ticks i.on{background:var(--ink);width:22px}
      body.peek .ticks i.on + i{background:var(--mid);width:18px}   /* el amague también se ve en los ticks */

      /* índice: lista REAL de botones, sincronizada con la faceta de frente */
      .index{position:fixed;z-index:5;left:var(--gut);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;
        opacity:0;transition:opacity .6s var(--ease);pointer-events:none}
      body.entered:not(.in-case) .index{opacity:1;pointer-events:auto;transition-delay:.45s}
      .prow{appearance:none;background:none;border:0;cursor:pointer;text-align:left;padding:.3rem 0;min-height:44px;
        display:flex;align-items:baseline;gap:.9rem}
      .prow__name{font-family:var(--display);font-size:clamp(2.2rem,3.7vw,3.5rem);line-height:1;letter-spacing:.01em;
        color:var(--soft);transition:color .35s var(--ease),text-shadow .35s var(--ease);white-space:nowrap}
      .prow__n{font-family:var(--mono);font-size:var(--m11);letter-spacing:var(--trk);color:var(--soft);opacity:.0;transition:opacity .35s}
      .prow.on .prow__name{color:var(--ink)}
      .prow.on .prow__n{opacity:1}
      .prow:hover .prow__name{text-shadow:-2px 0 var(--red),2px 0 var(--aqua);color:var(--ink)}
      
      /* case: colofón a la izquierda, visor (la pantalla convertida) a la derecha */
      .kase{position:fixed;inset:0;z-index:6;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;
        opacity:0;visibility:hidden;transition:opacity .45s var(--ease),visibility .45s;padding:var(--top) var(--gut) calc(3rem + env(safe-area-inset-bottom,0px))}
      body.in-case .kase{opacity:1;visibility:visible}
      .kase__grid{min-height:100%;display:grid;grid-template-columns:clamp(17rem,25vw,23rem) minmax(0,1fr);gap:clamp(1.5rem,4vw,4.5rem);align-items:center}
      .kase__info{opacity:0;transform:translateY(10px);transition:opacity .5s var(--ease),transform .6s var(--ease)}
      body.case-ready .kase__info{opacity:1;transform:none}
      .kase__info.swap{opacity:0!important}
      .case__eye{font-size:var(--m11);color:var(--mid)}
      .case__title:focus{outline:none}
      .case__title{font-family:var(--display);font-weight:400;font-size:clamp(3.4rem,6.6vw,6rem);line-height:.88;letter-spacing:.01em;margin:.45rem 0 0}
      .case__approach{margin-top:1.1rem;font-size:1rem;line-height:1.5;color:#cfd1d8;max-width:44ch}
      .cred{display:grid;grid-template-columns:6.5rem 1fr;margin:1.6rem 0 0;border-top:1px solid var(--hair)}
      .cred dt,.cred dd{padding:.62rem 0;border-bottom:1px solid var(--hair);margin:0}
      .cred dt{font-size:var(--m11);color:var(--soft);padding-top:.78rem}
      .cred dd{font-size:.9375rem;color:var(--ink)}
      .cred dd.soft{color:var(--mid)}
      .kase__acts{display:flex;flex-direction:column;align-items:flex-start;gap:.3rem;margin-top:1.4rem}
      .kase__acts .btn--ghost{padding-left:0}   /* "Siguiente" a ras de la columna */
      .btn{display:inline-flex;align-items:center;gap:.55rem;min-height:44px;padding:0 1.1rem;border-radius:999px;font-size:var(--m13);
        border:1px solid rgba(242,243,245,.28);background:none;cursor:pointer;transition:border-color .25s,background .25s}
      .btn:hover{border-color:var(--ink)}
      .btn--ghost{border-color:transparent;color:var(--mid)}
      .btn--ghost b{font-weight:400;color:var(--ink)}
      .btn--ghost:hover{border-color:var(--hair);color:var(--ink)}
      .kase__view{position:relative;width:min(100%,calc((100svh - var(--top) - 4.5rem) * 1.6));margin-left:auto;aspect-ratio:16/10;border-radius:3px;overflow:hidden;background:#000}
      .kase__view img,.kase__view video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;display:block}
      .kase__view{opacity:0;transition:opacity .3s var(--ease)}
      body.case-ready .kase__view{opacity:1}
      body.case-ready .kase__view.swap{opacity:0}
      .kase__media{position:relative}
      .kase__view{box-shadow:none}
      .kase__view.reg img,.kase__view.reg video{animation:reg .5s var(--ease)}
      @keyframes reg{from{filter:drop-shadow(-7px 0 rgba(255,58,84,.75)) drop-shadow(7px 0 rgba(36,226,232,.75)) blur(2px)}to{filter:none}}   /* las tintas registran */
      .kase__view::after{content:"";position:absolute;inset:0;border:1px solid #ffffff14;border-radius:3px;pointer-events:none}
      #g-case{position:absolute;visibility:hidden;pointer-events:none;width:clamp(56px,7.5vh,84px);aspect-ratio:1;left:calc(-1 * clamp(56px,7.5vh,84px) - 32px);top:calc(-1 * clamp(56px,7.5vh,84px) - 32px)}   /* fuera de la retícula del trabajo (≥32px) */
      .kase__back{position:fixed;left:var(--gut);top:calc(var(--gut) + 2.1rem);z-index:9;appearance:none;cursor:pointer;
        display:inline-flex;align-items:center;gap:.55rem;min-height:44px;padding:0 1rem 0 .8rem;border-radius:999px;
        border:1px solid var(--hair);background:rgba(12,12,16,.6);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
        font-size:var(--m11);color:var(--mid);opacity:0;visibility:hidden;transition:opacity .45s var(--ease),visibility .45s,color .25s}
      body.in-case .kase__back{opacity:1;visibility:visible;transition-delay:.4s}
      .kase__back:hover{color:var(--ink)}
      .kase__back svg{width:.9em;height:.9em;stroke:currentColor;fill:none;stroke-width:2}

      /* sin WebGL: la versión HTML entera (h1, lista, cases con poster) */
      .nogl-h1{display:none}
      body.no-gl .nogl-h1{display:block;position:fixed;left:var(--gut);top:calc(var(--gut) + 2.4rem);z-index:5;font-family:var(--display);
        font-weight:400;font-size:clamp(2.6rem,6vw,4.6rem);line-height:.9;letter-spacing:.01em}
      body.no-gl.in-case .nogl-h1{display:none}
      body.no-gl .nogl-h1 small{display:block;font-family:var(--mono);font-size:var(--m11);letter-spacing:var(--trk);color:var(--mid);margin-top:.6rem}
      body.no-gl .enter{display:none}
      body.no-gl .index{top:auto;bottom:calc(var(--gut) * 1.5);transform:none}
      body.no-gl .scrhit,body.no-gl .scr__label{display:none}
      body.no-gl .kase__view{opacity:1}
      /* el h1 accesible del sitio (visualmente oculto con WebGL) */
      .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

      /* ── PORTRAIT (mobile): el haz baja vertical; gema arriba, pantalla a todo el ancho, nombres abajo ── */
      @media (orientation:portrait){
        #g-land{width:min(80vw,52svh);top:47%}
        /* el sitio MOBILE se proyecta en una pantalla-teléfono vertical (720×1558) a la derecha; los nombres a la izquierda */
        #g-idx{left:44%;top:calc(var(--gut) + 3rem + min(10svh,21vw));width:min(20svh,42vw)}
        #s-idx{left:auto;right:var(--gut);width:min(43vw,calc((100svh - 13.5rem - min(20svh,42vw)) * .462));aspect-ratio:720/1558;
          top:calc(var(--gut) + 5.2rem + min(20svh,42vw));transform:none}
        .index{top:auto;bottom:auto;transform:none}   /* el JS lo centra en la altura de la pantalla-teléfono */
        .scr__label span:first-child,.scr__label b{display:none}
        .prow__n{display:none}   /* en vertical el número lo dicen los ticks; no roza la pantalla */   /* en vertical sólo los ticks de las 4 caras */
        .ticks{margin:0 auto}
        .prow{min-height:46px;padding:.1rem 0}
        .prow__name{font-size:clamp(1.8rem,8.2vw,2.6rem)}
        .kase{padding-top:calc(var(--gut) + 5.6rem)}
        .kase__grid{grid-template-columns:minmax(0,1fr);gap:1.6rem;align-items:start;min-height:0}
        .kase__view{width:100%;aspect-ratio:auto;height:min(62svh,calc((100vw - 2 * var(--gut)) * 2.16))}   /* el sitio mobile a todo el ancho; el título asoma en el primer pantallazo */
        .kase__media{order:-1}
        .case__title{font-size:clamp(3rem,14vw,4.6rem)}
        #g-case{width:52px;left:auto;right:0;top:-3.9rem}
        .kase__acts .btn{background:var(--bg)}
        .kase__acts::before{content:"";position:absolute;left:calc(-1 * var(--gut));right:calc(-1 * var(--gut));top:0;bottom:calc(-3rem - env(safe-area-inset-bottom,0px));
          background:linear-gradient(transparent,var(--bg) 1rem);z-index:-1}
        .kase__acts{position:sticky;z-index:1;bottom:calc(.6rem + env(safe-area-inset-bottom,0px));
          padding-top:1rem;margin-top:1rem}
        .kase__acts{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;flex-wrap:nowrap;align-items:stretch}
        .kase__acts .btn--ghost{padding-left:.7rem}
        .kase__acts .btn{justify-content:center;white-space:nowrap;min-width:0;padding:0 .7rem;overflow:hidden}
        .kase__acts .btn--ghost{border-color:var(--hair)}
        .kase__acts .btn--ghost b{overflow:hidden;text-overflow:ellipsis}
        .nx-l{display:none}
        .kase__info{padding-bottom:calc(44px + 1.5rem)}   /* alto de la barra + 24px: nada queda debajo */
        .kase{padding-bottom:calc(1.5rem + env(safe-area-inset-bottom,0px))}
      }
      @media (prefers-reduced-motion:reduce){*{transition-duration:.01s!important;transition-delay:0s!important;animation:none!important}}
    </style>
  </head>
  <body>
    <h1 class="sr">BLOPA — Pablo Vela, diseño y desarrollo de sitios</h1>
    <canvas class="gl" data-gl aria-hidden="true"></canvas>
    <div class="slot" id="g-land"></div><div class="slot" id="g-idx"></div><div class="slot" id="s-idx"></div>

    <p class="nogl-h1" aria-hidden="true">BLOPA<small>Pablo Vela — sitios con firma visual propia</small></p>
    <button type="button" class="enter" data-enter aria-label="Entrar a los proyectos"></button>

    <nav class="nav mono" aria-label="Navegación">
      <button type="button" class="nav__home mono" data-home>blopa</button>
      <button type="button" class="nav__snd mono" data-snd aria-pressed="false" aria-label="Sonido"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><span>Sonido</span></button>
      <a class="nav__contact" href="mailto:blopave@pm.me"><span class="nav__who">Pablo Vela · </span>blopave@pm.me ↗</a>
    </nav>

    <div class="drag" data-drag aria-hidden="true"></div>
    <button type="button" class="scrhit" data-scrhit aria-label="Abrir el proyecto en foco"></button>
    <p class="scr__label mono" data-label aria-live="polite"><span data-label-a></span><span class="ticks" data-ticks aria-hidden="true">{projects.map(() => <i></i>)}</span><b data-label-b></b></p>
    <p class="sr" data-hint>Arrastrá la gema o usá las flechas ← → para recorrer los proyectos; Enter abre.</p>

    <main>
    <section class="index" data-index aria-label="Proyectos">
      {projects.map((p, i) => (
        <button type="button" class="prow" data-row data-slug={p.slug} data-i={i}>
          <span class="prow__name">{p.name}</span>
          <span class="prow__n">{String(i + 1).padStart(2, '0')}</span>
        </button>
      ))}
    </section>

    <section class="kase" data-case aria-label="Proyecto">
      <div class="kase__grid">
        <div class="kase__info" data-info>
          <p class="case__eye mono" data-cat></p>
          <h2 class="case__title" data-name tabindex="-1"></h2>
          <p class="case__approach" data-approach></p>
          <dl class="cred">
            <dt class="mono">Tipo</dt><dd data-kind></dd>
            <dt class="mono">Rol</dt><dd data-role></dd>
            <dt class="mono">Servicios</dt><dd data-services></dd>
            <dt class="mono">Stack</dt><dd class="soft" data-stack></dd>
          </dl>
          <div class="kase__acts">
            <a class="btn mono" data-live target="_blank" rel="noopener">Ver en vivo <span aria-hidden="true">↗</span></a>
            <button type="button" class="btn btn--ghost mono" data-next><span class="nx-l">Siguiente&nbsp;</span><b data-next-name></b>&nbsp;→</button>
          </div>
        </div>
        <div class="kase__media">
          <div id="g-case"></div>
          <div class="kase__view" data-view><img data-vposter alt="" /></div>
        </div>
      </div>
    </section>
    <button type="button" class="kase__back mono" data-back aria-label="Volver a proyectos">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Proyectos
    </button>
    </main>
    <noscript><style>.nogl-h1{display:block!important;position:static!important;padding:var(--gut)}.index{position:static!important;opacity:1!important;transform:none!important;padding:0 var(--gut)}.enter,.drag,.scrhit,.kase,.kase__back,canvas{display:none!important}body{overflow:auto!important}.nav{opacity:1!important}</style>
      <ul style="padding:var(--gut);list-style:none">{projects.map((p) => <li style="margin:0 0 1.4rem"><a href={p.url} style="font-family:var(--display);font-size:2rem">{p.name} ↗</a><p style="color:#c9cbd2;max-width:44ch">{p.approach}</p><p style="font-family:var(--mono);font-size:.75rem;color:#9c9ea7">{p.category} · {(p.services || []).join(', ')} · {(p.stack || []).join(', ')}</p></li>)}</ul></noscript>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const $ = (s, r = document) => r.querySelector(s);
      const N = projects.length;
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      const mod = (a, n) => ((a % n) + n) % n;
      const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
      const ease = (x) => (x <= 0 ? 0 : x >= 1 ? 1 : x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const portrait = () => innerWidth < innerHeight;

      // ── estado ──
      let entered = false, inCase = false, caseReady = false, peeked = false;
