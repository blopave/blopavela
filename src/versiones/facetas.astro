          const [pg, ng] = projPts(traceBeam(R, Ls, 2.42, beamOff), G2[0], G2[1], sc), [pr] = projPts(traceBeam(R, Ls, 2.52, beamOff), G2[0], G2[1], sc), [pb] = projPts(traceBeam(R, Ls, 2.32, beamOff), G2[0], G2[1], sc);   // índice de diamante: más reflexión total → rebotes visibles
          gl.uniform2fv(V['uPG[0]'], pg); gl.uniform2fv(V['uPR[0]'], pr); gl.uniform2fv(V['uPB[0]'], pb); gl.uniform1f(V.uPn, ng); gl.uniform1f(V.uSs, s);
          gl.uniform3f(V.uPC, flashC[0], flashC[1], flashC[2]);
          gl.uniform1f(V.uBeam, reduceMotion ? 1 : lerp(.85 * clamp(bs / .5, 0, 1), 1, eP)); gl.uniform1f(V.uAlpha, gemA * clamp(birth * 1.4, 0, 1));
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        }
        // hitbox + cartela siguen a la pantalla
        const hk = `left:${sr.x | 0}px;top:${sr.y | 0}px;width:${sr.w | 0}px;height:${sr.h | 0}px`; if (hk !== hitKey) { hitKey = hk; hitEl.style.cssText = hk; }
        const lk = W + 'x' + H; if (lk !== layKey) { layKey = lk; placeStatic(sI); }   // layout estático sólo al cambiar el viewport
        // ¿hace falta seguir? (reduced-motion: por demanda)
        if (!reduceMotion) requestAnimationFrame(frame);
      };
      frameRef = frame;
      // pausa con la pestaña oculta (video incluido)
      document.addEventListener('visibilitychange', () => { if (document.hidden) Object.values(vids).forEach((v) => v.pause());
        else if (playing) { const v = vids[playing]; if (v) v.play().catch(() => {}); } });
      // scroll del case (mobile): el GL sigue los rects
      caseEl.addEventListener('scroll', kick, { passive: true });

      // deep-link al cargar (la versión en /ver siempre entra por el home)
      { const h = location.hash.replace('#', '');
        if (h === 'proyectos') enter(false);
        else if (projects.some((x) => x.slug === h)) openCase(h, { push: false, instant: true }); }
      requestAnimationFrame(frame);
    </script>
  </body>
