---
// VERSIÓN «SOL» — Olafur Eliasson (The Weather Project, Turbine Hall 2003) + Roger Deakins (la neblina de sodio).
// Un sol enorme cuelga en la niebla: la mitad de abajo es real, la de arriba es su reflejo en el techo espejado.
// Luz de una sola frecuencia: toda la escena (y la captura del proyecto, en duotono negro → color → blanco) queda
// teñida del color del proyecto. BLOPA es una silueta contra el sol; sus letras cortan haces de sombra en la niebla.
// Entrada: el sol se enciende de a poco entre la niebla y hace un cambio solo. Deslizar: el sol se pone (la mitad real
// baja, el reflejo sube, todo se apaga), el color cambia y vuelve a encenderse, con titileo de lámpara de sodio.
// El dedo (o el mouse) aparta la niebla. Tocar abre el case: la captura pasa de monocromo a color y se abre a pantalla.
// Técnica: WebGL crudo, un shader a resolución reducida (táctil ×0.55, DPR ≤ 1.5; desktop DPR ≤ 2). La silueta nítida
// es un canvas 2D; el shader usa una copia chica para los haces y el fantasma del reflejo. Sin JS: lista legible.
import { projects } from '../data/projects';

const hue = (hex: string) => {
  const n = parseInt(hex.slice(1), 16), r = (n >> 16) / 255, g = ((n >> 8) & 255) / 255, b = (n & 255) / 255;
  const mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn;
  if (!d) return 0;
  let h = mx === r ? ((g - b) / d) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4;
  h *= 60; if (h < 0) h += 360;
  return h > 330 ? h - 360 : h;
};
const orden = [...projects].sort((a, b) => hue(a.accent) - hue(b.accent));
const year = (e: string) => (e ? e.split('-')[0] : 'En curso');
const data = JSON.stringify(orden.map((p) => ({ slug: p.slug, name: p.name, category: p.category, ended: p.ended, accent: p.accent, url: p.url,
  approach: p.approach, services: p.services, stack: p.stack })));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>blopa — Pablo Vela</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="blopa — Pablo Vela" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FragmentMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');if(innerHeight>innerWidth||innerWidth<640)d.classList.add('port');})();</script>
    <style is:global>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:block; }
      @font-face { font-family:'Fragment Mono'; src:url('/fonts/FragmentMono-Regular.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#07070a; --ink:#f2f3f5; --mid:#9c9ea7; --soft:#7b7d86; --hair:#22222a; --cy:#24e2e8; --rd:#ff3a54;
        --display:'Bebas Neue',Impact,'Arial Narrow',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:'Fragment Mono',ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1rem,3vw,3rem);
        --tb:56px; --acc:#e0bd76 }
      html.port{--tb:calc(env(safe-area-inset-top,0px) + 52px)}
      *{box-sizing:border-box;margin:0}
      html,body{height:100%}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);overflow:hidden;-webkit-font-smoothing:antialiased;line-height:1.5;
        overscroll-behavior:none;min-height:100dvh}
      html.js body{touch-action:none;-webkit-user-select:none;user-select:none}
      a{color:inherit;text-decoration:none}
      :is(button,a):focus-visible{outline:1px solid var(--ink);outline-offset:4px;border-radius:2px}

      .grain{position:fixed;inset:-60px;z-index:30;pointer-events:none;opacity:.06;mix-blend-mode:overlay;background-size:160px 160px;
        animation:grain .8s steps(4) infinite}
      @keyframes grain{0%{transform:translate(0,0)}25%{transform:translate(-23px,17px)}50%{transform:translate(31px,-9px)}75%{transform:translate(-11px,-29px)}100%{transform:translate(0,0)}}
      .sab{position:fixed;left:0;bottom:0;width:0;height:env(safe-area-inset-bottom,0px);pointer-events:none;visibility:hidden}
      .duo-defs{position:absolute;width:0;height:0;overflow:hidden}

      /* el nombre real (lectores de pantalla / sin JS); con JS lo dibuja la silueta */
      .hero{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}

      /* ── barra superior ── */
      .nav{position:fixed;top:0;left:0;right:0;z-index:12;height:var(--tb);display:flex;align-items:center;gap:1rem;
        padding:env(safe-area-inset-top,0px) var(--gut) 0;font-family:var(--mono);font-size:.75rem;letter-spacing:.06em;color:var(--mid)}
      body.in-case .nav{background:var(--bg)}
      .nav__who{color:var(--ink);white-space:nowrap;animation:up .6s var(--ease) .2s both}
      body.in-case .nav__who{display:none}
      .nav__mail{display:inline-flex;align-items:center;min-height:44px;margin-left:auto;white-space:nowrap;transition:color .25s;animation:up .6s var(--ease) .3s both}
      .nav__mail:hover{color:var(--ink)}
      .nav__back{appearance:none;background:none;border:1px solid var(--hair);border-radius:999px;color:var(--mid);cursor:pointer;font:inherit;
        font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;padding:0 1.1rem;min-height:44px;display:none;transition:color .25s,border-color .25s}
      .nav__back:hover{color:var(--ink);border-color:var(--soft)}
      .nav__back:focus-visible{border-radius:999px}
      body.in-case .nav__back{display:inline-flex;align-items:center}
      @keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

      /* ── la sala: sol + niebla (WebGL) y la silueta de BLOPA ── */
      .hall{position:fixed;inset:0;z-index:2;width:100%;height:100%;display:block;pointer-events:none}
      .word{position:fixed;left:0;top:0;z-index:3;pointer-events:none;opacity:.94;display:block}
      .word--wrap{opacity:0;will-change:opacity}

      /* ── la pantalla parada en el piso, en duotono ── */
      .panel{position:fixed;left:0;top:0;z-index:4;appearance:none;border:0;padding:0;margin:0;background:#000;cursor:pointer;overflow:visible;
        -webkit-tap-highlight-color:transparent;touch-action:none;will-change:opacity;opacity:0;border-radius:2px}
      .panel:focus-visible{outline:1px solid var(--ink);outline-offset:6px}
      .panel__f{position:absolute;inset:0;overflow:hidden;border-radius:2px;
        box-shadow:0 0 0 1px color-mix(in srgb,var(--acc) 35%,transparent),0 -3px 22px -6px var(--acc),0 0 60px -10px color-mix(in srgb,var(--acc) 45%,transparent)}
      .panel img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block;pointer-events:none;-webkit-user-drag:none}
      .panel__duo{filter:url(#sol-duo)}
      .panel__col{opacity:0;transition:opacity .45s var(--ease)}
      .panel.col .panel__col{opacity:1}
      /* la luz del sol cae de arriba sobre la cara de la pantalla */
      .panel__f::after{content:"";position:absolute;inset:0;pointer-events:none;
        background:linear-gradient(color-mix(in srgb,var(--acc) 16%,transparent),transparent 45%,rgba(0,0,0,.18));transition:opacity .45s}
      .panel.col .panel__f::after{opacity:0}
      /* el reflejo en el piso */
      .panel__r{position:absolute;left:0;right:0;top:calc(100% + 2px);height:40%;overflow:hidden;pointer-events:none;opacity:.22;
        -webkit-mask-image:linear-gradient(#000,transparent);mask-image:linear-gradient(#000,transparent)}
      .panel__r img{position:absolute;left:0;top:0;width:100%;height:250%;object-fit:cover;object-position:50% 0;transform:scaleY(-1);filter:url(#sol-duo) blur(1px)}
      html.port .panel__r{height:22%}

      /* ── nombre + categoría · año ── */
      .lab{position:fixed;left:0;top:0;z-index:5;pointer-events:none;will-change:opacity;opacity:0}
      .lab b{display:block;font-family:var(--display);font-weight:400;font-size:clamp(2.8rem,3.6vw,3.6rem);line-height:.92;color:#fff;white-space:nowrap;
        text-shadow:0 0 1px #fff,0 0 14px color-mix(in srgb,var(--acc) 75%,transparent),-1.5px 0 6px rgba(255,58,84,.45),1.5px 0 6px rgba(36,226,232,.45)}
      .lab i{display:block;font-style:normal;font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);opacity:.82;margin-top:.45rem}
      html.port .lab{left:var(--gut);right:var(--gut);text-align:center}
      html.port .lab b{font-size:clamp(2.4rem,11.5vw,3.1rem)}
      html:not(.port) .lab{text-align:right}

      /* los proyectos: un sol chico por proyecto (44px). En vertical se navega deslizando: quedan para teclado/lector */
      .dots{position:fixed;z-index:6;left:0;top:0;display:flex;gap:2px;opacity:0;transition:opacity .5s var(--ease)}
      body.ready .dots{opacity:1}
      body.in-case .dots{opacity:0;pointer-events:none}
      .dot{appearance:none;background:none;border:0;padding:0;cursor:pointer;width:44px;height:44px;position:relative;-webkit-tap-highlight-color:transparent}
      .dot::before{content:"";position:absolute;left:50%;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;
        background:var(--c);opacity:.3;transition:opacity .3s,box-shadow .3s,transform .4s var(--ease)}
      .dot:hover::before{opacity:.75}
      .dot[aria-current="true"]::before{opacity:1;background:#fff;transform:scale(1.2);
        box-shadow:0 0 0 1px var(--c),0 0 10px 3px var(--c),-2px 0 6px rgba(255,58,84,.45),2px 0 6px rgba(36,226,232,.45)}
      .dot:focus-visible{outline:none}
      .dot:focus-visible::before{outline:1px solid var(--ink);outline-offset:6px}
      html.port .dots{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}

      /* ── leyenda de uso ── */
      .hint{position:fixed;left:var(--gut);right:var(--gut);bottom:calc(env(safe-area-inset-bottom,0px) + 14px);z-index:6;display:flex;align-items:center;gap:.7rem;
        font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);pointer-events:none;opacity:0;transition:opacity .5s var(--ease);
        min-height:24px;justify-content:center}
      body.ready .hint.on{opacity:1}
      body.in-case .hint{opacity:0!important}
      .hint.swap .hint__t{opacity:0}
      .hint__t{transition:opacity .2s var(--ease)}
      .hint__g{position:relative;flex:none;width:14px;height:14px}
      .hint__g::before{content:"";position:absolute;inset:0;border:1px solid currentColor;border-radius:50%;opacity:.45}
      .hint__g::after{content:"";position:absolute;left:4px;top:4px;width:6px;height:6px;border-radius:50%;background:currentColor;animation:tap 1.6s var(--ease) infinite}
      .hint[data-g="h"] .hint__g{width:22px;height:8px}
      .hint[data-g="h"] .hint__g::before{border-radius:999px}
      .hint[data-g="h"] .hint__g::after{left:1px;top:1px;animation:railh 1.8s var(--ease) infinite}
      @keyframes tap{0%,100%{transform:scale(.6);opacity:.5}45%{transform:scale(1);opacity:1}}
      @keyframes railh{0%,100%{transform:translateX(0)}50%{transform:translateX(14px)}}

      /* ── el case ── */
      .wipe{position:fixed;inset:0;z-index:9;pointer-events:none;visibility:hidden}
      .wipe--r{background:var(--rd)} .wipe--c{background:var(--cy)}
      .kase{position:fixed;inset:0;z-index:10;background:var(--bg);overflow-y:auto;overscroll-behavior:contain;visibility:hidden;touch-action:pan-y;--acc:#fff;
        -webkit-user-select:text;user-select:text}
      body.in-case .kase{visibility:visible}
      .kase__flash{position:absolute;left:0;top:0;width:100%;height:100vh;z-index:3;background:var(--acc);pointer-events:none;opacity:1;transition:opacity .6s var(--ease) .12s}
      body.case-in .kase__flash{opacity:0}
      .kase__in{min-height:100%;display:grid;grid-template-columns:minmax(18rem,25rem) minmax(0,1fr);gap:clamp(2rem,5vw,5rem);
        padding:var(--tb) 0 0 var(--gut);transition:opacity .18s}
      .kase.swap .kase__in{opacity:0}
      .kase__txt{align-self:center;padding:2.5rem 0}
      .kase__txt>*{opacity:0;transform:translateY(10px);transition:opacity .5s var(--ease),transform .7s var(--ease)}
      body.case-in .kase__txt>*{opacity:1;transform:none}
      body.case-in .kase__txt>:nth-child(2){transition-delay:.05s} body.case-in .kase__txt>:nth-child(3){transition-delay:.1s}
      body.case-in .kase__txt>:nth-child(4){transition-delay:.15s} body.case-in .kase__txt>:nth-child(5){transition-delay:.2s} body.case-in .kase__txt>:nth-child(6){transition-delay:.25s}
      /* los soles en miniatura: uno por proyecto, el abierto encendido */
      .huella{display:flex;align-items:stretch;gap:2px;margin:0 0 1.3rem;height:44px}
      .huella button{appearance:none;border:0;background:none;cursor:pointer;width:40px;padding:0;position:relative}
      .huella button::before{content:"";position:absolute;left:50%;top:50%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:var(--c);opacity:.3;transition:opacity .3s,box-shadow .3s}
      .huella button[aria-current="true"]::before{opacity:1;background:#fff;box-shadow:0 0 0 1px var(--c),0 0 10px 3px var(--c),-2px 0 6px rgba(255,58,84,.4),2px 0 6px rgba(36,226,232,.4)}
      .huella button:hover::before{opacity:.7}
      .kase__eye{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid)}
      .kase__eye b{font-weight:400;color:var(--ink)}
      .kase__name{font-family:var(--display);font-weight:400;font-size:clamp(3.2rem,6vw,5.6rem);line-height:.88;margin:.4rem 0 1.1rem;color:#fff;
        text-shadow:0 0 2px var(--acc),0 0 14px var(--acc),-2px 0 18px rgba(255,58,84,.35),2px 0 18px rgba(36,226,232,.35)}
      .kase__app{color:#c9cbd2;font-size:.98rem;line-height:1.58;max-width:36ch}
      .cred{display:grid;grid-template-columns:5.5rem 1fr;margin-top:1.6rem;border-top:1px solid var(--hair)}
      .cred dt,.cred dd{margin:0;padding:.6rem 0;border-bottom:1px solid var(--hair)}
      .cred dt{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);padding-top:.72rem}
      .cred dd{font-size:.88rem} .cred dd.soft{color:var(--mid)}
      .kase__acts{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1.6rem}
      .kase__live{display:inline-flex;align-items:center;min-height:44px;font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;
        border-bottom:1px solid rgba(242,243,245,.35);transition:border-color .25s}
      .kase__live:hover{border-color:var(--ink)}
      .kase__next{appearance:none;background:none;border:0;cursor:pointer;color:var(--mid);font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;
        text-transform:uppercase;min-height:44px;padding:0;transition:color .25s}
      .kase__next b{font-weight:400;color:var(--ink)} .kase__next:hover{color:var(--ink)}
      /* el escenario del case: el sol, ya sin niebla, detrás de la obra en color */
      .kase__stage{position:relative;display:flex;align-items:center;justify-content:center;padding:clamp(1.5rem,3.5vw,3.5rem);min-height:calc(100vh - var(--tb));overflow:hidden;
        background:radial-gradient(46% 42% at 50% 30%,color-mix(in srgb,var(--acc) 30%,transparent),transparent 100%),#0a0a0e}
      .kase__media{position:relative;margin:0;width:100%;aspect-ratio:16/10;max-height:calc(100vh - var(--tb) - 7rem);background:#000;border-radius:3px;
        box-shadow:0 0 0 1px rgba(255,255,255,.5),0 0 30px 4px color-mix(in srgb,var(--acc) 50%,transparent),0 0 120px 20px color-mix(in srgb,var(--acc) 22%,transparent),
          -6px 0 26px rgba(255,58,84,.22),6px 0 26px rgba(36,226,232,.22);
        opacity:0;transform:scale(.97);transition:opacity .6s var(--ease) .25s,transform .9s var(--ease) .25s}
      body.case-in .kase__media{opacity:1;transform:none}
      .kase__media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;display:block;background:#000;border-radius:3px}
      .cbar{display:none}

      html.port .kase__in{grid-template-columns:1fr;gap:0;padding:var(--tb) 0 calc(56px + env(safe-area-inset-bottom,0px))}
      html.port .kase__txt{padding:1.6rem var(--gut) 2rem}
      html.port .kase__name{font-size:clamp(3.2rem,15vw,4.8rem)}
      html.port .kase__app{font-size:.94rem;max-width:none}
      html.port .kase__stage{min-height:0;padding:2.4rem var(--gut)}
      html.port .kase__media{aspect-ratio:720/1558;width:min(100%,21rem);max-height:none}
      html.port .kase__acts{display:none}
      html.port body.in-case .cbar{display:flex}
      .cbar{position:fixed;left:0;right:0;bottom:0;z-index:13;gap:1px;background:var(--hair);padding-bottom:env(safe-area-inset-bottom,0px);
        opacity:0;animation:fade .4s var(--ease) .5s forwards}
      @keyframes fade{to{opacity:1}}
      .cbar>*{flex:1;display:flex;align-items:center;justify-content:center;min-height:56px;background:rgba(7,7,10,.97);font-family:var(--mono);font-size:.75rem;
        letter-spacing:.08em;text-transform:uppercase;color:var(--ink);border:0;appearance:none;cursor:pointer}
      .cbar__next{color:var(--mid)} .cbar__next b{font-weight:400;color:var(--ink);margin:0 .4em}

      /* ── sin JS o si algo falla: lista legible con links ── */
      .plain{display:none}
      html:not(.js) body,html.fail body{overflow:auto;touch-action:auto;-webkit-user-select:auto;user-select:auto}
      html:not(.js) .plain,html.fail .plain{display:block;position:relative;z-index:5;padding:2rem var(--gut) 4rem;max-width:48rem}
      html:not(.js) :is(.hall,.word,.panel,.lab,.dots,.hint,.kase,.wipe,.cbar),html.fail :is(.hall,.word,.panel,.lab,.dots,.hint,.kase,.wipe,.cbar){display:none!important}
      html:not(.js) .hero,html.fail .hero{position:relative;width:auto;height:auto;overflow:visible;clip-path:none;padding:calc(var(--tb) + 2rem) var(--gut) 0;
        font-family:var(--display);font-weight:400;line-height:.8;font-size:min(30vw,12rem);color:#fff;text-shadow:0 0 6px #e0bd76,0 0 30px #e0bd76}
      html:not(.js) .nav,html.fail .nav{position:absolute}
      .plain li{list-style:none;padding:1.1rem 0;border-bottom:1px solid var(--hair)}
      .plain ul{padding:0}
      .plain h2{font-family:var(--display);font-weight:400;font-size:clamp(2rem,6vw,3.2rem);line-height:1;color:var(--acc)}
      .plain p{color:var(--mid);font-size:.92rem;margin-top:.35rem}
      .plain span{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft)}

      @media (prefers-reduced-motion:reduce){
        *,*::before,*::after{transition:none!important;animation:none!important}
        .cbar{opacity:1}
      }
    </style>
  </head>
  <body>
    <div class="grain" data-grain aria-hidden="true"></div>
    <div class="sab" data-sab aria-hidden="true"></div>
    <svg class="duo-defs" aria-hidden="true" focusable="false">
      <filter id="sol-duo" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
        <feColorMatrix type="matrix" values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0" />
        <feComponentTransfer>
          <feFuncR type="table" data-fr tableValues="0 .88 1" />
          <feFuncG type="table" data-fg tableValues="0 .74 1" />
          <feFuncB type="table" data-fb tableValues="0 .46 1" />
        </feComponentTransfer>
      </filter>
    </svg>

    <h1 class="hero">BLOPA</h1>

    <nav class="nav" aria-label="Contacto">
      <span class="nav__who">Pablo Vela</span>
      <button type="button" class="nav__back" data-back>‹ Proyectos</button>
      <a class="nav__mail" href="mailto:blopave@pm.me">blopave@pm.me ↗</a>
    </nav>

    <main>
      <canvas class="hall" data-hall aria-hidden="true"></canvas>
      <canvas class="word" data-word aria-hidden="true"></canvas>
      <canvas class="word word--wrap" data-wrap aria-hidden="true"></canvas>
      <button type="button" class="panel" data-panel>
        <span class="panel__f"><img class="panel__duo" data-duo alt="" decoding="async" draggable="false" /><img class="panel__col" data-col alt="" decoding="async" draggable="false" /></span>
        <span class="panel__r" aria-hidden="true"><img data-refl alt="" decoding="async" draggable="false" /></span>
      </button>
      <p class="lab" data-lab aria-hidden="true"><b data-lab-name></b><i data-lab-cat></i></p>
      <nav class="dots" aria-label="Proyectos" data-band>
        {orden.map((p) => (
          <button type="button" class="dot" data-slot style={`--c:${p.accent}`} aria-label={`${p.name} — ${p.category}, ${year(p.ended)}. Abrir proyecto`}></button>
        ))}
      </nav>

      <div class="wipe wipe--r" data-wr aria-hidden="true"></div>
      <div class="wipe wipe--c" data-wc aria-hidden="true"></div>
      <section class="kase" data-case role="dialog" aria-modal="true" aria-labelledby="kase-name" inert>
        <div class="kase__flash" aria-hidden="true"></div>
        <div class="kase__in">
          <div class="kase__txt">
            <div class="huella" data-huella role="group" aria-label="Proyectos">
              {orden.map((p) => (<button type="button" style={`--c:${p.accent}`} aria-label={p.name}></button>))}
            </div>
            <p class="kase__eye" data-eye></p>
            <h2 class="kase__name" id="kase-name" data-name></h2>
            <p class="kase__app" data-app></p>
            <dl class="cred">
              <dt>Servicios</dt><dd data-services></dd>
              <dt>Stack</dt><dd class="soft" data-stack></dd>
            </dl>
            <div class="kase__acts">
              <a class="kase__live" data-live target="_blank" rel="noopener">Ver en vivo ↗</a>
              <button type="button" class="kase__next" data-next>Siguiente <b data-next-name></b> →</button>
            </div>
          </div>
          <div class="kase__stage">
            <figure class="kase__media"><video data-kvid muted loop playsinline preload="none" aria-label="Video del sitio"></video></figure>
          </div>
        </div>
      </section>
      <div class="cbar" data-cbar inert>
        <a class="cbar__live" data-live2 target="_blank" rel="noopener">Ver en vivo ↗</a>
        <button type="button" class="cbar__next" data-next2>Siguiente <b data-next-name2></b> →</button>
      </div>

      <section class="plain" aria-label="Proyectos (lista)">
        <ul>
          {orden.map((p) => (
            <li style={`--acc:${p.accent}`}><span>{p.category} · {year(p.ended)}</span><h2>{p.url ? <a href={p.url}>{p.name} ↗</a> : p.name}</h2><p>{p.approach}</p></li>
          ))}
        </ul>
      </section>
    </main>

    <p class="hint" data-hint aria-hidden="true"><span class="hint__g"></span><span class="hint__t" data-hint-t></span></p>
    <script type="application/json" id="sol-data" set:html={data}></script>

    <script>
      const root = document.documentElement, body = document.body;
      try {
        const P = JSON.parse(document.getElementById('sol-data').textContent);
        const N = P.length;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const coarse = matchMedia('(pointer: coarse)').matches;
        const FRAMED = (() => { try { return window.self !== window.top; } catch { return true; } })();
        const q = (s) => document.querySelector(s);
        const navEl = q('.nav'), bandEl = q('[data-band]'), cv = q('[data-hall]'), wordCv = q('[data-word]'), wrapCv = q('[data-wrap]');
        const panel = q('[data-panel]'), imDuo = q('[data-duo]'), imCol = q('[data-col]'), imRef = q('[data-refl]');
        const labEl = q('[data-lab]'), labName = q('[data-lab-name]'), labCat = q('[data-lab-cat]');
        const slots = Array.from(document.querySelectorAll('[data-slot]'));
        const caseEl = q('[data-case]'), wR = q('[data-wr]'), wC = q('[data-wc]'), cbar = q('[data-cbar]'), backEl = q('[data-back]');
        const huella = Array.from(document.querySelectorAll('[data-huella] button'));
        const kvid = q('[data-kvid]');
        const fR = q('[data-fr]'), fG = q('[data-fg]'), fB = q('[data-fb]');
        const year = (e) => (e ? e.split('-')[0] : 'En curso');
        const KIND = { pulz: 'Producto propio', basslayer: 'Producto propio' };
        const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
        const rgb = (h) => { const n = parseInt(h.slice(1), 16); return [(n >> 16) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255]; };
        const ACC = P.map((p) => rgb(p.accent));
        const easeOut = (t) => 1 - Math.pow(1 - clamp(t, 0, 1), 3);
        const easeIn = (t) => { t = clamp(t, 0, 1); return t * t; };
        const inOut = (t) => { t = clamp(t, 0, 1); return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };

        // ── grano ──
        (() => { const g = document.createElement('canvas'); g.width = g.height = 160; const gx = g.getContext('2d'); if (!gx) return;
          const im = gx.createImageData(160, 160); for (let i = 0; i < im.data.length; i += 4) { const v = Math.random() * 255; im.data[i] = im.data[i + 1] = im.data[i + 2] = v; im.data[i + 3] = 255; }
          gx.putImageData(im, 0, 0); q('[data-grain]').style.backgroundImage = `url(${g.toDataURL()})`; })();

        // ════════════ la sala: WebGL, un triángulo a pantalla completa ════════════
        const gl = cv.getContext('webgl', { alpha: false, antialias: false, depth: false, stencil: false, premultipliedAlpha: false, preserveDrawingBuffer: false });
        if (!gl) throw new Error('sin WebGL');
        const VS = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
        const FS = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 R;      // lienzo (px)
uniform float S;     // px de lienzo por px css
uniform float T;     // tiempo
uniform vec3 C;      // sol: x, y del techo (la costura del espejo), radio (css)
uniform float D;     // cuánto bajó la mitad real (puesta)
uniform float I;     // intensidad de la lámpara
uniform float B;     // oleada de niebla (al cambiar)
uniform vec3 A;      // la única frecuencia: el color del proyecto
uniform vec4 M;      // dedo/mouse: x, y, fuerza, radio
uniform vec2 F;      // deriva de la niebla
uniform float Z;     // escala de la niebla
uniform vec2 V;      // viewport css
uniform vec4 Q;      // pantalla: l, t, r, b (css)
uniform sampler2D K; // silueta de BLOPA (chica)
float hs(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float nz(vec2 p){ vec2 i = floor(p), f = fract(p); vec2 u = f * f * (3. - 2. * f);
  return mix(mix(hs(i), hs(i + vec2(1., 0.)), u.x), mix(hs(i + vec2(0., 1.)), hs(i + vec2(1., 1.)), u.x), u.y); }
float fbm(vec2 p){ float s = 0., a = .5; mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
  for (int k = 0; k < 4; k++){ s += a * nz(p); p = m * p; a *= .5; } return s; }
float fbm2(vec2 p){ float s = .5 * nz(p); p = mat2(1.6, 1.2, -1.2, 1.6) * p; return s + .25 * nz(p); }
float mk(vec2 q){ return texture2D(K, q / V).a; }
// emisión del medio disco real (para los haces), tapado por las letras
float em(vec2 q, vec2 c){ vec2 d = q - c; return step(dot(d, d), C.z * C.z) * step(c.y, q.y) * (1. - mk(q)); }
void main(){
  vec2 p = vec2(gl_FragCoord.x, R.y - gl_FragCoord.y) / S;
  bool mir = p.y < C.y;
  vec2 q = mir ? vec2(p.x, 2. * C.y - p.y) : p;       // arriba: el reflejo en el techo espejado
  vec2 c = vec2(C.x, C.y + D);
  // niebla, apartada por el dedo
  vec2 d = p - M.xy; float k = M.z * exp(-dot(d, d) / (M.w * M.w));
  vec2 pp = p - d * k * .5;
  vec2 hq = pp / Z + F;
  vec2 w = vec2(fbm2(hq * .6 + vec2(0., T * .04)), fbm2(hq * .6 + vec2(5.2, 1.3 - T * .035)));
  float h = fbm(hq + 1.8 * w + vec2(T * .012, -T * .022));
  h = clamp((h - .2) * 1.55, 0., 1.);
  h *= (1. - .65 * k) * (1. + .45 * B);
  // el sol: medio disco + su distancia (para el halo)
  vec2 dd = q - c; float sd = length(dd) - C.z;
  float disc = smoothstep(1.1, -1.1, sd) * smoothstep(c.y - .8, c.y + .8, q.y);
  float dist = q.y < c.y ? length(vec2(max(abs(dd.x) - C.z, 0.), c.y - q.y)) : max(sd, 0.);
  if (mir) disc *= 1. - .09 * mk(q);                    // el fantasma de BLOPA en el espejo
  // haces: lo que llega del disco hacia este punto, cortado por las letras
  vec2 st = (c - q) * (.9 / 12.); vec2 s = q + st * hs(p + fract(T * 7.)); float ray = 0., wg = 1.;
  for (int i = 0; i < 12; i++){ s += st; ray += em(s, c) * wg; wg *= .92; }
  ray *= 1. / 7.2;
  float ang = atan(dd.x, dd.y);
  float streak = .65 + .7 * nz(vec2(ang * 26. + F.x * 2., T * .07));
  float g = exp(-dist / (.025 * C.z)) * .6 + exp(-dist / (.14 * C.z)) * .32 + exp(-dist / (.5 * C.z)) * .12;
  float far = exp(-dist / (.85 * C.z));
  float E = disc * 1.35 + g * (.2 + 1.2 * h) + ray * far * streak * (.06 + 1.1 * h);
  E *= I;
  if (mir) E *= .8 * exp(-(C.y - p.y) / (1.7 * C.z));   // el techo espejado devuelve menos luz cuanto más lejos
  // piso: la luz que cae en la niebla baja y el charco bajo la pantalla
  float fy = Q.w, fl = smoothstep(fy - 6., fy + 26., p.y);
  float fx = (p.x - C.x) / (C.z * 1.15);
  E += fl * exp(-fx * fx) * exp(-max(p.y - fy, 0.) / (V.y * .1)) * .32 * I * (.55 + .7 * h);
  // la costura del espejo
  E += exp(-abs(p.y - C.y) / .9) * .07 * I;
  // niebla ambiente: la sala nunca es negra del todo
  E += h * (.018 + .035 * I);
  vec3 col = 1. - exp(-E * (A * A * 2.3 + .015));     // una sola frecuencia: satura en el color, no en blanco
  col += smoothstep(1.6, 3.4, E) * .1;
  // el filo cromático del disco: rojo a un lado, cian al otro
  vec2 o = vec2(2.4, 0.);
  float fr = exp(-pow((length(dd - o) - C.z - 1.6) / 1.7, 2.)), fc = exp(-pow((length(dd + o) - C.z - 1.6) / 1.7, 2.));
  float lower = smoothstep(c.y - 2., c.y + 6., q.y);
  col += (vec3(1., .23, .33) * fr + vec3(.14, .89, .91) * fc) * .3 * I * lower * (mir ? .7 : 1.);
  vec2 vg = (p / V - vec2(.5, .42)) * vec2(1.25, 1.);
  col *= (1. - .5 * dot(vg, vg)) * (.62 + .38 * smoothstep(0., 150., p.y));   // viñeta; arriba más oscuro (la barra se lee)
  col += vec3(.027, .027, .039);
  col += (hs(p * 1.7 + fract(T) * 37.) - .5) * .012;
  gl_FragColor = vec4(col, 1.);
}`;
        const sh = (type, src) => { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
          if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; };
        const prog = gl.createProgram(); gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS)); gl.linkProgram(prog);
        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
        gl.useProgram(prog);
        const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const aLoc = gl.getAttribLocation(prog, 'a'); gl.enableVertexAttribArray(aLoc); gl.vertexAttribPointer(aLoc, 2, gl.FLOAT, false, 0, 0);
        const U = {}; ['R', 'S', 'T', 'C', 'D', 'I', 'B', 'A', 'M', 'F', 'Z', 'V', 'Q', 'K'].forEach((n) => (U[n] = gl.getUniformLocation(prog, n)));
        // la silueta chica para el shader
        const maskTex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, maskTex);
        [gl.TEXTURE_WRAP_S, gl.TEXTURE_WRAP_T].forEach((w) => gl.texParameteri(gl.TEXTURE_2D, w, gl.CLAMP_TO_EDGE));
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.uniform1i(U.K, 0);
        const maskCv = document.createElement('canvas');

        // ════════════ geometría ════════════
        let W = 0, H = 0, port = false, TB = 56, SAB = 0, CS = 0.5;
        const G = { cx: 0, cy: 0, r: 100, pl: 0, pt: 0, pr: 0, pb: 0, pw: 0, ph: 0 };
        const FONT = (fs) => `400 ${fs}px "Bebas Neue", Impact, sans-serif`;
        const LS = 0.04;
        const drawWord = (g, fs, x0, base, k) => {
          g.font = FONT(fs * k); g.textBaseline = 'alphabetic';
          let x = x0 * k; for (const ch of 'BLOPA') { g.fillText(ch, x, base * k); x += g.measureText(ch).width + fs * LS * k; }
        };
        // la silueta nítida; en los filos, la luz del sol se come un poco la letra (light wrap, en otra capa que sigue a la lámpara)
        let WD = null;
        const paintWord = () => { if (!WD) return; const { fs, pad, capH, k } = WD;
          const wg = wordCv.getContext('2d'); wg.clearRect(0, 0, wordCv.width, wordCv.height); wg.fillStyle = '#050507';
          drawWord(wg, fs, pad, pad + capH, k);
          wrapCv.width = wordCv.width; wrapCv.height = wordCv.height; wrapCv.style.width = wordCv.style.width; wrapCv.style.height = wordCv.style.height;
          wrapCv.style.transform = wordCv.style.transform;
          const g2 = wrapCv.getContext('2d'); g2.clearRect(0, 0, wrapCv.width, wrapCv.height);
          if (reduce) return;
          g2.globalCompositeOperation = 'source-over'; g2.fillStyle = '#fff'; drawWord(g2, fs, pad, pad + capH, k);   // máscara: las letras
          g2.globalCompositeOperation = 'source-atop';                                                                  // el filo, sólo adentro
          g2.fillStyle = '#050507'; g2.fillRect(0, 0, wrapCv.width, wrapCv.height);
          g2.shadowColor = P[cur].accent; g2.shadowBlur = fs * 0.07 * k; g2.lineWidth = Math.max(1, fs * 0.012 * k); g2.strokeStyle = P[cur].accent;
          g2.globalAlpha = 0.6; g2.font = FONT(fs * k);
          let x = pad * k; for (const ch of 'BLOPA') { g2.strokeText(ch, x, (pad + capH) * k); x += g2.measureText(ch).width + fs * LS * k; }
          g2.globalAlpha = 1; g2.globalCompositeOperation = 'source-over'; g2.shadowBlur = 0; };
        const measure = () => {
          W = innerWidth; H = innerHeight; port = H > W || W < 640; root.classList.toggle('port', port);
          TB = navEl.getBoundingClientRect().height || 56;
          SAB = q('[data-sab]').getBoundingClientRect().height || 0;
          const m = document.createElement('canvas').getContext('2d'); m.font = FONT(100);
          let rw = 0; for (const ch of 'BLOPA') rw += m.measureText(ch).width + 100 * LS; rw = (rw - 100 * LS) / 100;
          const capR = (m.measureText('B').actualBoundingBoxAscent || 70) / 100;
          labName.textContent = labName.textContent || 'BLOPA'; labCat.textContent = labCat.textContent || '·';
          const labH = labEl.getBoundingClientRect().height || 72;
          let fs;
          if (port) {
            const foot = H - SAB - 46;
            const labTop = foot - labH - 6;
            G.pw = Math.min(W * 0.76, 340); G.ph = G.pw / 1.6;
            G.pb = labTop - Math.max(22, G.ph * 0.17); G.pt = G.pb - G.ph;
            G.r = Math.min(W * 0.58, 290);
            G.cy = G.pt + 26 - G.r;
            // que BLOPA quepa entre el techo y la pantalla
            fs = Math.min(W * 0.66 / rw, (G.pt - G.cy - 40) / capR);
            G.cx = W / 2; G.pl = (W - G.pw) / 2;
            labEl.style.transform = `translate3d(0,${labTop.toFixed(1)}px,0)`; labEl.style.right = '';
          } else {
            const foot = H - 56;
            G.ph = clamp(H * 0.25, 150, 270); G.pw = G.ph * 1.6;
            G.pb = foot - Math.max(26, G.ph * 0.14); G.pt = G.pb - G.ph;
            G.r = clamp((G.pt + G.ph * 0.12 - TB - 10) / 2, 140, W * 0.3);
            G.cy = G.pt + G.ph * 0.12 - G.r;
            fs = Math.min(W * 0.3 / rw, (G.pt - G.cy - 50) / capR);
            G.cx = W / 2; G.pl = (W - G.pw) / 2;
            const lx = G.pl - Math.max(40, W * 0.035);
            labEl.style.transform = `translate3d(0,${(G.pb - labH + 4).toFixed(1)}px,0)`;
            labEl.style.left = '0px'; labEl.style.width = lx.toFixed(1) + 'px';
            bandEl.style.transform = `translate3d(${(G.pl + G.pw + Math.max(28, W * 0.03)).toFixed(1)}px,${(G.pb - 44 + 10).toFixed(1)}px,0)`;
          }
          if (port) { labEl.style.width = ''; labEl.style.left = ''; }
          G.pr = G.pl + G.pw;
          panel.style.width = G.pw + 'px'; panel.style.height = G.ph + 'px';
          panel.style.transform = `translate3d(${G.pl.toFixed(1)}px,${G.pt.toFixed(1)}px,0)`;
          // BLOPA: en la mitad real del sol, entre el techo y la pantalla
          const capH = fs * capR, tw = rw * fs;
          const capTop = G.cy + (G.pt - G.cy - capH) * (port ? 0.44 : 0.46);
          const base = capTop + capH, x0 = (W - tw) / 2;
          // nítida (DPR) en su caja
          const k = Math.min(3, devicePixelRatio || 1), pad = Math.ceil(fs * 0.1);
          wordCv.width = Math.ceil((tw + pad * 2) * k); wordCv.height = Math.ceil((capH + pad * 2) * k);
          wordCv.style.width = (tw + pad * 2) + 'px'; wordCv.style.height = (capH + pad * 2) + 'px';
          wordCv.style.transform = `translate3d(${(x0 - pad).toFixed(1)}px,${(capTop - pad).toFixed(1)}px,0)`;
          WD = { fs, pad, capH, k };
          paintWord();
          // chica para el shader (pantalla completa a ½)
          const mk = 0.5; maskCv.width = Math.max(1, Math.round(W * mk)); maskCv.height = Math.max(1, Math.round(H * mk));
          const mg = maskCv.getContext('2d'); mg.clearRect(0, 0, maskCv.width, maskCv.height); mg.fillStyle = '#fff';
          drawWord(mg, fs, x0, base, mk);
          gl.bindTexture(gl.TEXTURE_2D, maskTex);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.ALPHA, gl.ALPHA, gl.UNSIGNED_BYTE, maskCv);
          // lienzo reducido: táctil ×0.55 con DPR ≤ 1.5; desktop ×0.5 con DPR ≤ 2; tope de píxeles
          const cdpr = Math.min(coarse || port ? 1.5 : 2, devicePixelRatio || 1);
          CS = cdpr * (coarse || port ? 0.55 : 0.5); const maxPx = port ? 260000 : 820000;
          if (W * H * CS * CS > maxPx) CS = Math.sqrt(maxPx / (W * H));
          cv.width = Math.max(1, Math.round(W * CS)); cv.height = Math.max(1, Math.round(H * CS));
          gl.viewport(0, 0, cv.width, cv.height);
        };

        // ── capturas ──
        const posterURL = (i) => '/img/poster/' + P[i].slug + '.jpg';
        P.forEach((_, i) => { const im = new Image(); im.src = posterURL(i); });
        // duotono negro → color → blanco, con más contraste en los medios (la captura se lee); sigue al color que se funde
        const setDuo = ([r, g, b]) => { const tv = (a) => `0 ${(0.06 + a * a * 0.42).toFixed(3)} ${(0.18 + 0.72 * a).toFixed(3)} 1`;
          fR.setAttribute('tableValues', tv(r)); fG.setAttribute('tableValues', tv(g)); fB.setAttribute('tableValues', tv(b)); };

        // ════════════ estado ════════════
        let cur = 0, tgtI = 0, s = 0, lamp = 0.62, lampT = 1, bil = 0, flowX = 0, flowY = 0, flowV = 0, dirV = 1;
        const col = ACC[0].slice();
        let mx = -999, my = -999, mS = 0, mST = 0;
        let tw = null, busy = false, queued = 0, riseT = -1e9, dragging = false;
        let inCase = false, caseI = -1, caseFull = false, ready = false, introOn = false, introT0 = 0, autoT = 0;
        let raf = 0, last = 0, running = false;
        const t0 = performance.now();
        const tween = (to, dur, ease, done) => { tw = { a: s, b: to, t0: performance.now(), dur: Math.max(1, dur), ease, done }; };

        const show = (i) => {
          cur = i; tgtI = i; const p = P[i];
          paintWord();
          const u = posterURL(i);
          if (!imDuo.src.endsWith(u)) { imOk = false; imDuo.src = imRef.src = imCol.src = u; if (imDuo.complete && imDuo.naturalWidth) imOk = true; }
          labName.textContent = p.name; labCat.textContent = p.category + ' · ' + year(p.ended);
          panel.setAttribute('aria-label', `${p.name} — ${p.category}, ${year(p.ended)}. Abrir proyecto`);
          slots.forEach((el, j) => el.setAttribute('aria-current', j === i ? 'true' : 'false'));
          syncHint();
        };
        // cambiar: el sol nunca se apaga; la niebla se espesa un instante y la luz se funde al color del siguiente
        const change = (dir) => {
          if (inCase) return;
          if (busy) { queued = dir; return; }
          busy = true; dirV = dir; bil = 1; flowV += dir * 0.5;
          const nx = (cur + dir + N) % N; tgtI = nx;
          if (reduce) { show(nx); col.splice(0, 3, ...ACC[cur]); s = 0; busy = false; kick(); return; }
          tween(1, 180 + 220 * (1 - s), easeIn, () => {
            show(nx); bil = 1;
            tween(0, 700, easeOut, () => { busy = false; if (queued) { const d = queued; queued = 0; change(d); } });
          });
          kick();
        };
        const goTo = (i) => { if (inCase) return; endIntro(); if (i === cur && !busy) { openCase(i); return; }
          if (busy) return; const d = (i - cur + N) % N; const dd = d > N / 2 ? d - N : d;
          // saltos de más de uno: se pone y sale directamente en el elegido
          if (Math.abs(dd) > 1) { const tgt = i; busy = true; dirV = Math.sign(dd); bil = 1; tgtI = tgt;
            if (reduce) { show(tgt); col.splice(0, 3, ...ACC[tgt]); busy = false; kick(); return; }
            tween(1, 400, easeIn, () => { show(tgt); tween(0, 700, easeOut, () => { busy = false; }); }); kick(); return; }
          change(dd); };

        const frame = (now) => {
          raf = 0; if (!running) return;
          const dt = Math.min(0.05, last ? (now - last) / 1000 : 1 / 60); last = now;
          const eT = now - introT0;
          // entrada: la lámpara ya está encendida (BLOPA se lee desde el primer cuadro) y termina de calentar
          if (introOn) {
            const k = clamp(eT / 1100, 0, 1);
            lamp = 0.62 + 0.38 * inOut(k);
            if (k >= 1) { introOn = false; lamp = lampT = 1; }
          } else lamp += (lampT - lamp) * Math.min(1, dt * 6);
          if (tw) { const k = (now - tw.t0) / tw.dur; s = tw.a + (tw.b - tw.a) * tw.ease(k); if (k >= 1) { const d = tw.done; tw = null; s = 0 + (d ? s : s); if (d) d(); } }
          // al cambiar el sol sólo respira (nunca baja de ~80 %): el cambio es de color, no de luz
          const I = lamp * (1 - 0.2 * s);
          const D = 0;
          // la frecuencia: se funde al color del proyecto que viene, durante todo el cambio
          const tc = ACC[tgtI], kc = reduce ? 1 : 1 - Math.exp(-dt * 4.2);
          for (let j = 0; j < 3; j++) col[j] += (tc[j] - col[j]) * kc;
          bil *= Math.exp(-dt * 0.9);
          flowV *= Math.exp(-dt * 1.4);
          if (!reduce) { flowX += (0.01 + flowV * 0.6) * dt; flowY += 0.018 * dt; }
          mS += (mST - mS) * (1 - Math.exp(-dt * 5)); if (!down) mST *= Math.exp(-dt * 1.4);
          // DOM: pantalla y nombre siguen a la lámpara
          // la captura y el nombre se funden en el cambio (cambian en el punto medio), nunca a negro del todo la pantalla
          imA += ((imOk ? 1 : 0) - imA) * (imOk ? Math.min(1, dt * 8) : 1);
          const pv = clamp(lamp, 0, 1) * (1 - 0.5 * s) * imA;
          panel.style.opacity = pv.toFixed(3);
          labEl.style.opacity = clamp((lamp * 1.6 - 0.45) * (1 - s * 1.15), 0, 1).toFixed(3);
          const wo = (0.94 * clamp(I * 1.3, 0, 1)).toFixed(3); if (wo !== lastWo) { lastWo = wo; wrapCv.style.opacity = wo; }
          const accCss = `rgb(${(col[0] * 255) | 0},${(col[1] * 255) | 0},${(col[2] * 255) | 0})`;
          if (accCss !== lastAcc) { lastAcc = accCss; root.style.setProperty('--acc', accCss);
            const dk = col.map((v) => Math.round(v * 20)).join(); if (dk !== lastDuo) { lastDuo = dk; setDuo(col); } }   // el duotono, en pasos (filtro SVG caro)
          // dibujo
          gl.uniform2f(U.R, cv.width, cv.height); gl.uniform1f(U.S, cv.width / W);
          gl.uniform1f(U.T, reduce ? 12 : (now - t0) / 1000);
          gl.uniform3f(U.C, G.cx, G.cy, G.r); gl.uniform1f(U.D, D); gl.uniform1f(U.I, I); gl.uniform1f(U.B, reduce ? 0 : bil);
          gl.uniform3f(U.A, col[0], col[1], col[2]);
          gl.uniform4f(U.M, mx, my, mS, port ? 80 : 120);
          gl.uniform2f(U.F, flowX, -flowY); gl.uniform1f(U.Z, port ? 130 : 200);
          gl.uniform2f(U.V, W, H); gl.uniform4f(U.Q, G.pl, G.pt, G.pr, G.pb);
          gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, maskTex);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          if (!reduce || tw || introOn || mS > 0.01 || Math.abs(lampT - lamp) > 0.002) raf = requestAnimationFrame(frame);
        };
        let lastAcc = '', lastWo = '', lastDuo = '';
        // la pantalla no se muestra como caja negra mientras la captura carga
        let imOk = false, imA = 0;
        imDuo.addEventListener('load', () => { imOk = true; kick(); });
        const kick = () => { if (running && !raf) raf = requestAnimationFrame(frame); };
        const run = (on) => { running = on; if (on && !raf) { last = 0; raf = requestAnimationFrame(frame); } };
        document.addEventListener('visibilitychange', () => run(!document.hidden && !(inCase && caseFull)));

        // ════════════ case ════════════
        let kbd = false;
        addEventListener('keydown', () => { kbd = true; }, true);
        addEventListener('pointerdown', () => { kbd = false; }, true);
        const $ = (sel) => caseEl.querySelector(sel);
        const fill = (i) => {
          const p = P[i], nx = P[(i + 1) % N];
          caseEl.style.setProperty('--acc', p.accent);
          $('[data-eye]').innerHTML = '';
          $('[data-eye]').append(p.category + ' · ' + year(p.ended) + ' · ', Object.assign(document.createElement('b'), { textContent: KIND[p.slug] || 'Encargo' }));
          $('[data-name]').textContent = p.name; $('[data-app]').textContent = p.approach || '';
          $('[data-services]').textContent = (p.services || []).join(', '); $('[data-stack]').textContent = (p.stack || []).join(', ');
          for (const a of [$('[data-live]'), q('[data-live2]')]) { if (p.url) { a.href = p.url; a.style.display = ''; } else a.style.display = 'none'; }
          q('[data-next-name]').textContent = nx.name; q('[data-next-name2]').textContent = nx.name;
          huella.forEach((b, k) => b.setAttribute('aria-current', k === i ? 'true' : 'false'));
          kvid.poster = '/img/poster/' + p.slug + (port ? '-m' : '') + '.jpg';
          kvid.setAttribute('aria-label', 'Video del sitio de ' + p.name);
          const u = '/video/' + p.slug + (port ? '-m' : coarse ? '-640' : '') + '.mp4';
          if (reduce) { kvid.removeAttribute('src'); kvid.load(); }
          else if (kvid.dataset.u !== u) { kvid.dataset.u = u; kvid.src = u; kvid.play().catch(() => {}); }
          else kvid.play().catch(() => {});
          document.title = 'blopa — ' + p.name;
        };
        const syncInert = () => { bandEl.inert = inCase; panel.inert = inCase; caseEl.inert = !inCase; cbar.inert = !inCase; caseEl.setAttribute('aria-hidden', inCase ? 'false' : 'true'); };
        // el case sale de la pantalla: primero se le va el monocromo (aparece el color), después se abre a todo
        const rect = (dx = 0) => `inset(${G.pt.toFixed(1)}px ${(W - G.pr - dx).toFixed(1)}px ${(H - G.pb).toFixed(1)}px ${(G.pl + dx).toFixed(1)}px round 2px)`;
        const FULL = 'inset(0px 0px 0px 0px round 0px)';
        const FRINGE = [[wR, -6], [wC, 6], [caseEl, 0]];
        let anims = [];
        const stopAnims = () => { anims.forEach((a) => a.cancel()); anims = []; };
        let pushed = false, caseInT = 0, fullT = 0, growT = 0;
        const setURL = (slug, push) => { const url = location.pathname + (slug ? '?p=' + slug : '');
          if (push && !FRAMED) { history.pushState({ ref: 1 }, '', url); pushed = true; } else history.replaceState(history.state, '', url); };

        const openCase = (i, { instant = false, push = true } = {}) => {
          if (inCase) { swapCase(i); return; }
          endIntro();
          if (i !== cur) { tw = null; busy = false; s = 0; show(i); col.splice(0, 3, ...ACC[i]); }
          caseI = i; inCase = true; caseFull = false;
          fill(i);
          stopAnims(); clearTimeout(caseInT); clearTimeout(fullT); clearTimeout(growT);
          if (instant || reduce) { body.classList.add('in-case', 'case-in'); panel.classList.add('col'); syncInert(); caseFull = true; run(false); }
          else {
            panel.classList.add('col');                     // la revelación: de una frecuencia a todo el color
            lampT = 0.42;                                    // la sala baja: el color de la obra se impone
            syncInert();
            growT = setTimeout(() => {
              if (!inCase) return;
              body.classList.add('in-case');
              FRINGE.forEach(([el, dx]) => { if (el !== caseEl) el.style.visibility = 'visible';
                anims.push(el.animate([{ clipPath: rect(dx) }, { clipPath: FULL }], { duration: 720, easing: 'cubic-bezier(.7,0,.2,1)', fill: 'forwards' })); });
              anims[2].onfinish = () => { wR.style.visibility = wC.style.visibility = ''; };
              caseInT = setTimeout(() => body.classList.add('case-in'), 480);
              fullT = setTimeout(() => { if (inCase) { caseFull = true; run(false); } }, 780);
            }, 560);
          }
          caseEl.scrollTop = 0;
          if (push) setURL(P[i].slug, true);
          setTimeout(() => { if (inCase) backEl.focus({ preventScroll: true, focusVisible: kbd }); }, instant || reduce ? 0 : 1200);
        };
        const swapCase = (i) => {
          if (i === caseI) return; caseI = i;
          show(i); col.splice(0, 3, ...ACC[i]);
          setURL(P[i].slug, false);
          if (reduce) { fill(i); return; }
          caseEl.classList.add('swap');
          stopAnims();
          [[wR, 0], [wC, 45]].forEach(([el, dl]) => { el.style.visibility = 'visible'; el.style.zIndex = '11';
            anims.push(el.animate([{ clipPath: `inset(0px ${W}px 0px -3px)` }, { clipPath: `inset(0px -3px 0px ${W}px)` }],
              { duration: 460, delay: dl, easing: 'cubic-bezier(.45,0,.25,1)', fill: 'backwards' })); });
          setTimeout(() => { fill(i); caseEl.scrollTop = 0; caseEl.classList.remove('swap'); }, 200);
          setTimeout(() => { wR.style.zIndex = wC.style.zIndex = ''; wR.style.visibility = wC.style.visibility = ''; stopAnims(); }, 540);
        };
        const doClose = () => {
          if (!inCase) return; inCase = false; caseFull = false; clearTimeout(caseInT); clearTimeout(fullT); clearTimeout(growT);
          document.title = 'blopa — Pablo Vela';
          kvid.pause();
          lampT = 1;
          run(true);
          const fin = () => { body.classList.remove('in-case', 'case-in'); stopAnims(); wR.style.visibility = wC.style.visibility = ''; syncInert();
            setTimeout(() => { if (!inCase) panel.classList.remove('col'); }, reduce ? 0 : 160); };
          if (reduce || !body.classList.contains('in-case')) { fin(); }
          else {
            body.classList.remove('case-in');
            caseEl.scrollTop = 0;
            stopAnims();
            FRINGE.forEach(([el, dx]) => { if (el !== caseEl) el.style.visibility = 'visible';
              anims.push(el.animate([{ clipPath: FULL }, { clipPath: rect(dx) }], { duration: 640, delay: 100, easing: 'cubic-bezier(.65,0,.25,1)', fill: 'both' })); });
            anims[2].onfinish = fin;
          }
          bandEl.inert = false;
          setTimeout(() => { if (!inCase && kbd) panel.focus({ preventScroll: true, focusVisible: kbd }); }, reduce ? 0 : 760);
          syncHint();
        };
        const closeCase = () => {
          if (!inCase) return;
          if (pushed && history.state && history.state.ref) { pushed = false; history.back(); return; }
          setURL('', false); doClose();
        };
        const urlSlug = () => new URLSearchParams(location.search).get('p');
        addEventListener('popstate', () => { const i = P.findIndex((p) => p.slug === urlSlug());
          if (i >= 0) { if (!inCase) openCase(i, { push: false }); else swapCase(i); } else { pushed = false; doClose(); } });

        backEl.addEventListener('click', () => closeCase());
        const next = (d) => { if (inCase) swapCase((caseI + d + N) % N); };
        q('[data-next]').addEventListener('click', () => next(1)); q('[data-next2]').addEventListener('click', () => next(1));
        huella.forEach((b, k) => b.addEventListener('click', () => swapCase(k)));

        // ════════════ entrada ════════════
        const markReady = () => { if (ready) return; ready = true; body.classList.add('ready'); syncHint(); };
        const endIntro = () => { if (!introOn && !autoT) return; introOn = false; clearTimeout(autoT); autoT = 0; markReady(); };
        const intro = () => {
          introT0 = performance.now();
          if (reduce) { lamp = 1; show(0); col.splice(0, 3, ...ACC[0]); markReady(); return; }
          introOn = true; show(0); col.splice(0, 3, ...ACC[0]);
          autoT = setTimeout(() => { autoT = 0; markReady(); }, 700);
        };

        // ════════════ interacción ════════════
        slots.forEach((el, i) => el.addEventListener('click', () => goTo(i)));
        panel.addEventListener('click', (ev) => { if (inCase) return; if (ev.detail === 0) openCase(cur); });   // teclado; puntero: abajo
        let down = null;
        const SPAN = () => (port ? W * 0.55 : Math.min(W * 0.35, 520));
        addEventListener('pointerdown', (ev) => {
          if (inCase || ev.button > 0) return;
          if (ev.target.closest && ev.target.closest('a,.nav button,.dots')) return;
          down = { x: ev.clientX, y: ev.clientY, t: performance.now(), ax: 0, lx: ev.clientX, lt: performance.now(), v: 0, s0: s };
          mx = ev.clientX; my = ev.clientY; mST = Math.max(mST, 0.5); kick();
        });
        addEventListener('pointermove', (ev) => {
          if (inCase) return;
          // el dedo (o el mouse) aparta la niebla
          if (mx < -900) { mx = ev.clientX; my = ev.clientY; }
          const ddx = ev.clientX - mx, ddy = ev.clientY - my;
          mx += ddx * 0.5; my += ddy * 0.5;
          mST = clamp(mST + Math.hypot(ddx, ddy) * 0.006, 0, down ? 1 : 0.8); kick();
          if (!down) return;
          const dx = ev.clientX - down.x, dy = ev.clientY - down.y;
          if (!down.ax && Math.hypot(dx, dy) > 9) { down.ax = Math.abs(dx) >= Math.abs(dy) * 0.8 ? 'x' : 'y';
            if (down.ax === 'x') { endIntro(); if (busy) { down.ax = 'busy'; return; } dragging = true; tw = null; down.x = ev.clientX; } }
          if (down.ax !== 'x') return;
          const now = performance.now(), dtm = Math.max(1, now - down.lt);
          down.v = 0.6 * down.v + 0.4 * ((ev.clientX - down.lx) / dtm); down.lx = ev.clientX; down.lt = now;
          const u = clamp((ev.clientX - down.x) / SPAN(), -1, 1);
          s = 0.62 * Math.sin(Math.abs(u) * Math.PI / 2);           // el sol se va poniendo con el dedo
          flowV += (ev.clientX - down.lx) * 0; flowX -= (ddx / Math.max(W, 1)) * 0.25;
          kick();
        });
        const up = (ev) => {
          if (!down) return; const d = down; down = null;
          const dx = ev.clientX - d.x, dy = ev.clientY - d.y;
          if (d.ax === 'x') { dragging = false;
            const u = dx / SPAN(), fl = d.v;
            if (Math.abs(u) > 0.2 || Math.abs(fl) > 0.45) change(Math.abs(fl) > 0.45 ? (fl < 0 ? 1 : -1) : (u < 0 ? 1 : -1));
            else tween(0, 380, easeOut, null);
            kick(); return; }
          if (d.ax === 'y') { if (Math.abs(dy) > 40 && performance.now() - d.t < 600) { endIntro(); change(dy < 0 ? 1 : -1); } return; }
          if (d.ax) return;
          // toque: abre el proyecto que está bajo el sol
          if (ev.clientY < TB) return;
          if (introOn) { endIntro(); return; }
          if (!busy && s < 0.05) openCase(cur);
        };
        addEventListener('pointerup', up);
        addEventListener('pointercancel', () => { if (down && down.ax === 'x') { dragging = false; tween(0, 380, easeOut, null); kick(); } down = null; });
        addEventListener('pointerleave', () => { mST = 0; });

        let wAcc = 0, wT = 0;
        addEventListener('wheel', (ev) => {
          if (inCase) return;
          wAcc += Math.abs(ev.deltaY) > Math.abs(ev.deltaX) ? ev.deltaY : ev.deltaX;
          const now = performance.now(); if (Math.abs(wAcc) < 40 || now - wT < 400) return;
          const d = Math.sign(wAcc); wAcc = 0; wT = now; endIntro(); change(d);
        }, { passive: true });

        addEventListener('keydown', (ev) => {
          const k = ev.key;
          if (inCase) {
            if (k === 'Escape') { ev.preventDefault(); closeCase(); }
            else if (k === 'ArrowRight') { ev.preventDefault(); next(1); }
            else if (k === 'ArrowLeft') { ev.preventDefault(); next(-1); }
            return;
          }
          const fwd = k === 'ArrowDown' || k === 'ArrowRight', back = k === 'ArrowUp' || k === 'ArrowLeft';
          if (fwd || back) { ev.preventDefault(); endIntro(); change(fwd ? 1 : -1); }
          else if (k === 'Enter' && document.activeElement === body) openCase(cur);
        });

        // ════════════ leyenda de uso ════════════
        const hintEl = q('[data-hint]'), hintT = q('[data-hint-t]');
        let hintKey = '', swapT = 0;
        const hintFor = () => {
          if (inCase) return null;
          if (port || coarse) return { g: 'h', t: 'Deslizá para cambiar · tocá para abrir' };
          return { g: 'tap', t: 'Clic para abrir ' + P[cur].name };
        };
        function syncHint() { const h = hintFor(), key = h ? h.g + '|' + h.t : '';
          if (key === hintKey) return; const first = !hintKey; hintKey = key;
          hintEl.classList.toggle('on', !!h); if (!h) return;
          const put = () => { hintEl.dataset.g = h.g; hintT.textContent = h.t; hintEl.classList.remove('swap'); };
          clearTimeout(swapT); if (first || reduce) put(); else { hintEl.classList.add('swap'); swapT = setTimeout(put, 200); } }

        // ════════════ arranque ════════════
        const start = () => {
          measure();
          let rT = 0;
          addEventListener('resize', () => { clearTimeout(rT); rT = setTimeout(() => { measure(); syncHint(); last = 0; if (running) kick(); else { running = true; frame(performance.now()); running = false; } }, 120); });
          syncInert();
          const i0 = P.findIndex((p) => p.slug === urlSlug());
          run(true);
          if (i0 >= 0) { lamp = 1; show(i0); col.splice(0, 3, ...ACC[i0]); markReady(); openCase(i0, { instant: true, push: false }); }
          else intro();
        };
        const fontsOk = document.fonts && document.fonts.load ? document.fonts.load(FONT(100), 'BLOPA') : Promise.resolve();
        Promise.race([fontsOk, new Promise((r) => setTimeout(r, 700))]).then(start, start);
      } catch (err) {
        console.error(err);
        root.classList.add('fail');
      }
    </script>
  </body>
</html>
