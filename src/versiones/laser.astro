          kvid.setAttribute('aria-label', 'Video del sitio de ' + p.name);
          const u = '/video/' + p.slug + (port ? '-m' : coarse ? '-640' : '') + '.mp4';
          if (reduce) { kvid.removeAttribute('src'); kvid.load(); }
          else if (kvid.dataset.u !== u) { kvid.dataset.u = u; kvid.src = u; kvid.play().catch(() => {}); }
          else kvid.play().catch(() => {});
          document.title = 'blopa — ' + p.name;
        };
        const syncInert = () => { bandEl.inert = inCase; scrimEl.inert = inCase; caseEl.inert = !inCase; cbar.inert = !inCase; caseEl.setAttribute('aria-hidden', inCase ? 'false' : 'true'); };
        // el case sale del telón: el rectángulo se abre a toda la pantalla, con filo rojo/cian
        const poly = (pts, dx = 0) => 'polygon(' + pts.map(([x, y]) => `${(x + dx).toFixed(1)}px ${y.toFixed(1)}px`).join(',') + ')';
        const shapes = () => { const [l, t, r, b] = G.box; return [[[l, t], [r, t], [r, b], [l, b]], [[0, 0], [W, 0], [W, H], [0, H]]]; };
        const FRINGE = [[wR, -6], [wC, 6], [caseEl, 0]];
        let anims = [];
        const stopAnims = () => { anims.forEach((a) => a.cancel()); anims = []; };
        let pushed = false, caseInT = 0;
        const setURL = (slug, push) => { const url = location.pathname + (slug ? '?p=' + slug : '');
          if (push && !FRAMED) { history.pushState({ ref: 1 }, '', url); pushed = true; } else history.replaceState(history.state, '', url); };

        const openCase = (i, { instant = false, push = true } = {}) => {
          if (inCase) { swapCase(i); return; }
          endIntro(); cue = null; dragA = dragAT = 0;
          if (cur !== i) switchTo(i, performance.now(), true);
          caseI = i; inCase = true;
          fill(i);
          body.classList.add('in-case'); syncInert();
          stopAnims(); clearTimeout(caseInT);
          if (instant || reduce) { body.classList.add('case-in'); }
          else {
            const [s0, s2] = shapes();
            FRINGE.forEach(([el, dx]) => { if (el !== caseEl) el.style.visibility = 'visible';
              const kf = [{ clipPath: poly(s0, dx) }, { clipPath: el === caseEl ? 'polygon(0px 0px,' + W + 'px 0px,' + W + 'px ' + H + 'px,0px ' + H + 'px)' : poly(s2, dx) }];
              anims.push(el.animate(kf, { duration: 680, easing: 'cubic-bezier(.7,0,.2,1)', fill: 'forwards' })); });
            anims[2].onfinish = () => { wR.style.visibility = wC.style.visibility = ''; caseEl.style.clipPath = 'none'; };
            caseInT = setTimeout(() => body.classList.add('case-in'), 480);
          }
          caseEl.scrollTop = 0;
          if (push) setURL(P[i].slug, true);
          setTimeout(() => { if (inCase) backEl.focus({ preventScroll: true, focusVisible: kbd }); }, instant || reduce ? 0 : 760);
        };
        const swapCase = (i) => {
          if (i === caseI) return; caseI = i; switchTo(i, performance.now(), true);
          setURL(P[i].slug, false);
          if (reduce) { fill(i); return; }
          caseEl.classList.add('swap');
          stopAnims();
          [[wR, 0], [wC, 45]].forEach(([el, dl]) => { el.style.visibility = 'visible'; el.style.zIndex = '11';
            anims.push(el.animate([{ clipPath: `inset(0px ${W}px 0px -3px)` }, { clipPath: `inset(0px -3px 0px ${W}px)` }],
              { duration: 460, delay: dl, easing: 'cubic-bezier(.45,0,.25,1)', fill: 'backwards' })); });
          setTimeout(() => { fill(i); caseEl.scrollTop = 0; caseEl.classList.remove('swap'); }, 200);
          setTimeout(() => { wR.style.zIndex = wC.style.zIndex = ''; wR.style.visibility = wC.style.visibility = ''; stopAnims(); }, 540);
        };
        const doClose = () => {
          if (!inCase) return; inCase = false; clearTimeout(caseInT);
          document.title = 'blopa — Pablo Vela';
          kvid.pause();
          last = performance.now(); kick();
          const fin = () => { body.classList.remove('in-case', 'case-in'); stopAnims(); caseEl.style.clipPath = ''; wR.style.visibility = wC.style.visibility = ''; syncInert(); };
          if (reduce) { fin(); }
          else {
            body.classList.remove('case-in');
            caseEl.scrollTop = 0;
            const [s0, s2] = shapes();
            stopAnims(); caseEl.style.clipPath = '';
            FRINGE.forEach(([el, dx]) => { if (el !== caseEl) el.style.visibility = 'visible';
              const kf = [{ clipPath: poly(s2, el === caseEl ? 0 : dx) }, { clipPath: poly(s0, dx) }];
              anims.push(el.animate(kf, { duration: 600, delay: 100, easing: 'cubic-bezier(.65,0,.25,1)', fill: 'both' })); });
            anims[2].onfinish = fin;
            // al volver, el proyector redibuja
            const now = performance.now() + 300; layers = []; addLayers(now, cur, 0, 520, 60, 560); scanT0 = now + 60; scanDur = 520;
          }
          scrimEl.inert = false; bandEl.inert = false;
          setTimeout(() => { if (!inCase && kbd) scrimEl.focus({ preventScroll: true, focusVisible: true }); }, reduce ? 0 : 760);
          syncHint();
        };
        const closeCase = () => {
          if (!inCase) return;
          if (pushed && history.state && history.state.ref) { pushed = false; history.back(); return; }
          setURL('', false); doClose();
        };
        const urlSlug = () => new URLSearchParams(location.search).get('p');
        addEventListener('popstate', () => { const i = P.findIndex((p) => p.slug === urlSlug());
          if (i >= 0) { if (!inCase) openCase(i, { push: false }); else swapCase(i); } else { pushed = false; doClose(); } });

        backEl.addEventListener('click', () => closeCase());
        const next = (d) => { if (inCase) swapCase((caseI + d + N) % N); };
        q('[data-next]').addEventListener('click', () => next(1)); q('[data-next2]').addEventListener('click', () => next(1));
        huella.forEach((b, k) => b.addEventListener('click', () => swapCase(k)));

        // ════════════ interacción ════════════
        slots.forEach((el, i) => {
          el.addEventListener('focus', () => { if (!inCase) go(i); });
          el.addEventListener('click', () => { if (!inCase) openCase(i); });
        });
        scrimEl.addEventListener('click', (ev) => { if (!inCase && ev.detail === 0) openCase(cur); });   // teclado; puntero: abajo

        let down = null;
        const inScrim = (x, y) => { const r = scrimEl.getBoundingClientRect(); return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom; };
        const setObs = (x, y, touch) => { obs.x = x; obs.y = y; obs.r = touch ? 26 : 16; obs.onT = 1; kick(); };
        addEventListener('pointerdown', (ev) => {
          if (inCase || ev.button > 0) return;
          if (ev.target.closest && ev.target.closest('a,.nav button')) return;
          down = { x: ev.clientX, y: ev.clientY, t: performance.now(), ax: 0, lx: ev.clientX, lt: performance.now(), v: 0 };
          setObs(ev.clientX, ev.clientY, ev.pointerType !== 'mouse');
        });
        addEventListener('pointermove', (ev) => {
          if (inCase) return;
          const touch = ev.pointerType !== 'mouse';
          if (!touch || down) setObs(ev.clientX, ev.clientY, touch);
          if (!touch) cv.classList.toggle('over', !down && inScrim(ev.clientX, ev.clientY));
          if (!down) return;
          const dx = ev.clientX - down.x, dy = ev.clientY - down.y;
          // mantener el dedo quieto y después moverlo = jugar con los haces (no cambia de proyecto)
          if (!down.ax && Math.hypot(dx, dy) > 9) { down.ax = performance.now() - down.t > 320 ? 'play' : Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y'; if (down.ax === 'x') { endIntro(); cv.classList.add('drag'); } }
          if (down.ax !== 'x') return;
          const now = performance.now(), dtm = Math.max(1, now - down.lt);
          down.v = .6 * down.v + .4 * ((ev.clientX - down.lx) / dtm); down.lx = ev.clientX; down.lt = now;
          if (!cue) dragAT = clamp(dx / W, -.6, .6) * 60 * DEG;
        });
        const up = (ev) => {
          if (!down) return; const d = down; down = null; cv.classList.remove('drag');
          if (ev.pointerType !== 'mouse') obs.onT = 0;
          kick();
          const dx = ev.clientX - d.x, dy = ev.clientY - d.y;
          if (d.ax === 'x') { dragAT = 0; const v = performance.now() - d.lt > 110 ? 0 : d.v;
            if (Math.abs(dx) > Math.min(80, W * .18) || Math.abs(v) > .35) change(dx < 0 ? 1 : -1); return; }
          if (d.ax === 'y') { if (Math.abs(dy) > 40 && performance.now() - d.t < 600) change(dy < 0 ? 1 : -1); return; }
          if (d.ax === 'play') return;
          if (performance.now() - d.t < 600 && inScrim(ev.clientX, ev.clientY)) { endIntro(); openCase(cur); }
        };
        addEventListener('pointerup', up);
        addEventListener('pointercancel', () => { down = null; dragAT = 0; obs.onT = 0; cv.classList.remove('drag'); kick(); });
        document.addEventListener('pointerleave', () => { obs.onT = 0; kick(); });
        document.documentElement.addEventListener('mouseleave', () => { obs.onT = 0; kick(); });

        let wAcc = 0, wT = 0;
        addEventListener('wheel', (ev) => {
          if (inCase) return;
          wAcc += Math.abs(ev.deltaY) > Math.abs(ev.deltaX) ? ev.deltaY : ev.deltaX;
          const now = performance.now(); if (Math.abs(wAcc) < 40 || now - wT < 520) return;
          const d = Math.sign(wAcc); wAcc = 0; wT = now; change(d);
        }, { passive: true });

        addEventListener('keydown', (ev) => {
          const k = ev.key;
          if (inCase) {
            if (k === 'Escape') { ev.preventDefault(); closeCase(); }
            else if (k === 'ArrowRight') { ev.preventDefault(); next(1); }
            else if (k === 'ArrowLeft') { ev.preventDefault(); next(-1); }
            return;
          }
          const fwd = k === 'ArrowDown' || k === 'ArrowRight', back = k === 'ArrowUp' || k === 'ArrowLeft';
          if (fwd || back) { ev.preventDefault(); change(fwd ? 1 : -1); }
          else if (k === 'Enter' && document.activeElement === body) openCase(cur);
        });

        // ════════════ leyenda de uso ════════════
        const hintEl = q('[data-hint]'), hintT = q('[data-hint-t]');
        let hintKey = '', swapT = 0;
        const hintFor = () => {
          if (inCase) return null;
          if (port || coarse) return { g: 'h', t: 'Deslizá para cambiar · tocá para abrir' };
          return { g: 'tap', t: 'Clic para abrir ' + P[cur].name };
        };
        function syncHint() { const h = hintFor(), key = h ? h.g + '|' + h.t : '';
          if (key === hintKey) return; const first = !hintKey; hintKey = key;
          hintEl.classList.toggle('on', !!h); if (!h) return;
          const put = () => { hintEl.dataset.g = h.g; hintT.textContent = h.t; hintEl.classList.remove('swap'); };
          clearTimeout(swapT); if (first || reduce) put(); else { hintEl.classList.add('swap'); swapT = setTimeout(put, 200); } }

        // ════════════ arranque ════════════
        const start = () => {
          layout();
          let rT = 0;
          addEventListener('resize', () => { clearTimeout(rT); rT = setTimeout(() => { const was = port; layout(); if (was !== port) { picU.fill(''); P.forEach((_, i) => loadPoster(i)); } kick(); }, 120); });
          syncInert();
          const i0 = P.findIndex((p) => p.slug === urlSlug());
          if (i0 >= 0) { intro = false; introDone = true; switchTo(i0, performance.now(), true); markReady(); openCase(i0, { instant: true, push: false }); kick(); }
          else { startIntro(performance.now()); kick(); }
        };
        const fontsOk = document.fonts && document.fonts.load ? document.fonts.load(FONT(100), 'BLOPA') : Promise.resolve();
        Promise.race([fontsOk, new Promise((r) => setTimeout(r, 700))]).then(start, start);
      } catch (err) {
        console.error(err);
        root.classList.add('fail');
      }
    </script>
  </body>
