          gemU.uTint.value.set(projects[fi].accent); gemU.uTintAmt.value += ((hoverI >= 0 ? 1 : 0) - gemU.uTintAmt.value) * lp(5);
          screens.forEach((s, i) => { gemU['uS' + i].value = s.uni.map.value; });
          const ph = screens.map((s) => s.phi + s.cur), br = screens.map((s) => (0.22 + 0.5 * s.dim) * (0.75 + 0.55 * s.focus));
          gemU.uAng.value.set(ph[0], ph[1], ph[2], ph[3]); gemU.uBr.value.set(br[0], br[1], br[2], br[3]);
          gemU.uDrum.value = drum ? 1 : 0; gemU.uRr.value = drum ? RD : R; gemU.uTh.value = drum ? THD : TH;
          gemU.uAx.value = drum ? PW : SH; gemU.uYc.value = drum ? 0 : RING_Y - gem.position.y;
          gemU.uRingAmt.value = 0.45 + 0.55 * ue;
          // ── el sitio que se ve EN la gema: el del foco. En el home, los sitios ciclan bajo BLOPA (la gema nunca está quieta)
          if (!entered) { homeT += dt; if (homeT > 2.8) { homeT = 0; homeI = (homeI + 1) % N; } }
          const si = entered ? fi : homeI, tex = screens[si].uni.map.value;
          if (si !== siteI) { gemU.uSiteB.value = gemU.uSiteA.value || tex; gemU.uSiteA.value = tex; gemU.uSiteMix.value = 0; siteI = si; }
          else if (tex !== gemU.uSiteA.value) gemU.uSiteA.value = tex;   // póster → video sin cascada
          if (!gemU.uSiteB.value) gemU.uSiteB.value = tex;
          gemU.uSiteMix.value = Math.min(1, gemU.uSiteMix.value + dt / (reduce ? 0.01 : 0.9));
          gemU.uSiteAsp.value = drum ? PW / PH : 1.6;
          gemU.uMirror.value += ((entered ? 0.9 : 0.42) - gemU.uMirror.value) * lp(2.5); gemU.uWordAmt.value = wordReady ? Math.max(0, 1 - ue * 2.2) : 0;
          gemU.uBurst.value = Math.sin(Math.PI * Math.min(1, f * 1.3)) * (f > prevF ? 1 : 0.4); prevF = f;
          gemQuad.position.copy(gem.position); gemQuad.quaternion.copy(camera.quaternion); gemQuad.scale.setScalar(gem.scale.x * 2.85);
          gemQuad.visible = f < 0.75;
          floorU.uGem.value.set(gem.position.x, gem.position.z, (1 - f) * ue);

          mirror.visible = floor.visible = !drum && f < 0.5 && ue > 0.01;
          dustMat.opacity = 0.2 * ue * (1 - f);
          if (!reduce) dust.rotation.y += dt * 0.01;
          // reposo (sin input 5 s y sin transiciones): se dibuja un cuadro sí y uno no (~30 fps)
          frameN++;
          const idle = now - lastInput > 5000 && !dragging && Math.abs(vel) < 0.01 && Math.abs(flight - (inCase ? 1 : 0)) < 0.01 && Math.abs(unfold - (entered ? 1 : 0)) < 0.01;
          if (!(idle && frameN % 2)) renderer.render(scene, camera);
          // reduced-motion: no hay nada que animar → render por demanda (cada interacción despierta el loop un rato)
          if (reduce && now > awakeUntil) { running = false; return; }
          requestAnimationFrame(loop);
        };
        let running = true, frameN = 0, lastInput = performance.now(), awakeUntil = performance.now() + 1500;
        const kick = () => { lastInput = performance.now(); awakeUntil = lastInput + 1500; if (!running) { running = true; last = performance.now(); requestAnimationFrame(loop); } };
        ['pointermove', 'pointerdown', 'wheel', 'keydown', 'resize', 'popstate', 'hashchange', 'click'].forEach((ev) => addEventListener(ev, kick, { passive: true }));
        requestAnimationFrame(loop);
      };

      // ════════════ arranque ════════════
      const glOK = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
      if (glOK) { try { main(); } catch (err) { console.error(err); fallback(); } } else fallback();
      syncInert();
      if (GL) applyHash(true);
    </script>
  </body>
</html>
