        const bindQuad = (pr) => { gl.bindBuffer(gl.ARRAY_BUFFER, quad); const l = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(l); gl.vertexAttribPointer(l, 2, gl.FLOAT, false, 0, 0); return l; };
        const setCover = (pr, o, zoom, pan) => { gl.useProgram(pr);
          gl.uniform2f(pr.u('uRes'), cv.width, cv.height); gl.uniform2f(pr.u('uVid'), o.w, o.h); gl.uniform1f(pr.u('uZoom'), zoom); gl.uniform1f(pr.u('uPan'), pan);
          gl.uniform1f(pr.u('uBarT'), barT); gl.uniform1f(pr.u('uBarB'), barB); gl.uniform1f(pr.u('uPortrait'), W < H ? 1 : 0); gl.uniform1f(pr.u('uBand'), bandH);
          gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, o.t); gl.uniform1i(pr.u('uTex'), 0); };
        const ease = (x) => 1 - Math.pow(1 - x, 3);
        const drawFilm = (now, dt) => {
          filmA += ((entered ? 1 : 0) - filmA) * (reduceMotion ? 1 : 1 - Math.exp(-2.6 * dt));
          if (landSnap) return false;   // este cuadro es la entrada: se copia entera para romperla
          if (filmA < 0.004 && !outObj) return false;
          pump(showI);
          barA += ((entered ? 1 : 0) - barA) * (reduceMotion ? 1 : 1 - Math.exp(-3.2 * dt));
          barT = barPxT() / H * barA; barB = barPxB() / H * barA; barF = Math.max(barT, barB);
          bandH += (bandT - bandH) * (reduceMotion ? 1 : 1 - Math.exp(-6 * dt));
          const pan = 0;
          const tS = (now - tr0) / 1000;
          const inTr = !!outObj;
          const pushIn = reduceMotion ? 1 : 1.0 + 0.035 * Math.min(1, (now - shotT0) / 14000);
          const zin = inTr ? 1.0 + 0.07 * (1 - ease(Math.min(1, tS / 1.1))) : pushIn;
          gl.disable(gl.BLEND); gl.disable(gl.SCISSOR_TEST);
          const l = bindQuad(PQ); setCover(PQ, tex[showI], zin, pan);
          gl.uniform1f(PQ.u('uFade'), (inTr ? 0.72 + 0.28 * ease(Math.min(1, tS / 0.7)) : 1) * filmA);
          gl.drawArrays(gl.TRIANGLES, 0, 3); gl.disableVertexAttribArray(l);
          if (inTr) {
            stepSim(tS); writeVerts(tS);
            gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
            setCover(PSh, outObj, outZoom, outPan); gl.uniform1f(PSh.u('uRaw'), outObj.raw ? 1 : 0); gl.uniform1f(PSh.u('uTxtA'), outObj.raw ? 0 : 1);
            gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, txtTex); gl.uniform1i(PSh.u('uTxt'), 1); gl.activeTexture(gl.TEXTURE0);
            gl.uniform2f(PSh.u('uImp'), impact[0] / (W / H), impact[1]); gl.uniform1f(PSh.u('uFront'), tS * CRACK_V);
            gl.uniform1f(PSh.u('uAsp'), W / H); gl.uniform1f(PSh.u('uPx'), SCALE);
            if (outObj.raw) { gl.uniform1f(PSh.u('uBarT'), 0); gl.uniform1f(PSh.u('uBarB'), 0); }   // la entrada copiada: pantalla entera
            const nx = tex[showI]; gl.activeTexture(gl.TEXTURE3); gl.bindTexture(gl.TEXTURE_2D, nx.t); gl.uniform1i(PSh.u('uNext'), 3); gl.activeTexture(gl.TEXTURE0);
            gl.uniform2f(PSh.u('uVidN'), nx.w, nx.h);
            gl.bindBuffer(gl.ARRAY_BUFFER, shBuf);
            const at = (nm, sz, off) => { const k = gl.getAttribLocation(PSh, nm); gl.enableVertexAttribArray(k); gl.vertexAttribPointer(k, sz, gl.FLOAT, false, 56, off * 4); return k; };
            const ls = [at('aClip', 2, 0), at('aUv', 2, 2), at('aEdge', 1, 4), at('aSh', 4, 5), at('aVel', 2, 9), at('aLife', 1, 11), at('aN', 2, 12)];
            gl.drawArrays(gl.TRIANGLES, 0, nVerts); ls.forEach((k) => gl.disableVertexAttribArray(k));
            const tEnd = maxStart + 1.0;
            if (tS >= Math.min(0.85, tEnd * 0.58) && onReveal) { const r = onReveal; onReveal = null; r(); }   // mismo reloj que la rotura
            if (tS >= tEnd) { outObj = null; shotT0 = now; const d = onDone; onDone = null; if (d) d(); }
          }
          // letterbox: dos franjas negras (clear con scissor), debajo de la gema
          if (barF > 0.0005) { gl.enable(gl.SCISSOR_TEST); gl.clearColor(0.02, 0.02, 0.024, 1);
            const bt = Math.round(barT * cv.height), bb = Math.round(barB * cv.height);
            if (bb > 0) { gl.scissor(0, 0, cv.width, bb); gl.clear(gl.COLOR_BUFFER_BIT); }
            if (bt > 0) { gl.scissor(0, cv.height - bt, cv.width, bt); gl.clear(gl.COLOR_BUFFER_BIT); }
            gl.disable(gl.SCISSOR_TEST); }
          return true; };
        film = {
          ok: () => ok,
          cut: (i) => { showI = i; outObj = null; shotT0 = performance.now(); },
          snapCred,
          shatter: (from, to, done, reveal) => { const now = performance.now();
            outZoom = 1.0 + 0.035 * Math.min(1, (now - shotT0) / 14000); outPan = 0;
            impact = [gemState.x * (W / H), gemState.y];                 // la gema es el obturador: el corte sale de ella
            buildFracture(impact[0], impact[1]);
            outObj = tex[from]; showI = to; tr0 = now; onDone = done; onReveal = reveal; },
          // entrar: la ENTRADA (con la gema) se copia y estalla desde la gema, abriendo el primer plano
          enterBreak: (to, done, reveal) => { landSnap = { to, done, reveal }; },
          plateOf: (i) => tex[i], pump,
          afterGem: (now) => { if (!landSnap) return; const L = landSnap; landSnap = null;
            if (!landTex) landTex = mkTex(); gl.bindTexture(gl.TEXTURE_2D, landTex);
            gl.copyTexImage2D(gl.TEXTURE_2D, 0, gl.RGB, 0, 0, cv.width, cv.height, 0);
            outObj = { t: landTex, w: cv.width, h: cv.height, raw: true }; outZoom = 1; outPan = 0; filmA = 1; barA = 1;   // header/letterbox ya puestos: la UI del sitio nunca asoma
            impact = [gemState.x * (W / H), gemState.y]; buildFracture(impact[0], impact[1]);
            showI = L.to; tr0 = now; shotT0 = now; onDone = L.done; onReveal = L.reveal; landT0 = now; },
        };

        // ── gema ──
        let gemState = { x: 0.5, y: 0.05 };
        let mtx = 0, mty = 0, pmx = 0, pmy = 0;
        addEventListener('pointermove', (e) => { mtx = e.clientX / innerWidth - 0.5; mty = e.clientY / innerHeight - 0.5; if (reduceMotion) kick(); });
        let a = 0, aber = 0, ent = 0, sc = 0, cx = 0, cy = 0, wordAmt = 0, brk = reduceMotion ? 0 : 0.12, scInit = false, yaw = 0, crack = 1.5, plateA = 0, tintA = 0, tint = [1, 1, 1];
        const rotM = (ax, ay, az) => {
          const cX = Math.cos(ax), sX = Math.sin(ax), cY = Math.cos(ay), sY = Math.sin(ay), cZ = Math.cos(az), sZ = Math.sin(az);
          const rxy = [[cY, 0, sY], [sX * sY, cX, -sX * cY], [-cX * sY, sX, cX * cY]]; const rz = [[cZ, -sZ, 0], [sZ, cZ, 0], [0, 0, 1]]; const m = [];
          for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) { let s = 0; for (let k = 0; k < 3; k++) s += rz[r][k] * rxy[k][c]; m[r * 3 + c] = s; }
          return new Float32Array([m[0], m[3], m[6], m[1], m[4], m[7], m[2], m[5], m[8]]); };
        const drawGem = (now, dt, filmOn) => {
          const lp = (r) => (reduceMotion ? 1 : 1 - Math.exp(-r * dt));
          ent += ((entered ? 1 : 0) - ent) * lp(3.2);
          // obturador: al cortar, la gema destella y se sacude
          const bt = (now - burstT) / 1000; const hit = bt >= 0 && bt < 0.6 ? Math.sin(Math.min(1, bt / 0.6) * Math.PI) : 0;
          let brkT = hit * 0.03;
          const csB = (now - bootT0) / 1000;
          if (!reduceMotion && csB < 1.15) brkT = Math.max(brkT, 0.12 * Math.pow(1 - csB / 1.15, 3));   // nace ya en el idioma de la grieta (lo lleva la luz, no el burbujeo)
          brk += (brkT - brk) * lp(9);
          const burst = brk * (1 - brk) * 4.0;
          let birth = 1; if (!reduceMotion) { const cs = (now - bootT0) / 1000; if (cs < 1.15) { const g = 1 - Math.pow(1 - cs / 1.15, 3); birth = 1 / (0.06 + 0.94 * g); } }
          const mob = W < H; const fit = mob ? 0.6 + 0.7 * (H / W) : 1;
          // dentro: sello de ≈40px abajo al centro (en apaisado, dentro del letterbox; en vertical, bajo los créditos)
          const rr = 20 / H; const small = 0.6 / rr;
          const scT = entered ? small : (mob ? 2.2 : 1.95) * fit;
          if (!scInit) { sc = scT; scInit = true; }
          sc += (scT - sc) * lp(3.4);
          const ltE = (now - landT0) / 1000, hidden = ltE >= 0 && ltE < 0.6;   // invisible tras romperse: se ubica ya como sello
          if (hidden) sc = scT;
          const cyT = entered ? (-0.5 + (mob ? 36 / H : Math.max(barPxB() / 2, 26) / H)) : 0.02;
          cy += (cyT - cy) * lp(3.4); cx += (0 - cx) * lp(3.4); if (hidden) cy = cyT;
          gemState = { x: 0.5 + cx * H / W, y: 0.5 + cy };
          gembtn.style.left = (0.5 * W + cx * H) + 'px'; gembtn.style.top = ((0.5 - cy) * H) + 'px';
          const wt = (wordReady && !entered && brk < 0.12) ? 1 : 0; wordAmt += (wt - wordAmt) * lp(entered ? 9 : 3.7);
          pmx += (mtx - pmx) * lp(3.7); pmy += (mty - pmy) * lp(3.7);
          const vel = Math.hypot(mtx - pmx, mty - pmy) * (0.0166 / Math.max(dt, 0.008));
          aber += ((Math.min(1, vel * 30) * 0.5) - aber) * lp(6.3); aber = Math.max(aber, burst * 1.4, hit * 1.3);
          if (!reduceMotion) a += 0.096 * dt * (1 + hit * 7);
          const yawT = entered ? cur * Math.PI * 0.5 : 0; yaw += (yawT - yaw) * lp(4);
          const pk = 1 - ent * 0.6;
          const ay = (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07 + Math.sin(a * 0.12 + 1.3) * 0.055) + pmx * 0.6 * pk + yaw;
          const ax = (0.12 + Math.sin(a * 0.33) * 0.07 + Math.sin(a * 0.17 + 0.6) * 0.045) - pmy * 0.45 * pk;
          const az = Math.sin(a * 0.21 + 2.0) * 0.06 + Math.sin(a * 0.09) * 0.04;
          const fx = Math.sin(a * 0.6) * 0.004 * (1 - ent), fy = Math.sin(a * 0.42 + 0.8) * 0.006 * (1 - ent);
          if (!filmOn) { gl.disable(gl.SCISSOR_TEST); gl.clearColor(0.043, 0.043, 0.055, 1); gl.clear(gl.COLOR_BUFFER_BIT); }
          // la gema chica sólo ocupa un recuadro: scissor (no se raymarchea la pantalla entera)
          const gr = (0.6 / (sc * birth)) * H * 1.9 * SCALE;
          const gx = (0.5 * W + (cx + fx) * H) * SCALE, gy = (0.5 + cy + fy) * H * SCALE;
          if (gr < cv.height * 0.45) { gl.enable(gl.SCISSOR_TEST); gl.scissor(Math.floor(gx - gr), Math.floor(gy - gr), Math.ceil(gr * 2), Math.ceil(gr * 2)); }
          else gl.disable(gl.SCISSOR_TEST);
          gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
          gl.useProgram(PG); const l = bindQuad(PG);
          gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, wordTex); gl.uniform1i(PG.u('uWord'), 0);
          gl.uniform2f(PG.u('uRes'), cv.width, cv.height); gl.uniform2f(PG.u('uCenter'), cx + fx, cy + fy); gl.uniform1f(PG.u('uScale'), sc * birth);
          gl.uniform1f(PG.u('uAber'), aber); gl.uniform1f(PG.u('uWordAmt'), wordAmt); gl.uniform1f(PG.u('uTime'), now * 0.001);
          gl.uniform1f(PG.u('uBreak'), brk);
          // invitación sin texto: cada 2,6 s un anillo de luz sale de la gema y ella late (desde ~1,4 s, sólo en la entrada)
          let ringA = 0, ringR = 0, pulse = 0;
          if (!entered && !reduceMotion) { const tt = csB - 1.4; if (tt > 0) { const ph = (tt % 2.6) / 2.6;
            ringR = 0.6 + ph * 0.6; const near = 1 - Math.min(1, Math.max(0, (Math.hypot(mtx * W / H, mty) - 0.08) / 0.3));
            ringA = Math.pow(1 - ph, 1.3) * 1.0 * Math.min(1, tt / 0.6) * (1 - near * 0.6); pulse = ph < 0.2 ? Math.sin(Math.PI * ph / 0.2) : 0; } }
          gl.uniform1f(PG.u('uRing'), ringR); gl.uniform1f(PG.u('uRingA'), ringA);
          gl.uniform1f(PG.u('uScale'), sc * birth * (1 + pulse * 0.035));
          // sello: absorbe el color del plano actual (con destello en cada corte)
          const pc = projCol[cur] || [1, 1, 1]; tint = tint.map((v, k) => v + (pc[k] - v) * lp(3));
          tintA += ((entered ? 0.7 + hit * 0.3 : 0) - tintA) * lp(4);
          gl.uniform3f(PG.u('uTint'), tint[0], tint[1], tint[2]); gl.uniform1f(PG.u('uTintAmt'), tintA);
          // grietas de luz: nacimiento brillante, respiración en reposo, más vivas bajo el cursor, destello en cada corte
          const prox = entered ? 0 : 1 - Math.min(1, Math.max(0, (Math.hypot(mtx * W / H, mty) - 0.08) / 0.3));
          const crT = (reduceMotion ? 0.3 : 0.24 + 0.08 * Math.sin(now * 0.0013)) + prox * 0.7 + hit * 2.2 + (csB < 1.4 ? (1.4 - csB) * 1.6 : 0);
          crack += (crT - crack) * lp(8);
          gl.uniform1f(PG.u('uCrack'), crack); gl.uniform1f(PG.u('uSweep'), entered ? 0.35 : 0.2 + prox * 0.25);
          // el primer plano detrás de la gema (sólo en la entrada)
          const pi = hashAt(); const po = film && film.plateOf ? film.plateOf(pi) : null;
          if (po && !entered) film.pump(pi);
          plateA += ((po && !entered && csB > 0.6 ? 1 : 0) - plateA) * lp(entered ? 12 : 1.6);
          if (po) { gl.activeTexture(gl.TEXTURE2); gl.bindTexture(gl.TEXTURE_2D, po.t); gl.uniform1i(PG.u('uPlate'), 2); gl.activeTexture(gl.TEXTURE0);
            gl.uniform1f(PG.u('uPlateAsp'), po.w / po.h); }
          gl.uniform1f(PG.u('uPlateAmt'), po ? plateA : 0);
          // al entrar, la gema de la entrada se rompe con la pantalla: la viva reaparece ya como sello
          const lt = (now - landT0) / 1000; gl.uniform1f(PG.u('uAlpha'), lt >= 0 && lt < 1.1 ? Math.max(0, Math.min(1, (lt - 0.6) / 0.5)) : 1);
          gl.uniform1f(PG.u('uWordMode'), 0); gl.uniform1f(PG.u('uRipple'), 0); gl.uniform1f(PG.u('uWinFrac'), 1); gl.uniform1f(PG.u('uScroll'), 0);
          gl.uniformMatrix3fv(PG.u('uRot'), false, rotM(ax, ay, az));
          gl.drawArrays(gl.TRIANGLES, 0, 3); gl.disableVertexAttribArray(l); gl.disable(gl.SCISSOR_TEST); };

        let fAcc = 0, fN = 0;
        const frame = (now) => { if (!ok) return; now = performance.now();
          const dt = Math.min(0.05, lastNow ? (now - lastNow) / 1000 : 0.016); lastNow = now;
          // DPR adaptativo: cada ~90 cuadros, si el promedio pasa 21 ms baja la escala; si sobra, la recupera
          if (!reduceMotion && dt > 0) { fAcc += dt; fN++; if (fN >= 90) { const avg = fAcc / fN; fAcc = 0; fN = 0;
            if (avg > 0.021 && qual > 0.55) { qual *= 0.85; resize(); } else if (avg < 0.0135 && qual < 1) { qual = Math.min(1, qual * 1.1); resize(); } } }
          gl.viewport(0, 0, cv.width, cv.height);
          const filmOn = drawFilm(now, dt); drawGem(now, dt, filmOn); film.afterGem(now); };
        if (reduceMotion) {
          // sin rAF continuo: un cuadro por cambio de estado
          let req = 0; kick = () => { if (!req) req = requestAnimationFrame(() => { req = 0; frame(); }); }; kick();
        } else { const loop = () => { frame(); requestAnimationFrame(loop); }; requestAnimationFrame(loop); }
      }
    </script>
  </body>
</html>
