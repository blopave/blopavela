---
// VERSIÓN cine (exploración, ver src/data/versiones.ts) — cambio de FORMATO: el sitio es una SALA.
// Entrada = la gema (nacimiento + BLOPA), siempre. Al entrar, cada proyecto es un PLANO a pantalla completa con
// el video de su sitio (desde su home), créditos de película y el texto del case. Rueda / flechas / swipe pasan
// de plano. La transición es la firma: la gema actúa de OBTURADOR — de ella sale una fractura radial-concéntrica
// que se propaga por el cuadro; cada esquirla es una pieza 3D (cuaternión, normal propia, fresnel/especular en el
// canto, motion blur por velocidad) con física semi-implícita (gravedad + arrastre) y despega cuando la grieta pasa.
// Todo en UN contexto WebGL: film + esquirlas + gema (la gema chica se dibuja con scissor).
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>blopa</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="blopa — portfolio de Pablo Vela: sitios con firma visual propia, desde Buenos Aires." />
    <meta property="og:title" content="blopa" />
    <meta property="og:description" content="Portfolio de Pablo Vela — sitios con firma visual propia. Buenos Aires." />
    <meta property="og:image" content="https://www.blopavela.com/img/og.jpg" />
    <meta property="og:url" content="https://www.blopavela.com/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://www.blopavela.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Fragment Mono'; src:url('/fonts/FragmentMono-Regular.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --mid:#9c9ea7; --soft:#7b7d86; --dim:#4b4d55; --hair:#22222a;
        --aqua:#24e2e8; --red:#ff3a54;
        --display:'Bebas Neue',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:'Fragment Mono',ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.3rem,4vw,4rem);
        --bt:clamp(48px,7vh,72px); --bb:var(--bt); }
      /* vertical: header reservado sobre el video (nav + índice), sin barra inferior */
      @media(orientation:portrait){ :root{ --bt:calc(3.4rem + 46px); --bb:0px } }
      .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
      *{box-sizing:border-box;margin:0}
      [hidden]{display:none!important}
      html,body{height:100%}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);overflow:hidden;-webkit-font-smoothing:antialiased;line-height:1.5;
        overscroll-behavior:none;touch-action:none}
      a{color:inherit;text-decoration:none}
      .mono{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;font-feature-settings:"case"}
      :focus-visible{outline:1px solid var(--aqua);outline-offset:3px;border-radius:4px}

      canvas.gl{position:fixed;inset:0;z-index:1;pointer-events:none}
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer;appearance:none;border:0;background:none;padding:0;color:inherit}
      .enter:focus-visible{outline-offset:-8px}
      body.entered .enter{pointer-events:none}

      /* la franja sólida de créditos, el header reservado y el letterbox se dibujan en el GL: así la gema-sello,
         que vive en el mismo canvas, queda por encima de ellos */

      .nav{position:fixed;top:0;left:0;right:0;z-index:9;display:flex;justify-content:space-between;align-items:center;
        height:var(--bt);padding:0 var(--gut);color:var(--mid);opacity:0;transition:opacity .6s var(--ease)}
      body.entered .nav{opacity:1;transition-delay:.5s}
      .nav__home{appearance:none;background:none;border:0;cursor:pointer;color:var(--mid);letter-spacing:.16em;font-size:.75rem;
        min-height:44px;transition:color .25s}
      .nav__home:hover{color:var(--ink)}
      .nav__mail{text-transform:none;letter-spacing:0;font-size:.75rem;color:var(--mid);min-height:44px;display:inline-flex;align-items:center;transition:color .25s}
      .nav__mail:hover{color:var(--ink)}
      /* el nombre acompaña al mail en desktop (como en las otras versiones); en mobile queda sólo el mail */
      @media(max-width:640px){ .nav__who{display:none} }

      /* índice del rollo: DENTRO de la barra negra superior (centrado en apaisado; 2ª fila del header en vertical) */
      .cnt{position:fixed;left:50%;transform:translateX(-50%);top:0;height:var(--bt);z-index:10;display:flex;align-items:center;gap:.9rem;
        opacity:0;transition:opacity .6s var(--ease)}
      body.entered .cnt{opacity:1;transition-delay:.7s}
      .cnt__n{color:var(--ink);min-width:4.2em}
      .cnt__n span{color:var(--soft)}
      .cnt__ticks{display:flex}
      .cnt__ticks button{appearance:none;background:none;border:0;cursor:pointer;width:44px;height:44px;display:grid;place-items:center;color:var(--soft)}
      .cnt__ticks button i{display:block;width:22px;height:2px;background:currentColor;border-radius:1px;transition:width .45s var(--ease),background .3s}
      .cnt__ticks button:hover{color:var(--mid)}
      .cnt__ticks button.on{color:var(--ink)} .cnt__ticks button.on i{width:34px}

      /* créditos del plano */
      /* tercio inferior: nombre + qué se hizo a la izquierda, la idea y las acciones a la derecha */
      .cred{position:fixed;left:var(--gut);right:var(--gut);bottom:calc(var(--bb) + clamp(1.2rem,3.2vh,2.4rem));z-index:3;
        display:grid;grid-template-columns:minmax(0,1fr) minmax(0,44ch);column-gap:3rem;align-items:end}
      .cred__eye{color:var(--mid);margin-bottom:.4rem}
      .cred__role{color:#d9dbe0;margin-top:.7rem}
      .cred__role b{font-weight:400;color:var(--aqua)}
      .cred__name{font-family:var(--display);font-weight:400;font-size:clamp(3rem,7.4vw,8.4rem);line-height:.84;letter-spacing:.005em;
        white-space:nowrap;margin-left:-.04em;outline:none}
      /* las letras se crean por JS (sin el atributo de scope de Astro): reglas globales */
      :global(.ln){display:block;overflow:hidden;padding-top:.06em}
      :global(.ch){display:inline-block;transform:translateY(105%);transition:transform .9s var(--ease)}
      .cred.on :global(.ch){transform:none}
      .cred__body{min-height:4.6em}
      .cred__app{max-width:44ch;color:#dcdee3;font-size:.95rem;line-height:1.5}
      .cred__dl{display:grid;grid-template-columns:auto 1fr;gap:.35rem 1.2rem;max-width:44ch;font-size:.9rem;line-height:1.45}
      .cred__dl dt{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);padding-top:.2em}
      .cred__dl dd{margin:0;color:#e6e7eb}
      .cred__body>*{opacity:0;transform:translateY(10px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
      .cred.on .cred__body>*{opacity:1;transform:none;transition-delay:.3s}
      .cred__row{display:flex;align-items:center;gap:.6rem;margin-top:1.1rem;flex-wrap:wrap;opacity:0;transform:translateY(10px);
        transition:opacity .7s var(--ease),transform .7s var(--ease)}
      .cred.on .cred__row{opacity:1;transform:none;transition-delay:.42s}
      .cred__role{opacity:0;transition:opacity .7s var(--ease)} .cred.on .cred__role{opacity:1;transition-delay:.25s}
      .btn{display:inline-flex;gap:.5rem;align-items:center;min-height:44px;padding:0 1.15rem;border:1px solid rgba(242,243,245,.32);border-radius:999px;
        color:var(--ink);background:rgba(10,10,14,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);cursor:pointer;
        transition:border-color .3s,background .3s}
      .btn:hover{border-color:var(--ink)}
      .btn span{color:var(--aqua)}
      .btn--ghost{border-color:transparent;background:none;backdrop-filter:none;-webkit-backdrop-filter:none;color:var(--mid)}
      .btn--ghost:hover{color:var(--ink);border-color:rgba(242,243,245,.2)}
      .btn--ghost[aria-pressed="true"]{color:var(--ink);border-color:rgba(242,243,245,.32)}
      .btn kbd{font:inherit;color:var(--dim);border:1px solid var(--hair);border-radius:4px;padding:0 .3em;font-size:.9em}
      .cred.out :global(.ch){transform:translateY(-105%);transition-duration:.45s;transition-delay:0s!important}
      /* durante el corte, los créditos viajan DENTRO de las esquirlas (textura); el DOM se apaga en seco */
      .cred.gone{visibility:hidden}
      /* fuera de la sala (entrada / volver) los créditos no existen: si no, el último plano queda flotando sobre la gema */
      body:not(.entered) .cred{opacity:0;visibility:hidden;transition:opacity .35s var(--ease),visibility 0s .35s}

      /* la gema chica es un SELLO (≈40px) y un botón: abre el índice */
      .gembtn{position:fixed;z-index:8;transform:translate(-50%,-50%);border-radius:50%;appearance:none;border:0;background:none;cursor:pointer;
        width:48px;height:48px}

      .idx{position:fixed;inset:0;z-index:6;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.1rem;
        background:rgba(6,6,9,.84);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);opacity:0;visibility:hidden;
        transition:opacity .45s var(--ease),visibility .45s}
      body.idx-open .idx{opacity:1;visibility:visible;transition:opacity .45s var(--ease),visibility 0s}   /* visible ya: el foco puede entrar */
      .idx button{appearance:none;background:none;border:0;cursor:pointer;color:var(--ink);display:flex;align-items:baseline;gap:1rem;
        font-family:var(--display);font-size:clamp(2.8rem,8vw,6.5rem);line-height:1;padding:.15rem .4rem;transition:color .3s,text-shadow .3s}
      .idx button small{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;color:var(--soft)}
      .idx:hover button:not(:hover){color:var(--dim)}
      .idx button:hover,.idx button:focus-visible{text-shadow:-2px 0 var(--red),2px 0 var(--aqua)}
      .idx__hint{margin-top:1.6rem;color:var(--soft)}

      @media (pointer:coarse){ .idx__hint,.btn kbd{display:none} }
      @media(orientation:portrait){
        .nav{height:3.4rem}
        .cnt{left:var(--gut);transform:none;top:3.4rem;height:46px}
        .cred{display:block;right:var(--gut);bottom:calc(4.4rem + env(safe-area-inset-bottom,0px))}
        .cred__body{margin-top:.9rem;min-height:0}
        .cred__row{margin-top:.9rem}
        .cred__name{font-size:clamp(3rem,15vw,6rem)}
        .cred__app,.cred__dl{font-size:.88rem}
      }
      /* apaisado bajo (teléfono acostado): créditos compactos para que la franja no se coma el plano */
      @media(orientation:landscape) and (max-height:520px){
        .cred{bottom:calc(var(--bb) + .7rem);grid-template-columns:minmax(0,1fr) minmax(0,46ch);column-gap:2rem}
        .cred__name{font-size:clamp(2.2rem,12.5vh,8.4rem)}
        .cred__eye{margin-bottom:.2rem} .cred__role{margin-top:.45rem}
        .cred__body{min-height:0} .cred__app,.cred__dl{font-size:.8rem;line-height:1.4} .cred__dl{gap:.1rem 1rem}
        .cred__row{margin-top:.55rem}
      }
      .vids{position:fixed;width:2px;height:2px;opacity:0;pointer-events:none;overflow:hidden;left:0;top:0}

      /* sin WebGL (o sin JS): los planos como HTML con su póster */
      .fallback{display:none;padding:var(--gut);max-width:70rem;margin:0 auto}
      .fallback__brand{font-family:var(--display);font-weight:400;font-size:4rem;letter-spacing:.16em;margin:1rem 0 2rem}
      .fallback article{margin:0 0 3.5rem}
      .fallback img{width:100%;height:auto;border-radius:6px;display:block}
      .fallback h2{font-family:var(--display);font-weight:400;font-size:clamp(2.6rem,8vw,5rem);line-height:.9;margin:1rem 0 .6rem}
      .fallback p{max-width:44ch;color:#d4d6dc}
      .fallback a{display:inline-block;margin-top:.8rem;color:var(--aqua)}
      body.nogl{overflow:auto;touch-action:auto}
      body.nogl>*:not(main),body.nogl main>*:not(.fallback){display:none!important}
      body.nogl .fallback{display:block}
      @media (prefers-reduced-motion:reduce){*{transition-duration:.01s!important;transition-delay:0s!important;animation:none!important}}
    </style>
    <noscript><style>body{overflow:auto;touch-action:auto} body>*:not(main),main>*:not(.fallback){display:none!important} .fallback{display:block!important}</style></noscript>
  </head>
  <body>
    <canvas class="gl" data-gl aria-hidden="true"></canvas>
    <button type="button" class="enter" data-enter aria-label="Entrar a los proyectos"></button>

    <nav class="nav mono" aria-label="Navegación" data-ui>
      <button type="button" class="nav__home mono" data-home>blopa</button>
      <a class="nav__mail" href="mailto:blopave@pm.me"><span class="nav__who">Pablo Vela&nbsp;·&nbsp;</span>blopave@pm.me ↗</a>
    </nav>

    <div class="cnt mono" data-ui data-cnt>
      <span class="cnt__n" data-num aria-live="polite"></span>
      <div class="cnt__ticks" role="group" aria-label="Proyectos">
        {projects.map((p, i) => (
          <button type="button" data-go={i} aria-label={`${String(i + 1).padStart(2, '0')} — ${p.name}`}><i></i></button>
        ))}
      </div>
    </div>

    <main>
    <h1 class="sr">blopa — portfolio de Pablo Vela: sitios con firma visual propia</h1>
    <section class="cred" data-cred data-ui aria-label="Proyecto">
      <div class="cred__head">
        <p class="cred__eye mono" data-cat></p>
        <h2 class="cred__name" data-name tabindex="-1"></h2>
        <p class="cred__role mono" data-kind></p>
      </div>
      <div class="cred__side">
      <div class="cred__body">
        <p class="cred__app" data-app></p>
        <dl class="cred__dl" data-credits id="creditos" hidden>
          <dt>Rol</dt><dd data-role></dd>
          <dt>Servicios</dt><dd data-services></dd>
          <dt>Stack</dt><dd data-stack></dd>
        </dl>
      </div>
      <div class="cred__row">
        <a class="btn mono" data-live target="_blank" rel="noopener">Ver en vivo <span aria-hidden="true">↗</span></a>
        <button type="button" class="btn btn--ghost mono" data-crbtn aria-pressed="false" aria-controls="creditos">Créditos <kbd aria-hidden="true">C</kbd></button>
      </div>
      </div>
    </section>

    <button type="button" class="gembtn" data-gembtn data-ui aria-label="Índice de proyectos" aria-haspopup="dialog"></button>
    <div class="idx" data-idx role="dialog" aria-modal="true" aria-label="Índice de proyectos">
      {projects.map((p, i) => (
        <button type="button" data-go={i}><small>{String(i + 1).padStart(2, '0')}</small>{p.name}</button>
      ))}
      <p class="idx__hint mono">Esc para volver</p>
    </div>
    <div class="vids" data-vids aria-hidden="true"></div>

    <section class="fallback" aria-label="Proyectos">
      <p class="fallback__brand">BLOPA</p>
      {projects.map((p) => (
        <article>
          <img src={`/img/poster/${p.slug}.jpg`} alt={`${p.name} — home del sitio`} width="1280" height="800" loading="lazy" />
          <h2>{p.name}</h2>
          <p>{p.approach}</p>
          {p.url && <a href={p.url} target="_blank" rel="noopener">Ver en vivo ↗</a>}
        </article>
      ))}
      <p><a href="mailto:blopave@pm.me">blopave@pm.me</a></p>
    </section>
    </main>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const N = projects.length;
      const FRAMED = (() => { try { return window.self !== window.top; } catch { return true; } })();
      // entre planos se REEMPLAZA (Atrás sale de la sala, no recorre cada paso); entrar/salir sí apila
      const pushHash = (h, replace = false) => { const target = h ? '#' + h : ''; if (location.hash === target) return;
        const url = location.pathname + target; if (FRAMED || replace) history.replaceState(null, '', url); else history.pushState(null, '', url); };

      // ── estado ──
      let entered = false, cur = 0, busy = false, pending = null, bootT0 = performance.now(), burstT = -9;
      let kick = () => {};   // pide un cuadro (con movimiento reducido no hay rAF continuo)
      const $ = (s) => document.querySelector(s);
      const credEl = $('[data-cred]'), nameEl = $('[data-name]'), numEl = $('[data-num]'), catEl = $('[data-cat]'),
        appEl = $('[data-app]'), liveEl = $('[data-live]'), dlEl = $('[data-credits]'), crBtn = $('[data-crbtn]'),
        roleEl = $('[data-role]'), servEl = $('[data-services]'), stackEl = $('[data-stack]'),
        idxEl = $('[data-idx]'), gembtn = $('[data-gembtn]'), enterEl = $('[data-enter]'), kindEl = $('[data-kind]');
      // qué fue: encargo o producto propio + el rol (visible bajo el título, no escondido en "Créditos")
      const OWN = ['pulz', 'basslayer'];
      const tickBtns = Array.from(document.querySelectorAll('.cnt [data-go]'));
      const uiEls = Array.from(document.querySelectorAll('[data-ui]'));
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      const pad = (n) => String(n).padStart(2, '0');

      // accesibilidad: lo invisible no es alcanzable (inert)
      const setInert = () => {
        const idxOpen = body.classList.contains('idx-open');
        uiEls.forEach((el) => { el.inert = !entered || (idxOpen && el !== $('.nav')); });
        idxEl.inert = !idxOpen; enterEl.inert = entered; };
      setInert();

      const setCred = (i) => { const p = projects[i];
        numEl.innerHTML = pad(i + 1) + ' <span>/ ' + pad(N) + '</span>';
        catEl.textContent = p.category + ' · ' + yearOf(p.ended);
        nameEl.innerHTML = '<span class="ln" aria-hidden="true">' + Array.from(p.name).map((c, k) =>
          '<span class="ch" style="transition-delay:' + (k * 0.028).toFixed(3) + 's">' + (c === ' ' ? '&nbsp;' : c) + '</span>').join('') + '</span>';
        nameEl.setAttribute('aria-label', p.name);
        appEl.textContent = p.approach || '';
        kindEl.innerHTML = '<b>' + (OWN.includes(p.slug) ? 'Producto propio' : 'Encargo') + '</b> · ' + (p.role || '').replace(/\s*&\s*/g, ' + ');
        roleEl.textContent = p.role || ''; servEl.textContent = (p.services || []).join(', '); stackEl.textContent = (p.stack || []).join(', ');
        if (p.url) { liveEl.href = p.url; liveEl.style.display = ''; liveEl.setAttribute('aria-label', 'Ver ' + p.name + ' en vivo'); } else liveEl.style.display = 'none';
        tickBtns.forEach((b, k) => { b.classList.toggle('on', k === i); b.setAttribute('aria-current', k === i ? 'true' : 'false'); });
        document.title = 'blopa — ' + p.name; bandMeasure(); };
      const credIn = () => { credEl.classList.remove('out', 'gone'); void credEl.offsetWidth; credEl.classList.add('on'); };
      // créditos de película (Rol / Servicios / Stack): conmutan con la idea sin romper el plano
      const showCredits = (on) => { dlEl.hidden = !on; appEl.hidden = on; crBtn.setAttribute('aria-pressed', on ? 'true' : 'false'); bandMeasure(); kick(); };
      crBtn.addEventListener('click', () => showCredits(dlEl.hidden));

      // ── videos: sólo el actual decodifica; el siguiente baja metadatos; en táctil, la versión de 640 ──
      // vertical: la versión MOBILE real de cada sitio (720×1558, nativa); apaisado táctil: 640; desktop: 1280
      const PORT = () => innerWidth < innerHeight;
      const sufOf = () => (PORT() ? '-m' : coarse ? '-640' : '');
      let VSUF = sufOf();
      // tramo con contenido (todos empiezan por su home; fin antes de colas vacías)
      // PULZ arranca pasada su animación de logo (si no, el nombre se lee doble) · (los verticales: PULZ corta antes del titular "Encontrá tu…" que cae justo detrás de los créditos)
      const SPAN = { valecasenave: [0, 13], pulz: [2.9, 14.4], basslayer: [0, 18.4], beokey: [0, 15.6] };
      const SPAN_M = { valecasenave: [0, 14.2], pulz: [8.6, 14.4], basslayer: [0, 16], beokey: [0, 15.3] };
      const spanOf = (i) => (VSUF === '-m' ? SPAN_M : SPAN)[projects[i].slug] || [0, 1e9];
      const vidBox = $('[data-vids]');
      const vids = projects.map((p, i) => { const v = document.createElement('video');
        v.muted = true; v.loop = true; v.playsInline = true; v.setAttribute('playsinline', ''); v.setAttribute('muted', '');
        v.preload = 'none'; v.poster = '/img/poster/' + p.slug + (VSUF === '-m' ? '-m' : '') + '.jpg'; v.src = '/video/' + p.slug + VSUF + '.mp4';
        v.addEventListener('timeupdate', () => { const [a, b] = spanOf(i); if (v.currentTime > b) v.currentTime = a; });
        vidBox.appendChild(v); return v; });
      // al rotar el teléfono cambia la fuente (vertical nativa ↔ apaisada)
      const reSource = () => { const nv = sufOf(); if (nv === VSUF) return; VSUF = nv;
        vids.forEach((v, k) => { const pre = v.preload; v.poster = '/img/poster/' + projects[k].slug + (VSUF === '-m' ? '-m' : '') + '.jpg';
          v.src = '/video/' + projects[k].slug + VSUF + '.mp4'; v.preload = pre; if (pre !== 'none') v.load(); });
        if (typeof onReSource === 'function') onReSource(); if (entered) playOnly(cur); };
      let onReSource = null, onPlayHook = null;
      addEventListener('resize', reSource);
      const playOnly = (i) => {
        vids.forEach((v, k) => { if (k !== i) { v.pause(); if (v.preload === 'auto') v.preload = 'metadata'; } });
        if (reduceMotion) return;   // movimiento reducido: el plano queda quieto (póster)
