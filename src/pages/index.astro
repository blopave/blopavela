---
// HOME = VERSIÓN prisma (publicada desde 2026-11-04; ver src/data/versiones.ts) — la gema es un PROYECTOR.
// Sala oscura: un haz fino entra, atraviesa la gema y sale dispersado; los rayos de salida se calculan
// con la FACETA REAL (trazado en CPU contra las 20 caras del icosaedro, con refracción y dispersión por
// canal), así que al girar la piedra —sola, arrastrándola o con el giroscopio— el espectro barre la sala.
// La gema proyecta el VIDEO del sitio en una pantalla: al señalar un proyecto la imagen arranca
// desenfocada (bokeh real, aberración lateral, respiración de foco) y el autofoco la encaja.
// Click → la cámara viaja por el haz y la pantalla se vuelve el case a pantalla completa.
// Arquitectura: UN contexto WebGL, 3 programas — sala (pantalla completa), prefiltro de bokeh (FBO a media
// resolución) y gema (viewport cuadrado encima). El layout lo mandan "slots" del DOM: el JS mide sus rects.
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>blopa</title>
    <meta name="description" content="blopa — portfolio de Pablo Vela: sitios con firma visual propia, desde Buenos Aires." />
    <meta property="og:title" content="blopa" />
    <meta property="og:description" content="Portfolio de Pablo Vela — sitios con firma visual propia. Buenos Aires." />
    <meta property="og:image" content="https://www.blopavela.com/img/og.jpg" />
    <meta property="og:url" content="https://www.blopavela.com/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://www.blopavela.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0b0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Fragment Mono'; src:url('/fonts/FragmentMono-Regular.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --mid:#9c9ea7; --soft:#7b7d86; --dim:#4b4d55; --hair:#22222a;
        --display:'Bebas Neue',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:'Fragment Mono',ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.3rem,4vw,4rem); }
      *{box-sizing:border-box;margin:0}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);min-height:100svh;overflow:hidden;
        -webkit-font-smoothing:antialiased;line-height:1.5}
      a{color:inherit;text-decoration:none}
      ::selection{background:rgba(36,226,232,.3);color:#fff}
      /* flechas: un solo trazo dibujado (no glifos unicode) */
      .ar{width:.95em;height:.95em;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.12em}
      .nav__home,.kase__back,.case__eye,.case__live,.kase__next,.scr__label,.cred dt{font-feature-settings:"case"}
      /* foco visible y consistente (teclado) */
      :focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:3px}
      .case__title:focus,.case__title:focus-visible{outline:none}

      canvas.room{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .9s var(--ease)}
      body.gl-on canvas.room{opacity:1}

      /* slots: sólo MEDIDAS (dónde va la gema / la pantalla en cada estado). Invisibles. */
      .slot{position:fixed;visibility:hidden;pointer-events:none}
      #g-land{left:50%;top:50%;width:calc(min(100vw,100svh) * .62);aspect-ratio:1;transform:translate(-50%,-50%)}
      #g-idx{left:43vw;top:50svh;width:min(30svh,23vw);aspect-ratio:1;transform:translate(-50%,-50%)}

      /* pantalla del índice + cartela */
      .scr{position:fixed;left:59vw;width:36vw;top:50svh;transform:translateY(-50%);z-index:3;pointer-events:none}
      #s-idx{position:relative;visibility:hidden;width:100%;aspect-ratio:16/10}
      .scr__label{display:flex;justify-content:space-between;gap:1rem;margin-top:.9rem;font-family:var(--mono);font-size:.6875rem;
        letter-spacing:.08em;text-transform:uppercase;color:var(--soft);opacity:0;transition:opacity .5s var(--ease)}
      .scr__label b{font-weight:400;color:var(--mid)}
      .scr__label.idle b{color:var(--soft)}
      body.entered:not(.in-case) .scr__label.on{opacity:1;transition-delay:.25s}

      .nav{position:fixed;top:0;left:0;right:0;z-index:8;display:flex;justify-content:space-between;align-items:center;
        padding:calc(var(--gut) - 13px) var(--gut);font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);
        opacity:0;pointer-events:none;transition:opacity .5s var(--ease)}
      body.entered .nav{opacity:1;transition-delay:.3s}
      body.entered .nav .nav__home,body.entered .nav .nav__contact{pointer-events:auto}
      .nav__home{appearance:none;background:none;border:0;font:inherit;font-size:.75rem;min-height:44px;padding:0;letter-spacing:.16em;text-transform:uppercase;
        color:var(--mid);cursor:pointer;transition:color .25s var(--ease)}
      .nav__home:hover{color:var(--ink)}
      .nav__contact{text-transform:none;letter-spacing:0;font-size:.75rem;color:var(--mid);white-space:nowrap;transition:color .25s var(--ease);
        display:inline-flex;align-items:center;min-height:44px}
      .nav__contact:hover{color:var(--ink)}
      .nav__r{display:inline-flex;align-items:center;gap:1.4rem}
      @media(max-width:640px){ .nav__r{gap:.6rem} }
      @media(max-width:640px){ .nav__who{display:none} }

      /* entrada: toda la pantalla es el disparador; táctil: el gesto (arrastre/swipe) lo maneja el JS */
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer;touch-action:none;appearance:none;border:0;background:transparent;padding:0;margin:0;color:inherit;border-radius:0}
      .enter:focus-visible{outline:2px solid var(--ink);outline-offset:-10px}
      body.entered .enter{pointer-events:none}
      body.dragging,body.dragging *{cursor:grabbing!important}

      /* índice: nombres a la izquierda; el haz baja por detrás de ellos hacia la gema */
      .index{position:fixed;left:0;top:0;bottom:0;z-index:3;display:flex;flex-direction:column;justify-content:center;
        gap:.15rem;padding:clamp(5rem,12vh,9rem) var(--gut) 4rem;max-width:min(36vw,32rem);touch-action:pan-y;
        opacity:0;pointer-events:none;transition:opacity .7s var(--ease)}
      body.entered .index{opacity:1;pointer-events:auto;transition-delay:.45s}
      body.in-case .index{opacity:0;pointer-events:none;transition-delay:0s}
      body.from-case .index{transition-delay:.85s}   /* a la vuelta, los nombres esperan a que la pantalla se achique */
      .prow{appearance:none;background:none;border:0;cursor:pointer;text-align:left;color:inherit;position:relative;
        display:flex;align-items:baseline;gap:1rem;padding:.45rem 0;
        opacity:0;transform:translateY(.9rem);transition:opacity .6s var(--ease),transform .9s var(--ease)}
      /* los nombres suben uno tras otro cuando el índice aparece (a la salida se van juntos) */
      body.entered .prow{opacity:1;transform:none;transition-delay:calc(.5s + var(--i) * .07s)}
      body.from-case .prow{transition-delay:0s}
      .prow__name{font-family:var(--display);font-weight:400;font-size:clamp(2.6rem,4.9vw,4.4rem);
        letter-spacing:.01em;line-height:1;color:var(--ink);white-space:nowrap;
        transition:color .35s var(--ease),text-shadow .35s var(--ease),transform .45s var(--ease)}
      /* la lista "refracta": el nombre señalado toma el borde cian/rojo del haz */
      .prow.on .prow__name{text-shadow:-1.5px 0 rgba(255,58,84,.85),1.5px 0 rgba(36,226,232,.85)}
      .index.has-on .prow:not(.on) .prow__name{color:var(--dim)}
      .prow.on .prow__name{transform:translateX(.9rem)}
      .prow__idx{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;color:var(--soft);opacity:0;transform:translateX(-6px);
        transition:opacity .3s var(--ease),transform .3s var(--ease)}
      .prow.on .prow__idx{opacity:1;transform:translateX(.9rem)}

      /* case = la proyección a pantalla completa (escala de cine); la info flota abajo-izq sobre el scrim del shader */
      .kase{position:fixed;inset:0;z-index:6;pointer-events:none;opacity:0;visibility:hidden;
        transition:opacity .6s var(--ease),visibility .6s var(--ease)}
      body.in-case .kase{opacity:1;visibility:visible;transition-delay:.55s}
      /* la info entra ESCALONADA cuando la gema ya pasó de largo (no compite con el viaje) */
      .kase__info>*{opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease),transform .9s var(--ease)}
      body.in-case .kase__info>*{opacity:1;transform:none}
      body.in-case .kase__info>:nth-child(1){transition-delay:.86s} body.in-case .kase__info>:nth-child(2){transition-delay:.93s}
      body.in-case .kase__info>:nth-child(3){transition-delay:1.02s} body.in-case .kase__info>:nth-child(4){transition-delay:1.1s}
      body.in-case .kase__info>:nth-child(5){transition-delay:1.18s} body.in-case .kase__info>:nth-child(6){transition-delay:1.26s}
      .kase__info{position:absolute;left:var(--gut);top:calc(50% + 2rem);transform:translateY(-50%);width:calc(41.667vw - var(--gut) * 1.6);max-width:44rem;pointer-events:auto;
        transition:opacity .28s var(--ease)}
      .kase__frame{display:none}
      .kase__info.swap{opacity:0}
      .case__eye{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);margin-top:.85rem}
      .case__title{font-family:var(--display);font-weight:400;font-size:clamp(3.2rem,6vw,7rem);line-height:.88;letter-spacing:.005em;margin:0}
      .case__approach{margin-top:1.3rem;color:#d4d6dc;line-height:1.55;font-size:clamp(1rem,.55rem + .55vw,1.2rem);max-width:40ch;text-wrap:pretty}
      .cred{display:grid;grid-template-columns:7rem 1fr;margin:1.5rem 0 0;border-top:1px solid rgba(255,255,255,.12)}
      .cred dt,.cred dd{padding:.55rem 0;border-bottom:1px solid rgba(255,255,255,.12);margin:0}
      .cred dt{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);padding-top:.68rem}
      .cred dd{font-size:clamp(.92rem,.5rem + .45vw,1.05rem);color:var(--ink);line-height:1.45}
      .cred dd.soft{color:var(--mid)}
      .kase__acts{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;flex-wrap:wrap}
      .kase__next{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;text-align:left;
        display:grid;grid-template-columns:auto auto;align-items:center;justify-content:start;column-gap:.75rem;row-gap:.35rem;
        min-height:44px;padding:.35rem 0;background:none;border:0;cursor:pointer;color:var(--soft);transition:color .3s var(--ease)}
      .kase__nl{grid-column:1/-1}
      .kase__next b{font-family:var(--display);font-weight:400;font-size:clamp(1.9rem,2.6vw,2.8rem);line-height:1;letter-spacing:.01em;
        color:var(--ink);transition:text-shadow .35s var(--ease)}
      .kase__next .ar{width:1.35rem;height:1.35rem;color:var(--mid);transition:transform .45s var(--ease),color .3s var(--ease)}
      .kase__next:hover b{text-shadow:-1.5px 0 rgba(255,58,84,.85),1.5px 0 rgba(36,226,232,.85)}
      .kase__next:hover .ar{transform:translateX(5px);color:var(--ink)}
      /* la acción principal del case: píldora llena justo bajo el título (donde va la mirada), con el color del proyecto */
      .case__live{--acc:#fff;display:inline-flex;align-items:center;gap:.6rem;min-height:48px;margin-top:1.2rem;padding:.7rem 1.25rem .7rem 1rem;
        border-radius:999px;background:var(--ink);color:#0b0b0e;font-family:var(--mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;
        transition:background-color .3s var(--ease),transform .3s var(--ease)}
      .case__w{font-weight:inherit}
      .case__dot{width:.5rem;height:.5rem;border-radius:50%;background:var(--acc);box-shadow:0 0 0 1px rgba(11,11,14,.35)}
      .case__live .ar{transition:transform .3s var(--ease)}
      .case__live:hover{background:#fff}
      .case__live:hover .ar{transform:translate(2px,-2px)}
      .case__live:focus-visible{outline-color:var(--acc)}
      .kase__back{position:fixed;left:var(--gut);top:calc(var(--gut) + 2.4rem);z-index:9;appearance:none;cursor:pointer;
        display:inline-flex;align-items:center;gap:.55rem;min-height:44px;padding:.6rem 1rem .6rem .8rem;border-radius:999px;
        border:1px solid var(--hair);background:rgba(12,12,16,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
        font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mid);
        opacity:0;visibility:hidden;pointer-events:none;transition:opacity .5s var(--ease),visibility .5s var(--ease),color .25s,border-color .25s}
      .kase__back svg{width:.9em;height:.9em;stroke:currentColor;fill:none;stroke-width:2}
      .kase__back:hover{color:var(--ink);border-color:var(--soft)}
      .kase{scrollbar-width:thin;scrollbar-color:var(--dim) transparent}
      body.in-case .kase__back{opacity:1;visibility:visible;pointer-events:auto;transition-delay:.8s}

      /* sin WebGL: el sitio sigue siendo un índice funcional */
      .nogl{display:none;position:relative;z-index:5;padding:calc(var(--gut) + 4rem) var(--gut) var(--gut);max-width:56rem}
      .nogl h1{font-family:var(--display);font-weight:400;font-size:clamp(3rem,9vw,6rem);line-height:.9}
      .nogl ul{list-style:none;padding:0;margin:2.4rem 0 0;border-top:1px solid var(--hair)}
      .nogl li{padding:1.1rem 0;border-bottom:1px solid var(--hair)}
      .nogl li a{font-family:var(--display);font-size:clamp(2rem,6vw,3.4rem);line-height:1}
      .nogl li p{color:var(--mid);font-size:.92rem;margin-top:.35rem;max-width:60ch}
      .nogl li small{font-family:var(--mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--soft)}
      body.no-gl{overflow:auto}
      body.no-gl canvas,body.no-gl .enter,body.no-gl .index,body.no-gl .scr,body.no-gl .kase,body.no-gl .kase__back{display:none}
      body.no-gl .nogl{display:block}
      body.no-gl .nav{opacity:1;pointer-events:auto}

      /* ── PORTRAIT (mobile): misma narrativa en columna — haz diagonal → gema → abanico → pantalla → cartela → nombres ── */
      @media(orientation:portrait){
        #g-land{top:44svh;width:76vw}
        /* índice mobile = el desktop en vertical: nombres a la izquierda, la gema arriba y el sitio MOBILE real
           proyectado en una pantalla tipo teléfono a la derecha */
        /* la gema baja lo justo para no rozar la nav en tablets (en teléfonos queda en 15svh) */
        #g-idx{left:72vw;top:max(15svh,calc(var(--gut) + 3.5rem + 11vw));width:22vw}
        /* la pantalla (teléfono vertical) se limita por ALTO: en tablets 44vw la sacaba de cuadro con la cartela;
           centrada bajo la gema (72vw) */
        .scr{--sw:min(44vw,calc((70svh - 5rem) * 720 / 1558));left:calc(72vw - var(--sw) / 2);right:auto;width:var(--sw);top:30svh;transform:none}
        #s-idx{aspect-ratio:720/1558}
        .scr__label{flex-direction:column;gap:.15rem;margin-top:.7rem;font-size:.625rem}
        :global(.scr__pre){display:none}
        .index{max-width:50vw;justify-content:flex-start;right:auto;
          padding-top:calc(30svh + 4.4rem);padding-bottom:1.5rem}
        .prow{padding:.1rem 0;min-height:44px;align-items:center}
        .prow.on .prow__name{transform:none}   /* mobile: el activo se marca SÓLO por color */
        .prow__idx{display:none}
        .prow__name{font-size:clamp(1.6rem,8vw,3.2rem)}
        /* case mobile: el sitio vertical a todo el ancho (fijo, bajo la franja de la nav) y la info sube por encima;
           título dentro del 60% superior; CTA en barra fija abajo */
        .kase{overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;
          padding:calc(var(--gut) + 5.3rem) var(--gut) calc(6.5rem + env(safe-area-inset-bottom,0px))}
        .kase__frame{display:block;margin:0 calc(-1 * var(--gut))}
        #s-casep{width:100%;height:60svh}
        .kase__info{position:static;transform:none;width:auto;max-width:none;margin-top:1.5rem}
        .case__title{font-size:clamp(3rem,15vw,4.6rem)}
        .kase__acts{position:fixed;left:0;right:0;bottom:0;margin:0;z-index:7;flex-wrap:nowrap;
          padding:.5rem var(--gut) calc(.5rem + env(safe-area-inset-bottom,0px));
          background:rgba(11,11,14,.86);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--hair)}
        .kase__acts{justify-content:flex-end;min-height:calc(64px + env(safe-area-inset-bottom,0px))}
        .kase__next{min-height:48px;display:inline-flex;align-items:center;gap:.6rem;font-size:.75rem}
        .kase__next b{font-family:var(--mono);font-size:.75rem;letter-spacing:.08em}
        .kase__next .ar{width:.95em;height:.95em}
        .case__live{position:fixed;left:var(--gut);bottom:calc(8px + env(safe-area-inset-bottom,0px));z-index:8;margin:0}
        body:not(.in-case) .case__live{pointer-events:none}
        .case__w,.kase__nl{display:none}   /* barra del pulgar: "Ver en vivo" + "BassLayer →" entran sin pisarse */
      }
      /* case con scroll (vertical y horizontal bajo): lo que sube se funde bajo la nav y el ‹ Proyectos (termina justo bajo la píldora) */
      .nav::before{content:'';position:absolute;inset:0 0 calc(var(--gut) + 18px - 5.65rem);z-index:-1;pointer-events:none;opacity:0;
        background:linear-gradient(var(--bg) 55%,rgba(11,11,14,0));transition:opacity .5s var(--ease)}
      @media(orientation:portrait){ body.in-case .nav::before{opacity:1} }
      /* ── HORIZONTAL BAJO (teléfono acostado): la ficha no entra centrada → columna con scroll bajo la nav ── */
      @media(orientation:landscape) and (max-height:540px){
        /* el scroll arranca bajo la píldora ‹ Proyectos: el texto se recorta (con fundido) ahí, nunca a su lado */
        .kase{top:calc(var(--gut) + 5.65rem);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;
          -webkit-mask-image:linear-gradient(transparent,#000 1.2rem);mask-image:linear-gradient(transparent,#000 1.2rem)}
        .kase__info{position:relative;left:auto;top:auto;transform:none;margin:1rem 0 calc(var(--gut) + 1rem) var(--gut);
          width:calc(41.667vw - var(--gut) * 1.6)}
        .case__title{font-size:clamp(2.4rem,13svh,3.6rem)}
        .case__approach{font-size:.92rem;margin-top:.8rem}
        .cred{margin-top:1rem}
        /* la pantalla es angosta: la cartela pierde el prefijo y no se parte */
        :global(.scr__pre){display:none}
        .scr__label span,.scr__label b{white-space:nowrap}
      }
      @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
    </style>
  </head>
  <body>
    <canvas class="room" data-room aria-hidden="true"></canvas>
    <noscript><style is:inline>.nogl{display:block!important}canvas.room,.enter,.index,.scr,.kase,.kase__back{display:none!important}.nav{opacity:1!important;pointer-events:auto!important}body{overflow:auto!important}</style></noscript>

    <section class="nogl" aria-label="Proyectos">
      <h1>BLOPA — Pablo Vela</h1>
      <ul>
        {projects.map((p) => (
          <li><small>{p.category} · {p.ended ? p.ended.split('-')[0] : 'En curso'}</small><br />
            <a href={p.url} target="_blank" rel="noopener">{p.name} ↗</a><p>{p.blurb}</p></li>
        ))}
      </ul>
    </section>

    <div class="slot" id="g-land"></div>
    <div class="slot" id="g-idx"></div>
    <div class="scr" aria-hidden="true">
      <div id="s-idx"></div>
      <p class="scr__label" data-label><span data-label-a></span><b data-label-b></b></p>
    </div>

    <button type="button" class="enter" data-enter aria-label="Entrar a los proyectos"></button>

    <nav class="nav" aria-label="Navegación" data-nav>
      <button type="button" class="nav__home" data-home>blopa</button>
      <span class="nav__r">
      <a class="nav__contact" href="mailto:blopave@pm.me"><span class="nav__who">Pablo Vela&nbsp;·&nbsp;</span><span class="nav__mail">blopave@pm.me</span>&nbsp;<svg class="ar" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
      </span>
    </nav>

    <main>
    <section class="index" data-index aria-label="Proyectos">
      {projects.map((p, i) => (
        <button type="button" class="prow" data-row data-slug={p.slug} style={`--i:${i}`}>
          <span class="prow__name">{p.name}</span>
          <span class="prow__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </button>
      ))}
    </section>

    <section class="kase" data-case aria-hidden="true" aria-labelledby="case-title">
      <div class="kase__frame" aria-hidden="true"><div id="s-casep"></div></div>
      <div class="kase__info" data-info>
        <h2 class="case__title" id="case-title" data-name tabindex="-1"></h2>
        <p class="case__eye" data-cat></p>
        <a class="case__live" data-live target="_blank" rel="noopener"><i class="case__dot" aria-hidden="true"></i>Ver <b class="case__w">sitio </b>en vivo <svg class="ar" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
        <p class="case__approach" data-approach></p>
        <dl class="cred">
          <dt>Rol</dt><dd data-role></dd>
          <dt>Servicios</dt><dd data-services></dd>
          <dt>Stack</dt><dd class="soft" data-stack></dd>
        </dl>
        <div class="kase__acts">
          <button type="button" class="kase__next" data-next><span class="kase__nl">Siguiente</span><b data-next-name></b><svg class="ar" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg></button>
        </div>
      </div>
    </section>
    </main>
    <button type="button" class="kase__back" data-back aria-label="Volver a proyectos">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Proyectos
    </button>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const $ = (s, r = document) => r.querySelector(s);
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      const clamp = (x, a, b) => Math.min(b, Math.max(a, x));
      const projOf = (s) => projects.find((x) => x.slug === s);
      const idxOf = (s) => projects.findIndex((x) => x.slug === s);


      // ── estado ──
      let entered = false, inCase = false;
      let cur = null;          // proyecto que la gema proyecta (hover / case / auto en táctil / dial)
      let focusT0 = -1e9;      // cuándo arrancó el autofoco actual
      const T0 = performance.now();
      let lastCase = null;
      let invalidate = () => {};   // render por demanda (lo define el bloque GL)
      let startTween = () => {};

      const FRAMED = (() => { try { return window.self !== window.top; } catch { return true; } })();
      // historial por niveles: home(0) → #proyectos(1) → #slug(2). Bajar de nivel VUELVE en el historial (Esc no apila)
      const curH = () => location.hash.replace('#', '');
      const LV = (h) => (!h ? 0 : h === 'proyectos' ? 1 : 2);
      let baseLv = LV(curH());
      const pushHash = (h) => { if (curH() === h) return;
        const url = location.pathname + location.search + (h ? '#' + h : '');
        const c = LV(curH()), t = LV(h);
        if (FRAMED) history.replaceState(null, '', url);
        else if (t > c) history.pushState(null, '', url);
        else if (t < c && t >= baseLv) history.go(t - c);
        else { history.replaceState(null, '', url); baseLv = Math.min(baseLv, t); } };

      const rows = Array.from(document.querySelectorAll('[data-row]'));
      const indexEl = $('[data-index]'), caseEl = $('[data-case]'), infoEl = $('[data-info]'), navEl = $('[data-nav]');
      const enterEl = $('[data-enter]'), backEl = $('[data-back]'), titleEl = $('[data-name]');
      const labelEl = $('[data-label]'), labelA = $('[data-label-a]'), labelB = $('[data-label-b]');

      // lo que no se ve, no se enfoca ni se lee
      const syncInert = () => {
        enterEl.inert = entered; navEl.inert = !entered;
        indexEl.inert = !entered || inCase; caseEl.inert = !inCase; backEl.inert = !inCase;
        caseEl.setAttribute('aria-hidden', inCase ? 'false' : 'true'); };

      // ── videos: bajo demanda, uno solo decodificando; mobile/táctil usa la versión 640 ──
      const SMALL = coarse || innerWidth < 900;
      const PORT = matchMedia('(orientation: portrait)').matches;   // vertical → se proyecta la versión MOBILE de cada sitio
      const vids = {}, posters = {};
      const posterOf = (slug) => { let im = posters[slug];
        if (!im) { im = new Image(); im.decoding = 'async'; im.src = '/img/poster/' + slug + (PORT ? '-m' : '') + '.jpg';
          im.addEventListener('load', () => invalidate(), { once: true }); posters[slug] = im; } return im; };
      const START = { basslayer: 3.2 };   // segundo en que cada tour ya muestra el sitio
      const vidOf = (slug) => { let v = vids[slug];
        if (!v) { v = document.createElement('video'); v.muted = true; v.loop = true; v.playsInline = true;
          v.setAttribute('playsinline', ''); v.setAttribute('muted', ''); v.preload = 'none';
          v.poster = '/img/poster/' + slug + (PORT ? '-m' : '') + '.jpg';
          v.src = '/video/' + slug + (PORT ? '-m' : SMALL ? '-640' : '') + '.mp4'; vids[slug] = v;
          const st = START[slug] || 0;   // saltea la pantalla de carga negra del sitio (también al repetir)
          if (st) { v.loop = false;
            v.addEventListener('loadedmetadata', () => { if (v.currentTime < st) v.currentTime = st; });
            v.addEventListener('ended', () => { v.currentTime = st; v.play().catch(() => {}); }); } } return v; };

      const setLabel = (a, b) => { labelA.innerHTML = '<span class="scr__pre">Proyección · </span>' + a; labelB.textContent = b; };
      // sin proyecto señalado la pantalla queda vacía; la cartela sólo dice que está en espera
      const setIdle = () => { setLabel('En espera', coarse ? 'Tocá un proyecto' : 'Señalá un proyecto'); labelEl.classList.add('on', 'idle'); };
      setIdle();
      const setProj = (slug) => {
        if (slug === cur) return;
        cur = slug; focusT0 = performance.now();
        Object.entries(vids).forEach(([k, v]) => { if (k !== slug && !v.paused) v.pause(); });
        rows.forEach((r) => r.classList.toggle('on', r.dataset.slug === slug));
        indexEl.classList.toggle('has-on', !!slug);
        if (slug) { const p = projOf(slug); posterOf(slug);
          if (!reduceMotion) { const v = vidOf(slug); v.preload = 'auto'; v._failed = false;
            try { v.currentTime = START[slug] || 0; } catch {}   // cada proyecto arranca en su HOME
            v.play().catch(() => { v._failed = true; invalidate(); }); }
          setLabel(p.name, p.category + ' · ' + yearOf(p.ended)); labelEl.classList.add('on'); labelEl.classList.remove('idle');
        } else setIdle();
        invalidate();
      };
      const nextOf = (s, d) => projects[(idxOf(s) + d + projects.length) % projects.length].slug;

      const enter = (push = true) => { if (entered) return; entered = true; startTween(1.0); body.classList.add('entered');
        syncInert(); invalidate(); if (push) pushHash('proyectos'); };
      let suppressClick = false;
      // teclado (Enter/Espacio en el botón): entra y el foco pasa al primer proyecto
      enterEl.addEventListener('click', (e) => { if (suppressClick) return; enter(); if (e.detail === 0) setTimeout(() => rows[0].focus(), 560); });
      addEventListener('wheel', (e) => { if (!entered && Math.abs(e.deltaY) > 6) enter(); }, { passive: true });

      // ── case ──
      const fill = (p) => {
        $('[data-cat]').textContent = p.category + ' · ' + yearOf(p.ended);
        titleEl.textContent = p.name; $('[data-approach]').textContent = p.approach || '';
        $('[data-role]').textContent = p.role || '';
        $('[data-services]').textContent = (p.services || []).join(', ');
        $('[data-stack]').textContent = (p.stack || []).join(', ');
        const live = $('[data-live]'); if (p.url) { live.href = p.url; live.style.display = ''; live.style.setProperty('--acc', p.accent); } else live.style.display = 'none';
        const nx = projOf(nextOf(p.slug, 1));
        $('[data-next-name]').textContent = nx.name; $('[data-next]').dataset.slug = nx.slug;
      };
      const openCase = (slug, { push = true } = {}) => { const p = projOf(slug); if (!p) return;
        if (!entered) { entered = true; body.classList.add('entered'); }
        fill(p); setProj(slug); caseEl.scrollTop = 0; lastCase = slug;
        if (!inCase) startTween(1.25);
        inCase = true; body.classList.add('in-case'); syncInert();
        document.title = 'blopa — ' + p.name; if (push) pushHash(slug);
        // el foco va al título cuando el case ya es visible (reintenta mientras dura la transición)
        let tries = 0; const focusTitle = () => { if (!inCase) return; titleEl.focus({ preventScroll: true });
          if (document.activeElement !== titleEl && tries++ < 12) setTimeout(focusTitle, 120); };
        setTimeout(focusTitle, 760);
        invalidate(); };
      const switchCase = (slug) => { infoEl.classList.add('swap');
        setTimeout(() => { openCase(slug); infoEl.classList.remove('swap'); }, 240); };
      const closeCase = (push = true) => { if (!inCase) return;
        inCase = false; startTween(1.05); body.classList.add('from-case'); body.classList.remove('in-case'); syncInert();
        clearTimeout(fromT); fromT = setTimeout(() => body.classList.remove('from-case'), 1600);
        if (!coarse) setProj(null);
        document.title = 'blopa'; if (push) pushHash('proyectos');
        // el foco vuelve a la fila sólo si se cerró con teclado (con mouse/táctil no aparece un anillo de foco)
        const row = rows.find((r) => r.dataset.slug === lastCase); if (row && lastKey) setTimeout(() => row.focus({ preventScroll: true }), 60);
        invalidate(); };
      const goHome = (push = true) => { inCase = false; entered = false; startTween(1.0);
        body.classList.remove('in-case', 'entered'); setProj(null); syncInert();
        document.title = 'blopa'; if (push) pushHash(''); invalidate(); };

      let leaveT = 0, fromT = 0;
      rows.forEach((row) => {
        const on = () => { clearTimeout(leaveT); if (!inCase) { const was = cur; setProj(row.dataset.slug); if (was !== cur) aimRow(row.dataset.slug); } };
        const off = () => { clearTimeout(leaveT); leaveT = setTimeout(() => { if (!inCase && !coarse) setProj(null); }, 140); };
        if (!coarse) { row.addEventListener('pointerenter', on); row.addEventListener('pointerleave', off); }
        row.addEventListener('focus', on); row.addEventListener('blur', off);
        row.addEventListener('click', () => { if (!suppressClick) openCase(row.dataset.slug); });
      });
      backEl.addEventListener('click', () => closeCase());
      $('[data-home]').addEventListener('click', () => goHome());
      $('[data-next]').addEventListener('click', (e) => { const nx = e.currentTarget.dataset.slug; if (nx) switchCase(nx); });
      // ←/→ (y ↑/↓) recorren el índice
      indexEl.addEventListener('keydown', (e) => { const i = rows.indexOf(document.activeElement); if (i < 0) return;
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); rows[(i + d + rows.length) % rows.length].focus(); } });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && inCase) { closeCase(); return; }
        if (inCase && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) { e.preventDefault(); switchCase(nextOf(cur, e.key === 'ArrowRight' ? 1 : -1)); }
      });

      addEventListener('popstate', () => { const h = location.hash.replace('#', '');
        if (projOf(h)) openCase(h, { push: false });
        else if (h === 'proyectos') { if (inCase) closeCase(false); else enter(false); }
        else goHome(false); });
      syncInert();
      caseEl.addEventListener('scroll', () => invalidate(), { passive: true });

      // ── manipulación directa: arrastrar gira la gema (desvía el haz); en índice/case es un DIAL entre proyectos:
      //    el desenfoque/RGB crece con la distancia al encastre y al soltar encaja y enfoca ──
      const drag = { on: false, x0: 0, y0: 0, dx: 0, dy: 0, moved: false, id: -1 };
      const dragOff = { x: 0, y: 0 };
      addEventListener('pointerdown', (e) => {
        if (body.classList.contains('no-gl') || e.button > 0) return;
        if (e.target.closest('a,button:not(.prow):not(.enter),.kase__info,.nav')) return;
        Object.assign(drag, { on: true, x0: e.clientX, y0: e.clientY, dx: 0, dy: 0, moved: false, id: e.pointerId, pt: e.pointerType });
      });
      addEventListener('pointermove', (e) => { if (!drag.on || e.pointerId !== drag.id) return;
        drag.dx = (e.clientX - drag.x0) / innerWidth; drag.dy = (e.clientY - drag.y0) / innerHeight;
        if (!drag.moved && Math.hypot(drag.dx * innerWidth, drag.dy * innerHeight) > 8) { drag.moved = true; body.classList.add('dragging'); }
        invalidate(); });
      const endDrag = (e) => { if (!drag.on || (e && e.pointerId !== drag.id)) return;
        drag.on = false; body.classList.remove('dragging');
        if (drag.moved) { suppressClick = true; setTimeout(() => { suppressClick = false; }, 60);
          const vert = Math.abs(drag.dy) > Math.abs(drag.dx);
          if (!entered && vert && drag.dy < -0.06) enter();                       // swipe hacia arriba en la entrada: entra
          else if (!entered && !vert && drag.pt === 'touch' && Math.abs(drag.dx) > 0.12) enter();   // swipe lateral (táctil) también
          else if (entered && !vert && Math.abs(drag.dx) > 0.12) {                  // dial: pasa de proyecto y encaja
            const nx = cur ? nextOf(cur, drag.dx < 0 ? 1 : -1) : projects[drag.dx < 0 ? 0 : projects.length - 1].slug;
            if (inCase) switchCase(nx); else setProj(nx); } }
        drag.dx = 0; drag.dy = 0; invalidate(); };
      addEventListener('pointerup', endDrag); addEventListener('pointercancel', endDrag);

      let lastInput = performance.now(), lastKey = false;
      addEventListener('keydown', () => { lastKey = true; }, true); addEventListener('pointerdown', () => { lastKey = false; }, true);
      // el rayo de salida APUNTA un instante a algo (un nombre del índice, la zona del índice en la invitación)
      const aim = { t0: -1e9, x: 0, y: 0, hold: 0.35 };
      const aimAt = (x, y, hold = 0.35) => { aim.t0 = performance.now(); aim.x = x; aim.y = y; aim.hold = hold; invalidate(2400); };
      const aimRow = (slug) => { const r = rows.find((x) => x.dataset.slug === slug); if (!r) return;
        const b = r.querySelector('.prow__name').getBoundingClientRect(); aimAt(b.left + b.width * 0.5, b.top + b.height * 0.5); };
      const aimEnv = (now) => { const x = (now - aim.t0) / 1000, sm = (u) => u * u * (3 - 2 * u);
        if (x < 0) return 0; if (x < 0.25) return sm(x / 0.25); if (x < 0.25 + aim.hold) return 1;
        const y = (x - 0.25 - aim.hold) / 0.9; return y >= 1 ? 0 : 1 - sm(y); };

      ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) => addEventListener(ev, () => { lastInput = performance.now(); }, { passive: true }));
      // giroscopio (mobile): inclinar el teléfono gira la piedra
      const gyro = { x: 0, y: 0 };
      if (coarse && 'DeviceOrientationEvent' in window && !reduceMotion) {
        const onOri = (e) => { if (e.gamma == null) return; gyro.x = clamp(e.gamma / 35, -1, 1); gyro.y = clamp((e.beta - 50) / 35, -1, 1); };
        if (typeof DeviceOrientationEvent.requestPermission === 'function')
          addEventListener('touchend', () => DeviceOrientationEvent.requestPermission().then((s) => { if (s === 'granted') addEventListener('deviceorientation', onOri); }).catch(() => {}), { once: true });
        else addEventListener('deviceorientation', onOri);
      }

      // ganchos para pruebas automáticas (no cambian nada por sí solos)
      window.__prisma = { enter, openCase, closeCase, setProj, goHome, T0 };

      // ═══════════════ GL: UN contexto, sala + prefiltro de bokeh + gema ═══════════════
      const roomC = $('[data-room]');
      let gl = roomC.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'high-performance' });
      if (!gl) { body.classList.add('no-gl'); navEl.inert = false; enterEl.inert = true; }
      // ── calidad: GPU integrada vieja / por software arranca en BAJA (menos pasos y rebotes en la gema, bokeh de 8
      //    muestras, menos píxeles). Si igual no llega a ~35 fps, el loop baja a BAJA solo (ver frame()) ──
      const weakGPU = (() => { if (!gl) return false;
        let r = ''; try { const e = gl.getExtension('WEBGL_debug_renderer_info'); r = String(gl.getParameter(e ? e.UNMASKED_RENDERER_WEBGL : gl.RENDERER) || ''); } catch {}
        if (/swiftshader|llvmpipe|softpipe|software|basic render/i.test(r)) return true;
        if (/intel/i.test(r) && !/iris\(r\) xe|iris xe|arc/i.test(r)) return true;
        if (/mali-[gt]?[0-7]\d\b|adreno[^\d]{0,12}[3-5]\d\d|powervr|geforce (gt |mx|[2-9]\d\d\b)|radeon(\(tm\))? (r[2-7]|hd)/i.test(r)) return true;
        return (navigator.hardwareConcurrency || 8) <= 4 && !/apple/i.test(r); })();
      const QHI = { steps: coarse ? 72 : 110, gin: coarse ? 26 : 42, gb: coarse ? 2 : 3, aa: 4, bok: 16, px: 2.6e6, dpr: 2, floor: 0.62 };
      const QLO = { steps: 48, gin: 16, gb: 2, aa: 2, bok: 8, px: 1.15e6, dpr: 1.25, floor: 0.5 };
      const qParam = new URLSearchParams(location.search).get('q');   // ?q=bajo / ?q=alto fuerzan el perfil (para comparar)
      let Q = qParam === 'bajo' ? QLO : qParam === 'alto' ? QHI : weakGPU ? QLO : QHI;
      const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';

      // prefiltro: la diapositiva a MEDIA resolución, con downsample 2×2 y clamp suave de altas luces
      // (el bokeh muestrea esto: barato y sin puntos sobrebrillados)
      const PRE = `precision mediump float;
        uniform sampler2D uVid; uniform vec2 uRes; uniform vec2 uTexel;
        void main(){ vec2 uv=gl_FragCoord.xy/uRes;
          vec3 c=(texture2D(uVid,uv+uTexel*vec2(-.5,-.5)).rgb+texture2D(uVid,uv+uTexel*vec2(.5,-.5)).rgb
                 +texture2D(uVid,uv+uTexel*vec2(-.5,.5)).rgb+texture2D(uVid,uv+uTexel*vec2(.5,.5)).rgb)*.25;
          float l=max(c.r,max(c.g,c.b)); c*=1./(1.+max(l-.78,0.)*1.6);
          gl_FragColor=vec4(c,1.); }`;

      const ROOM = () => `precision highp float;
        uniform vec2 uRes; uniform float uDpr; uniform float uTime;
        uniform vec2 uG; uniform float uGR; uniform vec2 uB0; uniform vec2 uEn;   // gema, origen del haz, punto de ENTRADA real
        uniform vec4 uS;                                          // pantalla (x0,y0,x1,y1) px CSS, y hacia abajo
        uniform vec2 uAx; uniform vec2 uFan;                      // eje del abanico de proyección y límites angulares
        uniform float uScrAmt, uVidAmt, uDefocus, uBeamK, uFanK, uDisp, uOpen, uLightA, uScrim, uLand;
        uniform vec2 uEx; uniform vec2 uDR; uniform vec2 uDC; uniform float uRayA; uniform float uDuo;   // salida real: punto + direcciones R / cian
        uniform vec2 uSP[4]; uniform vec2 uSD[4]; uniform float uSW[4]; uniform vec3 uSCol[4];   // salidas secundarias (chispas)
        uniform vec3 uCph; uniform vec2 uLp; uniform vec3 uHit; uniform float uExpo;          // cáusticas (fase = giro de la gema) · impacto en pantalla
        uniform vec2 uCov;                                        // recorte "cover" de la diapositiva (anclado ARRIBA: el home del sitio)
        uniform float uScrimP, uScrollK, uCropT;   // uCropT: recorte superior (p. ej. el selector de idiomas suelto)                          // case mobile: scrim inferior + oscurecer al scrollear
        uniform vec3 uAvg; uniform vec3 uTint; uniform float uTintAmt;
        uniform sampler2D uVid; uniform sampler2D uBok;
        float h21(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
        float vn(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
          return mix(mix(h21(i),h21(i+vec2(1,0)),f.x), mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x), f.y); }
        float fbm(vec2 p){ float s=0., a=.5; for(int i=0;i<4;i++){ s+=a*vn(p); p=p*2.03+17.1; a*=.5; } return s; }
        vec3 bump(vec3 x){ return max(1.-x*x,0.); }
        vec3 spectral(float x){ return max(bump(vec3(3.54541723,2.86670055,2.29421995)*(x-vec3(0.69548916,0.49416934,0.28269708)))
          - vec3(0.02320775,0.15936245,0.53520021), 0.); }
        /* cáustica: red de interferencia afilada; su fase la mueve el GIRO de la gema */
        float caus(vec2 q, vec3 ph){ float a=sin(q.x*0.9+ph.x)+sin(q.y*1.1+ph.y)+sin((q.x+q.y)*0.7+ph.z)+sin((q.x-q.y)*1.3-ph.x*1.3);
          return pow(1.-abs(a*0.25),9.); }
        vec3 aces(vec3 x){ return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.,1.); }
        float fanM(float a, float soft){ return smoothstep(uFan.x-soft,uFan.x+soft,a)*(1.-smoothstep(uFan.y-soft,uFan.y+soft,a)); }
        vec3 tx(vec2 uv){ return texture2D(uVid, vec2(uv.x,1.-uv.y)).rgb; }
        vec3 bk(vec2 uv){ return texture2D(uBok, vec2(uv.x,1.-uv.y)).rgb; }
        /* rayo fino desde o en dirección d: núcleo + halo que se abre con la distancia */
        float rayL(vec2 p, vec2 o, vec2 d, float dust, out float tt){ vec2 v=p-o; tt=dot(v,d); float pr=abs(d.x*v.y-d.y*v.x);
          float w=1.0+max(tt,0.)*0.011; float on=smoothstep(0.,6.,tt);
          return on*(exp(-pr*pr/(w*w)) + 0.10*dust*exp(-pr/(5.+max(tt,0.)*0.045)))/(1.+max(tt,0.)/650.); }
        void main(){
          vec2 css=uRes/uDpr;
          vec2 p=vec2(gl_FragCoord.x, uRes.y-gl_FragCoord.y)/uDpr;
          float t=uTime;
          vec3 L=vec3(0.);
          /* aire de la sala: polvo en suspensión (sólo se ve donde hay luz) + motas que derivan */
          float dust=fbm(p*0.0065+vec2(t*0.022,-t*0.011)); dust=0.30+1.9*dust*dust;
          vec2 cg=floor(p/8.), fp=fract(p/8.); float hs=h21(cg);
          vec2 mp=vec2(h21(cg+3.1),h21(cg+7.7))*.7+.15+0.12*vec2(sin(t*.5+hs*20.),cos(t*.4+hs*13.));
          float mote=step(0.972,hs)*smoothstep(0.11,0.0,length(fp-mp))*(0.55+0.45*sin(t*1.3+hs*40.));
          vec3 beamC=vec3(1.0,0.975,0.94);
          /* ① haz entrante hasta el punto de ENTRADA real; HDR: la entrada "quema" (ACES + bloom analítico) */
