---
// HOME — la gema es la ENTRADA; al hacer click se corre y aparecen los proyectos
// (nombres a la izquierda, gema ambiente a la derecha). Click en un nombre abre el case.
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>blopa</title>
    <meta name="description" content="blopa — creative developer. Portfolio de Pablo Vela: sitios con firma visual propia, desde Buenos Aires." />
    <meta property="og:title" content="blopa" />
    <meta property="og:description" content="Creative developer — portfolio de Pablo Vela." />
    <meta property="og:image" content="https://www.blopavela.com/img/og.jpg" />
    <meta property="og:url" content="https://www.blopavela.com/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://www.blopavela.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-500.woff2') format('woff2'); font-weight:500; font-display:swap; }
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --soft:#7b7d86; --dim:#4b4d55; --hair:#22222a;
        --aqua:#24e2e8; --red:#ff3a54;
        --display:'Bebas Neue',sans-serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.3rem,4vw,4rem); }
      *{box-sizing:border-box;margin:0}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);min-height:100svh;overflow-x:hidden;
        -webkit-font-smoothing:antialiased;line-height:1.5}
      a{color:inherit;text-decoration:none}
      canvas.shard{position:fixed;inset:0;z-index:1;pointer-events:none}

      /* nav: sólo aparece dentro (proyectos/case); la ENTRADA queda limpia, sólo la gema */
      .nav{position:fixed;top:0;left:0;right:0;z-index:8;display:flex;justify-content:space-between;align-items:baseline;
        padding:var(--gut);font-family:var(--mono);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--soft);
        opacity:0;pointer-events:none;transition:opacity .5s var(--ease)}
      body.entered .nav{opacity:1;pointer-events:auto;transition-delay:.3s}
      .nav__home{appearance:none;background:none;border:0;font:inherit;letter-spacing:.16em;text-transform:uppercase;
        color:var(--soft);cursor:pointer;transition:color .25s var(--ease);
        text-shadow:-.7px 0 rgba(255,58,84,.5),.7px 0 rgba(36,226,232,.5)}   /* colores de la gema a través del mark */
      .nav__home:hover{color:var(--ink)}
      .nav__contact{text-transform:none;letter-spacing:.02em;color:var(--soft);white-space:nowrap;transition:color .25s var(--ease)}
      .nav__contact span{color:var(--dim)}
      .nav__contact:hover{color:var(--ink)} .nav__contact:hover span{color:var(--soft)}
      @media(max-width:640px){ .nav__contact span{display:none} }

      /* identidad verbal mínima (no es bio): una línea de posicionamiento que vive en el índice */
      .sig{position:fixed;left:var(--gut);bottom:var(--gut);z-index:8;font-family:var(--mono);
        font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--dim);
        opacity:0;pointer-events:none;transition:opacity .5s var(--ease)}
      body.entered .sig{opacity:1;transition-delay:.45s}
      body.in-case .sig{opacity:0;transition-delay:0s}

      /* landing: sólo el disparador; la gema es todo */
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer}
      body.entered .enter{pointer-events:none}

      /* la gema es la ENTRADA y permanece: al entrar se corre a la derecha y deja los nombres a la izquierda */
      canvas.shard{transition:opacity .8s var(--ease)}

      /* índice: nombres alineados a la izquierda; la gema queda a la derecha (ambiente) */
      .index{position:fixed;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:center;
        gap:.2rem;padding:clamp(5rem,12vh,9rem) var(--gut) 4rem;max-width:min(46vw,40rem);
        opacity:0;pointer-events:none;transition:opacity .7s var(--ease)}
      body.entered .index{opacity:1;pointer-events:auto;transition-delay:.3s}
      body.in-case .index{opacity:0;pointer-events:none;transition-delay:0s}
      .prow{appearance:none;background:none;border:0;cursor:pointer;text-align:left;
        display:flex;align-items:baseline;flex-wrap:wrap;gap:.3rem 1rem;padding:.55rem 0;position:relative;isolation:isolate;
        transition:padding .35s var(--ease)}
      .prow:hover{padding-left:1rem}
      /* jerarquía: el contenido primario descansa en ink; la aberración cromática es un EVENTO
         (hover/focus), no el estado de reposo — y los hermanos se apagan al elegir uno */
      .prow__name{font-family:var(--display);font-weight:400;font-size:clamp(2.6rem,5.4vw,4.4rem);
        letter-spacing:.01em;line-height:1.0;color:var(--ink);white-space:nowrap;
        transition:color .35s var(--ease),text-shadow .35s var(--ease)}
      .index:hover .prow:not(:hover) .prow__name{color:var(--soft)}
      .prow:hover .prow__name,.prow:focus-visible .prow__name{color:var(--ink);
        text-shadow:-2px 0 var(--red),2px 0 var(--aqua)}
      .prow:focus-visible{outline:none}
      .prow__num{font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;color:var(--dim);
        min-width:1.9em;transition:color .35s var(--ease)}
      .prow:hover .prow__num{color:var(--soft)}
      .prow__meta{font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;
        color:var(--dim);white-space:nowrap;transition:color .35s var(--ease)}
      .prow:hover .prow__meta{color:var(--soft)}
      .prow__arrow{opacity:0;color:var(--c);transform:translateX(-6px);
        transition:opacity .3s var(--ease),transform .3s var(--ease)}
      .prow:hover .prow__arrow{opacity:1;transform:translateX(0)}
      /* portrait: la gema queda arriba (mismo criterio W<H del render); los nombres se centran
         en la banda libre bajo la gema — --gemclear lo calcula el JS con la posición/escala reales */
      @media(orientation:portrait){
        /* la meta baja a una 2ª línea alineada con el nombre (a la derecha no entra) */
        .prow__meta{flex-basis:100%;margin-left:2.2rem}
        .index{max-width:none;justify-content:center;
          padding-top:calc(var(--gemclear,46svh) + .6rem);
          padding-bottom:clamp(3rem,7vh,4.5rem)}   /* despeja la línea .sig del pie */
      }

      /* case como UNA composición: info + stack + collage, centrado, tras el estallido */
      .kase{position:fixed;inset:0;z-index:6;display:grid;place-items:center;padding:clamp(4rem,10vh,7rem) var(--gut) clamp(3.5rem,9vh,6rem);
        opacity:0;visibility:hidden;pointer-events:none;transition:opacity .5s var(--ease),visibility .5s var(--ease)}
      body.in-case .kase{opacity:1;visibility:visible;pointer-events:auto;transition-delay:.82s}
      body.in-case .index{opacity:0;pointer-events:none}   /* al abrir, los nombres se van */

      .kase__board{width:min(95vw,84rem);display:grid;grid-template-columns:minmax(0,20rem) 1fr;
        gap:clamp(1.5rem,3vw,3.5rem);align-items:center}

      /* la nav (marca + contacto) queda visible también en el case; el volver va debajo de la marca */
      .kase__back{position:fixed;left:var(--gut);top:calc(var(--gut) + 2.4rem);z-index:9;appearance:none;cursor:pointer;
        display:inline-flex;align-items:center;gap:.55rem;padding:.6rem 1rem .6rem .8rem;border-radius:999px;
        border:1px solid var(--hair);background:rgba(12,12,16,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
        font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);
        transition:color .25s var(--ease),border-color .25s var(--ease),background .25s var(--ease)}
      .kase__back svg{width:.9em;height:.9em;stroke:currentColor;fill:none;stroke-width:2}
      .kase__back:hover{color:var(--ink);border-color:var(--soft);background:rgba(20,20,26,.7)}

      .kase__info{min-width:0}
      .case__eye{font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--soft)}
      /* entrar a un proyecto tiene que sentirse MÁS grande que la lista, no igual */
      .case__title{font-family:var(--display);font-weight:400;font-size:clamp(3.2rem,6vw,5.5rem);line-height:.9;
        letter-spacing:.01em;margin:.4rem 0 0;text-shadow:-1.5px 0 var(--red),1.5px 0 var(--aqua)}
      .case__role{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;
        color:var(--soft);margin-top:.7rem}
      .case__approach{margin-top:1rem;color:#c9cbd2;line-height:1.5;font-size:.92rem;max-width:38ch}
      .kase__slabel{font-family:var(--mono);font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);
        margin:1.6rem 0 .6rem;display:flex;align-items:center;gap:.7rem}
      .kase__slabel::after{content:"";flex:1;height:1px;background:var(--hair)}
      /* jerarquía real: servicios (lo que hiciste) = chips presentes; stack (con qué) = una línea mono terciaria */
      .kase__stack{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem;margin:0;padding:0}
      :global(.kase__stack li){font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);
        border:1px solid #2e2e38;border-radius:6px;padding:.42rem .7rem;white-space:nowrap;
        background:rgba(255,255,255,.02);transition:border-color .25s var(--ease),color .25s var(--ease)}
      :global(.kase__stack li:hover){border-color:var(--soft)}
      .kase__stackline{font-family:var(--mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;
        color:var(--dim);margin:0}
      .case__live{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.5rem;font-family:var(--mono);font-size:.7rem;
        letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border:1px solid rgba(242,243,245,.26);border-radius:999px;
        padding:.7rem 1.2rem;transition:border-color .3s var(--ease)}
      .case__live span{color:var(--aqua)} .case__live:hover{border-color:var(--aqua)}

      /* collage grande: 3 capturas con profundidad real (translateZ) + parallax */
      .kase__collage{position:relative;width:min(100%,56rem);aspect-ratio:16/11;justify-self:center;perspective:1700px}
      .kase__stage{position:absolute;inset:0;transform-style:preserve-3d;
        transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .2s ease-out;will-change:transform}
      /* paneles dinámicos (N): posición/transform inline desde JS. Estilos :global porque se crean por JS */
      :global(.kase__pane){position:absolute;width:46%;aspect-ratio:16/10;overflow:hidden;border-radius:7px;border:1px solid var(--hair);
        background:#0a0a0c;box-shadow:0 40px 90px rgba(0,0,0,.6);opacity:0;
        transition:transform .85s var(--ease),opacity .55s var(--ease);will-change:transform,opacity}
      :global(.kase__pane.show){opacity:1}
      :global(.kase__pane::after){content:"";position:absolute;inset:0;pointer-events:none;border-radius:7px;
        box-shadow:inset 1.6px 0 0 rgba(255,58,84,.45),inset -1.6px 0 0 rgba(36,226,232,.45)}
      :global(.kase__pane img){width:100%;height:100%;object-fit:cover;display:block}
      @media(max-width:860px){
        .kase{place-items:start center}
        .kase__board{grid-template-columns:1fr;gap:1.5rem}
        .kase__collage{order:-1;width:min(86vw,24rem)}
      }

      @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
    </style>
  </head>
  <body>
    <canvas class="shard" data-shard aria-hidden="true"></canvas>
    <div class="enter" data-enter role="button" tabindex="0" aria-label="Entrar"></div>

    <nav class="nav" aria-label="Navegación">
      <button type="button" class="nav__home" data-home>blopa</button>
      <a class="nav__contact" href="mailto:blopave@pm.me">Pablo Vela <span aria-hidden="true">· blopave@pm.me ↗</span></a>
    </nav>
    <p class="sig">Creative developer — Buenos Aires</p>

    <section class="index" data-index>
      {projects.map((p, i) => (
        <button type="button" class="prow" data-row data-slug={p.slug} style={`--c:${p.accent}`}>
          <span class="prow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="prow__name">{p.name}</span>
          <span class="prow__meta">{p.category} · {p.ended ? p.ended.split('-')[0] : 'En curso'}</span>
          <span class="prow__arrow" aria-hidden="true">→</span>
        </button>
      ))}
    </section>

    <section class="kase" data-case aria-hidden="true">
      <div class="kase__board">
        <div class="kase__info">
          <p class="case__eye" data-cat></p>
          <h2 class="case__title" data-name></h2>
          <p class="case__role" data-role></p>
          <p class="case__approach" data-approach></p>
          <p class="kase__slabel">Servicios</p>
          <ul class="kase__stack" data-services></ul>
          <p class="kase__slabel">Stack</p>
          <p class="kase__stackline" data-stack></p>
          <a class="case__live" data-live target="_blank" rel="noopener">Ver en vivo <span aria-hidden="true">↗</span></a>
        </div>
        <div class="kase__collage" data-collage>
          <div class="kase__stage" data-stage></div>
        </div>
      </div>
      <button type="button" class="kase__back" data-back aria-label="Volver a proyectos">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Proyectos
      </button>
    </section>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const DPR = Math.min(coarse ? 1.4 : 2, window.devicePixelRatio || 1);

      // ── entrada / galería / case ──
      // balance del índice en portrait: los nombres se centran en la banda libre bajo la gema.
      // MOB_SC / MOB_CY son la escala y altura de la gema en el índice mobile (las usa también el render).
      const MOB_SC = 2.1, MOB_CY = 0.28;
      const indexEl = document.querySelector('[data-index]');
      const balanceIndex = () => {
        const W = innerWidth, H = innerHeight;
        if (W >= H) { indexEl.style.removeProperty('--gemclear'); return; }
        const fit = 0.6 + 0.7 * (H / W);
        const gemBottom = (0.5 - MOB_CY + 1 / (MOB_SC * fit)) * H;   // borde inferior de la gema, en px
        indexEl.style.setProperty('--gemclear', Math.round(gemBottom) + 'px');
      };
      balanceIndex(); addEventListener('resize', balanceIndex);

      let entered = false;
      let bootT0 = performance.now();   // carga: la gema se ARMA (el quiebre del case, invertido)
      const enter = () => { if (entered) return; entered = true; body.classList.add('entered'); };
      const enterEl = document.querySelector('[data-enter]');
      enterEl.addEventListener('click', enter);
      enterEl.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enter(); } });
      addEventListener('wheel', (e) => { if (!entered && e.deltaY > 6) enter(); }, { passive: true });

      // case en el mismo lugar: la gema se rompe → ficha (izq) + collage (der)
      let inCase = false, caseT0 = 0;
      const caseEl = document.querySelector('[data-case]');
      const catEl = caseEl.querySelector('[data-cat]'), nameEl = caseEl.querySelector('[data-name]'),
        approachEl = caseEl.querySelector('[data-approach]'), servicesEl = caseEl.querySelector('[data-services]'),
        liveEl = caseEl.querySelector('[data-live]'), stageEl = caseEl.querySelector('[data-stage]'),
        stackEl = caseEl.querySelector('[data-stack]'), roleEl = caseEl.querySelector('[data-role]');
      // arreglo liderado por la 1ª captura: hero grande al frente, el resto se abre hacia atrás
      const fanLayout = (n) => Array.from({ length: n }, (_, i) => {
        const t = n > 1 ? i / (n - 1) : 0;          // 0 = hero, 1 = la más atrás
        return { l: 56 - t * 32, top: 60 - t * 34, rot: (i % 2 ? 1 : -1) * (2 + (i % 3) * 1.3),
          z: -i * 62, s: 1.02 - i * 0.06, zi: n - i };
      });
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      const openCase = (slug) => {
        const p = projects.find((x) => x.slug === slug); if (!p) return;
        catEl.textContent = p.category + ' · ' + yearOf(p.ended);
        nameEl.textContent = p.name; roleEl.textContent = p.role || ''; approachEl.textContent = p.approach || '';
        servicesEl.innerHTML = (p.services || []).map((s) => '<li>' + s + '</li>').join('');
        stackEl.textContent = (p.stack || []).join(' · ');
        if (p.url) { liveEl.href = p.url; liveEl.style.display = ''; } else { liveEl.style.display = 'none'; }
        // collage dinámico: un panel por captura (p.shots), en cascada con profundidad
        const shots = p.shots || []; const lay = fanLayout(shots.length);
        stageEl.innerHTML = '';
        shots.forEach((url, i) => {
          const pane = document.createElement('div'); pane.className = 'kase__pane';
          const c = lay[i]; pane.style.left = c.l + '%'; pane.style.top = c.top + '%'; pane.style.zIndex = String(c.zi);
          pane.dataset.tf = 'translate(-50%,-50%) translateZ(' + c.z.toFixed(0) + 'px) rotate(' + c.rot.toFixed(1) + 'deg) scale(' + c.s.toFixed(2) + ')';
          pane.style.transform = 'translate(-50%,-50%) scale(.4)';   // colapsado (emerge del centro)
          const im = document.createElement('img'); im.src = url; im.alt = p.name + ' — ' + (i + 1); im.loading = 'lazy';
          pane.appendChild(im); stageEl.appendChild(pane);
        });
        // emerger escalonado (después del hold del estallido)
        requestAnimationFrame(() => requestAnimationFrame(() => {
          stageEl.querySelectorAll('.kase__pane').forEach((pane, i) => {
            pane.style.transitionDelay = (0.92 + i * 0.09).toFixed(2) + 's';
            pane.style.transform = pane.dataset.tf; pane.classList.add('show');
          });
        }));
        caseT0 = performance.now(); inCase = true; body.classList.add('in-case'); caseEl.setAttribute('aria-hidden', 'false');
      };
      const closeCase = () => { inCase = false; body.classList.remove('in-case'); caseEl.setAttribute('aria-hidden', 'true'); };
      // parallax del collage: inclina el stage; con la profundidad (translateZ) los paneles se separan en 3D
      addEventListener('pointermove', (e) => { if (!inCase) return;
        const rx = (0.5 - e.clientY / innerHeight) * 15, ry = (e.clientX / innerWidth - 0.5) * 22;
        stageEl.style.setProperty('--rx', rx.toFixed(2) + 'deg'); stageEl.style.setProperty('--ry', ry.toFixed(2) + 'deg');
      });
      // índice: nombres a la izquierda; la gema queda a la derecha (ambiente). click → case
      document.querySelectorAll('[data-row]').forEach((row) => {
        row.addEventListener('click', () => openCase(row.dataset.slug));
      });
      document.querySelector('[data-back]').addEventListener('click', closeCase);
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && body.classList.contains('in-case')) closeCase(); });
      // home: vuelve a la entrada (cierra el case y rearma la gema)
      const goHome = () => { inCase = false; entered = false; body.classList.remove('in-case'); body.classList.remove('entered'); caseEl.setAttribute('aria-hidden', 'true');
        bootT0 = performance.now(); };   // volver al home rearma la gema (mismo idioma que la carga)
      document.querySelector('[data-home]').addEventListener('click', goHome);

      // ── cristal (entrada): icosaedro de hielo con "blopa", idle + parallax; al entrar se achica arriba ──
      const shard = document.querySelector('[data-shard]');
      const gl = shard.getContext('webgl', { alpha: true, premultipliedAlpha: false, antialias: true, powerPreference: 'low-power' });
      if (gl) {
        const STEPS = coarse ? 72 : 110, INSTEPS = coarse ? 26 : 42;
        const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
        const FRAG = `precision highp float;
          uniform vec2 uRes; uniform vec2 uCenter; uniform float uScale; uniform mat3 uRot; uniform float uAber;
          uniform sampler2D uWord; uniform float uWordAmt; uniform float uTime; uniform float uBreak;
          #define PHI 1.61803398875
          float smax(float a,float b,float k){ float h=clamp(0.5+0.5*(a-b)/k,0.,1.); return mix(b,a,h)+k*h*(1.0-h); }
          float sdIco(vec3 p){ p=abs(p); float k=0.072;
            float d=dot(p,normalize(vec3(1.,1.,1.)));
            d=smax(d,dot(p,normalize(vec3(0.,1.,PHI+1.))),k);
            d=smax(d,dot(p,normalize(vec3(PHI+1.,0.,1.))),k);
            d=smax(d,dot(p,normalize(vec3(1.,PHI+1.,0.))),k);
            return d-1.0; }
          // fractura: al romperse, la superficie se agrieta con celdas de alta frecuencia que laten
          float fracture(vec3 p){ return sin(9.0*p.x+uTime*5.0)*sin(9.0*p.y-uTime*3.0)*sin(9.0*p.z+uTime*2.0); }
          float sdC(vec3 p){ float d=sdIco(p) - (0.008 + 0.008*sin(uTime*0.7));
            d += uBreak*(0.30*fracture(p) + 0.15*fracture(p*2.3)); return d; }
          vec3 nrm(vec3 p){ vec2 e=vec2(0.006,0.);
            return normalize(vec3(sdC(p+e.xyy)-sdC(p-e.xyy),sdC(p+e.yxy)-sdC(p-e.yxy),sdC(p+e.yyx)-sdC(p-e.yyx))); }
          // normal "gruesa": donde diverge de la fina hay una arista → línea de facetado
          vec3 nrmC(vec3 p){ vec2 e=vec2(0.05,0.);
            return normalize(vec3(sdC(p+e.xyy)-sdC(p-e.xyy),sdC(p+e.yxy)-sdC(p-e.yxy),sdC(p+e.yyx)-sdC(p-e.yyx))); }
          vec3 env(vec3 d){
            float ea=uTime*0.06; float ec=cos(ea), es=sin(ea); d.xz=mat2(ec,-es,es,ec)*d.xz;
            vec3 c=vec3(0.040,0.043,0.055);
            c+=mix(vec3(0.020,0.024,0.036),vec3(0.125,0.15,0.20),clamp(d.y*0.6+0.5,0.,1.));
            c+=vec3(0.70,0.84,0.98)*pow(max(0.,dot(d,normalize(vec3(-0.55,0.35,0.75)))),7.0)*0.60;
            c+=vec3(0.90,0.94,1.0)*pow(max(0.,dot(d,normalize(vec3(0.1,0.85,-0.2)))),15.0)*0.52;
            c+=vec3(1.0)*pow(max(0.,dot(d,normalize(vec3(0.5,0.62,0.4)))),22.0)*0.45;
            c+=vec3(0.05,0.85,1.0)*pow(max(0.,dot(d,normalize(vec3(-0.55,0.35,0.75)))),6.0)*uAber*1.8;
            c+=vec3(1.0,0.20,0.32)*pow(max(0.,dot(d,normalize(vec3(0.65,-0.25,0.6)))),6.0)*uAber*1.8;
            return c; }
          vec4 shade(vec2 frag, out float ef){ ef=0.;
            vec2 uv=(frag-0.5*uRes)/uRes.y; uv=(uv-uCenter)*uScale;
            vec3 ro=vec3(0.,0.,3.0); vec3 rd=normalize(vec3(uv,-1.75));
            float t=0.; float hit=-1.; float md=1e9;
            for(int i=0;i<${STEPS};i++){ vec3 q=uRot*(ro+rd*t); float d=sdC(q); md=min(md,d);
              if(d<0.0008+0.0007*t){hit=t;break;} t+=d*0.8; if(t>7.)break; }
            float bf=(1.0-smoothstep(0.35,0.9,uBreak));   // se apaga al romperse (sin fantasma)
            if(hit<0.){
              ef=step(md,0.02);
              float e=smoothstep(0.012,0.0,md); float glow=smoothstep(0.20,0.0,md);
              if(e<=0.001&&glow<=0.001){ return vec4(0.); }
              vec3 hc=mix(vec3(0.13,0.85,1.0),vec3(1.0,0.22,0.35),smoothstep(-0.08,0.08,uv.x));
              return vec4((hc*e*0.8+vec3(0.12,0.16,0.24)*glow*glow*0.5)*bf, max(e*0.8,glow*glow*0.32)*bf);
            }
            /* refina el impacto: estabiliza la normal en rayos rasantes (sin esto el borde "puntea") */
            for(int i=0;i<3;i++){ hit+=sdC(uRot*(ro+rd*hit))*0.8; }
            vec3 po=uRot*(ro+rd*hit); vec3 n=nrm(po); vec3 nw=n*uRot;
            float ci=clamp(dot(-rd,nw),0.,1.); float fres=0.04+0.96*pow(1.0-ci,4.0);
            ef=1.0-smoothstep(0.10,0.17,ci);   // sólo el rasante extremo (la silueta misma)
            float iorG=1.47; float disp=0.045+uAber*0.11; vec3 col;
            vec3 rin=refract(rd,nw,1.0/iorG);
            if(length(rin)<0.5){ col=env(reflect(rd,nw)); }
            else{
              vec3 rinObj=uRot*rin; float ti=0.02;
              for(int i=0;i<${INSTEPS};i++){ float d=sdC(po+rinObj*ti); if(d>0.)break; ti+=max(0.01,-d)*0.9; if(ti>6.)break; }
              vec3 pe=po+rinObj*ti; vec3 neW=(-nrm(pe))*uRot;
              vec3 oR=refract(rin,neW,iorG+disp),oG=refract(rin,neW,iorG),oB=refract(rin,neW,iorG-disp);
              if(length(oR)<0.5)oR=reflect(rin,neW); if(length(oG)<0.5)oG=reflect(rin,neW); if(length(oB)<0.5)oB=reflect(rin,neW);
              col=vec3(env(oR).r,env(oG).g,env(oB).b);
              col*=exp(-ti*vec3(0.55,0.42,0.28)*0.32)*1.15;
            }
            vec3 rfl=env(reflect(rd,nw)); col=mix(col,rfl,fres*0.7);
            /* curvatura (fina vs gruesa): alta en vértices y uniones de aristas */
            float dnn=1.0-dot(n,nrmC(po));
            /* rim en dos capas: halo suave + línea tensa; atenuado en vértices para que
               las uniones se fundan en vez de "pinchar" con un punto caliente */
            float rim=pow(1.0-ci,2.6), rimT=pow(1.0-ci,4.0);
            float vsoft=1.0-0.55*smoothstep(0.10,0.55,dnn);
            vec3 rimC=mix(vec3(0.13,0.85,1.0),vec3(1.0,0.22,0.35),smoothstep(-0.45,0.45,nw.x));
            col+=(rim*0.34+rimT*0.92)*(1.0+uAber*2.6)*rimC*vsoft;
            /* glint de aristas: línea fina de luz donde se quiebran las facetas
               (apagado en la silueta, donde la normal gruesa es inestable y puntea) */
            float eg=smoothstep(0.06,0.5,dnn)*smoothstep(0.0,0.25,ci);
            col+=eg*(0.33+uAber*0.7)*mix(rimC,vec3(0.9,0.95,1.0),0.6);
            if(uWordAmt>0.001){
              vec2 wuv=uv*vec2(1.0,2.7)+rin.xy*0.05+vec2(0.5,0.5);
              float so=0.005+uAber*0.012;
              float wr=texture2D(uWord,wuv+vec2(so,0.)).r, wg=texture2D(uWord,wuv).r, wb=texture2D(uWord,wuv-vec2(so,0.)).r;
              col+=uWordAmt*vec3(wr,wg,wb)*vec3(0.97,0.98,1.0);
            }
            float al=clamp(0.28+fres*0.8+max(col.r,max(col.g,col.b))*0.6,0.,1.);
            al*=bf;   // al romperse, la gema se apaga (mismo ritmo que el borde)
            return vec4(col,al);
          }
          void main(){
            /* AA adaptativo: sólo en la silueta (rasante o casi-impacto) se promedian
               5 muestras subpixel en grid rotado — elimina el punteado del borde */
            float ef; vec4 c=shade(gl_FragCoord.xy,ef);
            if(ef>0.35){
              vec3 acc=c.rgb*c.a; float aa=c.a; float e2; vec4 s;
              s=shade(gl_FragCoord.xy+vec2(0.45,0.15),e2); acc+=s.rgb*s.a; aa+=s.a;
              s=shade(gl_FragCoord.xy+vec2(-0.15,0.45),e2); acc+=s.rgb*s.a; aa+=s.a;
              s=shade(gl_FragCoord.xy+vec2(0.15,-0.45),e2); acc+=s.rgb*s.a; aa+=s.a;
              s=shade(gl_FragCoord.xy+vec2(-0.45,-0.15),e2); acc+=s.rgb*s.a; aa+=s.a;
              c=vec4(acc/max(aa,1e-4),aa*0.2);
            }
            gl_FragColor=c;
          }`;
        const cmp = (ty, s) => { const sh = gl.createShader(ty); gl.shaderSource(sh, s); gl.compileShader(sh);
          if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) { console.error(gl.getShaderInfoLog(sh)); return null; } return sh; };
        const prog = gl.createProgram(); gl.attachShader(prog, cmp(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, cmp(gl.FRAGMENT_SHADER, FRAG));
        gl.linkProgram(prog); gl.useProgram(prog);
        const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        const U = (n) => gl.getUniformLocation(prog, n);
        const uRes = U('uRes'), uCenter = U('uCenter'), uScale = U('uScale'), uRot = U('uRot'), uAber = U('uAber'),
          uWord = U('uWord'), uWordAmt = U('uWordAmt'), uTime = U('uTime'), uBreak = U('uBreak');
        gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA); gl.clearColor(0, 0, 0, 0);
        const wordTex = gl.createTexture(); gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, wordTex);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([0, 0, 0, 0]));
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.uniform1i(uWord, 0);
        let wordReady = false;
        const drawWord = () => { const c = document.createElement('canvas'); c.width = 1024; c.height = 384; const x = c.getContext('2d');
          x.clearRect(0, 0, 1024, 384); x.fillStyle = '#fff'; x.textAlign = 'center'; x.textBaseline = 'middle';
          x.font = '400 300px "Bebas Neue", sans-serif'; x.letterSpacing = '8px'; x.fillText('blopa', 512, 200);
          gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, wordTex); gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c); wordReady = true; };
        if (document.fonts && document.fonts.load) document.fonts.load('400 300px "Bebas Neue"').then(drawWord).catch(drawWord); else drawWord();

        const SS = coarse ? 1.2 : 1.5; let W = 0, H = 0;   // el AA de silueta permite bajar el supersampling global
        const resize = () => { W = innerWidth; H = innerHeight; shard.width = Math.round(W * DPR * SS); shard.height = Math.round(H * DPR * SS);
          shard.style.width = W + 'px'; shard.style.height = H + 'px'; gl.viewport(0, 0, shard.width, shard.height); };
        resize(); addEventListener('resize', resize);

        let mtx = 0, mty = 0, pmx = 0, pmy = 0;
        addEventListener('pointermove', (e) => { mtx = e.clientX / innerWidth - 0.5; mty = e.clientY / innerHeight - 0.5; });

        let a = 0, aber = 0, ent = 0, sc = 0, cx = 0, cy = 0, wordAmt = 0, brk = reduceMotion ? 0 : 0.85, last = 0, scInit = false;
        // rotación completa (yaw+pitch+roll), transpuesta para llevar el rayo a espacio objeto
        const rotM = (ax, ay, az) => {
          const cX = Math.cos(ax), sX = Math.sin(ax), cY = Math.cos(ay), sY = Math.sin(ay), cZ = Math.cos(az), sZ = Math.sin(az);
          const rxy = [[cY, 0, sY], [sX * sY, cX, -sX * cY], [-cX * sY, sX, cX * cY]];
          const rz = [[cZ, -sZ, 0], [sZ, cZ, 0], [0, 0, 1]];
          const m = [];
          for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) { let s = 0; for (let k = 0; k < 3; k++) s += rz[r][k] * rxy[k][c]; m[r * 3 + c] = s; }
          return new Float32Array([m[0], m[3], m[6], m[1], m[4], m[7], m[2], m[5], m[8]]);
        };
        const render = (now) => {
          now = now || performance.now();
          const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
          const lp = (r) => 1 - Math.exp(-r * dt);   // easing independiente del framerate
          a += 0.096 * dt;
          ent += (((entered ? 1 : 0)) - ent) * lp(3.7);   // 0 landing → 1 índice
          // quiebre: 0 = gema entera · 1 = rota (case abierto). burst = violencia a mitad de transición
          // línea de tiempo del quiebre: fractura (gema visible) → HOLD → se apaga + collage
          const es = (x) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
          let brkT = 0;
          if (inCase) { const ts = (performance.now() - caseT0) / 1000;
            if (ts < 0.4) brkT = es(ts / 0.4) * 0.5;                    // 1) se fractura, gema aún visible
            else if (ts < 0.85) brkT = 0.5;                             // 2) HOLD: gema rota a la vista
            else brkT = 0.5 + 0.5 * es(Math.min(1, (ts - 0.85) / 0.5)); // 3) se apaga (collage emerge)
          } else if (!reduceMotion) {
            // carga / vuelta al home: quiebre invertido — de rota (0.85) a entera, rápido al
            // principio y asentando al final (el burst cromático del medio sale gratis)
            const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const x = cs / 1.15; brkT = 0.85 * Math.pow(1 - x, 3); }
          }
          brk += (brkT - brk) * lp(inCase ? 30 : 7.5);
          const burst = brk * (1 - brk) * 4.0;
          // nacimiento: la gema se origina en el centro y crece hacia afuera mientras se arma
          // (uScale es inverso: más grande = gema más chica en pantalla)
          let birth = 1;
          if (!inCase && !reduceMotion) { const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const g = 1 - Math.pow(1 - cs / 1.15, 3); birth = 1 / (0.06 + 0.94 * g); } }
          const mob = W < H; const fit = mob ? 0.6 + 0.7 * (H / W) : 1;
          // landing: grande y centrado; índice: la gema se corre a la derecha (nombres a la izquierda)
          const scT = (entered ? (mob ? MOB_SC : 2.05) : (mob ? 2.2 : 1.95)) * fit * (1 + brk * 0.75);
          if (!scInit) { sc = scT; scInit = true; }   // sin zoom-lerp inicial: el nacimiento manda
          sc += (scT - sc) * lp(3.7);
          const cxT = entered ? (mob ? 0 : 0.30) : 0;      // desktop: gema a la derecha
          cx += (cxT - cx) * lp(3.7);
          const cyT = entered ? (mob ? MOB_CY : 0.0) : 0.02; // mobile: gema arriba, nombres despejados abajo
          cy += (cyT - cy) * lp(3.7);
          const wt = (wordReady && !entered && brk < 0.08) ? 1 : 0; wordAmt += (wt - wordAmt) * lp(3.7);   // el BLOPA revela después de que la gema cierra
          pmx += (mtx - pmx) * lp(3.7); pmy += (mty - pmy) * lp(3.7);
          const vel = Math.hypot(mtx - pmx, mty - pmy) * (0.0166 / Math.max(dt, 0.008));
          aber += ((Math.min(1, vel * 30) * 0.5) - aber) * lp(6.3);
          aber = Math.max(aber, burst * 1.4);   // estallido cromático al romperse
          // idle: mecido desincronizado + mira al cursor (menos parallax cuando es motivo chico)
          const pk = 1 - ent * 0.7;
          // rotación orgánica: varias frecuencias desincronizadas (no mecánico) + parallax
          const ay = (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07 + Math.sin(a * 0.12 + 1.3) * 0.055) + pmx * 0.6 * pk;
          const ax = (0.12 + Math.sin(a * 0.33) * 0.07 + Math.sin(a * 0.17 + 0.6) * 0.045) - pmy * 0.45 * pk;
          const az = Math.sin(a * 0.21 + 2.0) * 0.06 + Math.sin(a * 0.09) * 0.04;   // roll sutil: tumble orgánico
          const m = rotM(ax, ay, az);
          const fx = Math.sin(a * 0.6) * 0.004, fy = Math.sin(a * 0.42 + 0.8) * 0.006;   // flotación suave
          gl.uniform2f(uRes, shard.width, shard.height); gl.uniform2f(uCenter, cx + fx, cy + fy); gl.uniform1f(uScale, sc * birth);
          gl.uniform1f(uAber, aber); gl.uniform1f(uWordAmt, wordAmt); gl.uniform1f(uTime, performance.now() * 0.001);
          gl.uniform1f(uBreak, brk);
          gl.uniformMatrix3fv(uRot, false, m);
          gl.clear(gl.COLOR_BUFFER_BIT);
          if (brk < 0.93) gl.drawArrays(gl.TRIANGLES, 0, 3);   // gema rota y apagada (case abierto): no raymarchear de fondo
        };
        if (reduceMotion) { const d = () => render(); d(); addEventListener('resize', d); enterEl.addEventListener('click', () => { let n = 0; const l = () => { render(); if (n++ < 60) requestAnimationFrame(l); }; l(); }); }
        else { const loop = (t) => { render(t); requestAnimationFrame(loop); }; requestAnimationFrame(loop); }
      }
    </script>
  </body>
</html>
