          a += 0.096 * dt * (cur ? 0.45 : 1) * (reduceMotion ? 0 : 1);
          pmx += (mtx - pmx) * lp(3.7); pmy += (mty - pmy) * lp(3.7);
          gyX += (gyro.x - gyX) * lp(4); gyY += (gyro.y - gyY) * lp(4);
          const vel = Math.hypot(mtx - pmx, mty - pmy) * (0.0166 / Math.max(dt, 0.008));
          aber += ((Math.min(1, vel * 30) * 0.4) - aber) * lp(6.3); 
          const pk = entered ? 0.45 : 1;
          // invitación sin texto: a ~1.2 s el espectro barre y TERMINA apuntando a la zona donde aparecerá el índice;
          // después, cada 5 s, la gema gira como un faro mientras nadie toca
          if (!entered && !invited && !reduceMotion && (now - T0) > 1200) { invited = true;
            if (now - lastInput > 900) aimAt(port ? W * 0.27 : W * 0.2, port ? H * 0.66 : H * 0.62, 0.9); }
          let sweep = 0;
          if (!entered && !reduceMotion && !drag.on) { const st = ((now - T0) / 1000 - 4.2); const ph = st > 0 ? st % 5.0 : -1;
            if (ph >= 0 && ph < 1.8 && now - lastInput > 1500) sweep = Math.sin(Math.PI * ph / 1.8) * 0.6; }
          sweepS += (sweep - sweepS) * lp(6);
          const ry = sweepS + (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07 + Math.sin(a * 0.12 + 1.3) * 0.055) + pmx * 0.6 * pk + dragOff.x * 2.6 + gyX * 0.5;
          const rx = (0.12 + Math.sin(a * 0.33) * 0.07 + Math.sin(a * 0.17 + 0.6) * 0.045) - pmy * 0.45 * pk + dragOff.y * 1.8 + gyY * 0.35;
          const rz = Math.sin(a * 0.21 + 2.0) * 0.06 + Math.sin(a * 0.09) * 0.04;
          const R = rotR(rx, ry, rz);
          const uScaleV = 1.97;

          // ⑤ trazado del haz por la faceta real (R y cian con distinto índice → dispersión) y proyección a pantalla
          // la luz sigue al cursor (o al giroscopio) con un resorte: el haz de entrada se desvía levemente
          { const tx = (coarse ? gyX * 0.1 : pmx * 0.12) * W, ty = (coarse ? gyY * 0.07 : pmy * 0.1) * H;
            bv[0] += ((tx - bo[0]) * 55 - bv[0] * 11) * dt; bv[1] += ((ty - bo[1]) * 55 - bv[1] * 11) * dt;
            bo[0] += bv[0] * dt; bo[1] += bv[1] * dt; if (reduceMotion) { bo[0] = 0; bo[1] = 0; } }
          const SBX = S.bx + bo[0], SBY = S.by + bo[1];
          { const bx = S.gx - SBX, by = S.gy - SBY, bl = Math.hypot(bx, by) || 1;
            const din = [bx / bl, -by / bl, 0], perp = [-din[1], din[0], 0];
            const ow = [-din[0] * 4 + perp[0] * 0.52, -din[1] * 4 + perp[1] * 0.52, 0.3];   // entra oblicuo: la luz se quiebra y rebota adentro
            const o = w2o(R, ow), d = w2o(R, din);
            const toPx = (P) => { const k = (2.7 * S.gr * 1.75) / (uScaleV * (3 - P[2])); return [S.gx + P[0] * k, S.gy - P[1] * k]; };
            const pR = tracePath(o, d, 1.46), pC = tracePath(o, d, 1.56);
            const hR = pR && pR.outs[0] ? { en: pR.pts[0], ex: pR.outs[0].p, dir: pR.outs[0].dir } : null;
            const hC = pC && pC.outs[0] ? { en: pC.pts[0], ex: pC.outs[0].p, dir: pC.outs[0].dir } : null;
            // ── luz interna: hilos (proyectados a pantalla), glints de arista, chispas secundarias ──
            inner.nR = 0; inner.nC = 0; inner.glW.fill(0); sec.w.fill(0);
            const pathPx = (P, arr, eArr) => { const n = Math.min(5, P.pts.length);
              for (let i = 0; i < n; i++) { const q = toPx(o2w(R, P.pts[i])); arr[i * 2] = q[0]; arr[i * 2 + 1] = q[1]; }
              for (let i = 0; i < 4; i++) eArr[i] = i < P.segE.length ? P.segE[i] : 0; return n; };
            if (pR) { inner.nR = pathPx(pR, inner.pR, inner.eR);
              for (let i = 0; i < Math.min(4, pR.pts.length); i++) { const g = edgeGlint(pR.pts[i], pR.nrm[i]); if (!g) continue;
                const a2 = toPx(o2w(R, g.a)), b2 = toPx(o2w(R, g.b)); inner.gl.set([a2[0], a2[1], b2[0], b2[1]], i * 4);
                inner.glW[i] = g.w * (i === 0 ? 1 : (pR.segE[i - 1] || 0)) * 0.9; } }
            if (pC) inner.nC = pathPx(pC, inner.pC, inner.eC);
            let si = 0;
            for (const [P, col] of [[pR, [1.0, 0.35, 0.42]], [pC, [0.3, 0.88, 1.0]]]) { if (!P) continue;
              for (let j = 1; j < P.outs.length && j < 3 && si < 4; j++, si++) { const oq = P.outs[j];
                const q = toPx(o2w(R, oq.p)), D = o2w(R, oq.dir); const l = Math.hypot(D[0], D[1]) || 1;
                sec.p[si * 2] = q[0]; sec.p[si * 2 + 1] = q[1]; sec.d[si * 2] = D[0] / l; sec.d[si * 2 + 1] = -D[1] / l;
                sec.w[si] = oq.w * clamp((l - 0.15) / 0.5, 0, 1); sec.c.set(col, si * 3); } }
            if (hR && hC) {
              const exW = o2w(R, hC.ex), enW = o2w(R, hR.en), DR = o2w(R, hR.dir), DC = o2w(R, hC.dir);
              ex = toPx(exW); en = toPx(enW);
              const l1 = Math.hypot(DR[0], DR[1]) || 1, l2 = Math.hypot(DC[0], DC[1]) || 1;
              const r0 = [DR[0] / l1, -DR[1] / l1], c0 = [DC[0] / l2, -DC[1] / l2];
              let am = Math.atan2(r0[1] + c0[1], r0[0] + c0[0]);
              // aim: el rayo "mira" el nombre (o la zona del índice) y vuelve a la física
              aimK = aimEnv(now);
              if (aimK > 0) { let da = Math.atan2(aim.y - ex[1], aim.x - ex[0]) - am; da = Math.atan2(Math.sin(da), Math.cos(da)); am += da * aimK * 0.9; }
              let dth = Math.atan2(c0[1], c0[0]) - Math.atan2(r0[1], r0[0]); dth = Math.atan2(Math.sin(dth), Math.cos(dth));
              const spread = Math.sign(dth || 1) * clamp(Math.abs(dth) * 4, 0.06, 0.35);
              dR = [Math.cos(am - spread / 2), Math.sin(am - spread / 2)]; dC = [Math.cos(am + spread / 2), Math.sin(am + spread / 2)];
              inner.x0 = ex; const dm = [Math.cos(am), Math.sin(am)];
              lpool = [ex[0] + dm[0] * S.gr * 1.1, ex[1] + dm[1] * S.gr * 1.1];
              // ¿el rayo principal pega en la pantalla? → cáustica sobre la imagen
              hit[2] = 0;
              if (entered && !inCase) { let t0 = 0, t1 = 1e5;
                for (const [o1, d1, lo1, hi1] of [[ex[0], dm[0], S.x0, S.x1], [ex[1], dm[1], S.y0, S.y1]]) {
                  if (Math.abs(d1) < 1e-6) { if (o1 < lo1 || o1 > hi1) t0 = 1e9; } else { const a1 = (lo1 - o1) / d1, b1 = (hi1 - o1) / d1; t0 = Math.max(t0, Math.min(a1, b1)); t1 = Math.min(t1, Math.max(a1, b1)); } }
                if (t0 <= t1 && t0 < 1e8) { hit[0] = ex[0] + dm[0] * (t0 + 30); hit[1] = ex[1] + dm[1] * (t0 + 30); hit[2] = rayA; } }
              const inPlane = Math.min(l1, l2);
              // cuando aparece el trabajo, el efecto baja (la pieza manda)
              rayA += (Math.max(clamp((inPlane - 0.15) / 0.45, 0, 1), aimK) * (inCase ? 0 : entered ? Math.max(0.42 * (1 - 0.6 * vidAmt), aimK * 0.6) : 1) - rayA) * lp(8);
            } else { rayA += (0 - rayA) * lp(8); en = [S.gx - (bx / bl) * S.gr * 0.42, S.gy - (by / bl) * S.gr * 0.42]; }
          }

          // abanico de proyección: eje al centro de la pantalla, límites por sus esquinas
          const cx = (S.x0 + S.x1) / 2, cy = (S.y0 + S.y1) / 2;
          let ax = cx - S.gx, ay = cy - S.gy; const al = Math.hypot(ax, ay) || 1; ax /= al; ay /= al;
          let lo = 1e9, hi = -1e9;
          for (const [px, py] of [[S.x0, S.y0], [S.x1, S.y0], [S.x0, S.y1], [S.x1, S.y1]]) {
            const vx = px - S.gx, vy = py - S.gy; const an = Math.atan2(ax * vy - ay * vx, ax * vx + ay * vy);
            lo = Math.min(lo, an); hi = Math.max(hi, an); }
          // cover: la diapositiva (16:10) llena la pantalla sin deformarse
          const cropT = (cur && CROP[cur]) || 0, taE = texA / (1 - cropT);
          const ra = (S.x1 - S.x0) / Math.max(1, S.y1 - S.y0); const cov = ra > taE ? [1, taE / ra] : [ra / taE, 1];

          // ═ pase 0: prefiltro del bokeh (sólo si hay desenfoque y cambió la imagen) ═
          if ((Math.abs(dfs) > 0.004 || open > 0.01) && vidAmt > 0.01 && bokDirty) {
            gl.bindFramebuffer(gl.FRAMEBUFFER, fbo); gl.viewport(0, 0, BW, BH); gl.disable(gl.BLEND); gl.useProgram(PU.pr);
            gl.uniform2f(PU('uRes'), BW, BH); gl.uniform2f(PU('uTexel'), 1 / BW, 1 / BH);
            gl.drawArrays(gl.TRIANGLES, 0, 3); gl.bindFramebuffer(gl.FRAMEBUFFER, null); bokDirty = false;
          }
          gl.activeTexture(gl.TEXTURE2); gl.bindTexture(gl.TEXTURE_2D, btex);

          // ═ pase 1: sala ═
          gl.viewport(0, 0, roomC.width, roomC.height); gl.disable(gl.BLEND); gl.useProgram(RU.pr);
          gl.uniform2f(RU('uRes'), roomC.width, roomC.height); gl.uniform1f(RU('uDpr'), RDPR);
          gl.uniform1f(RU('uTime'), reduceMotion ? 3.0 : now * 0.001);
          gl.uniform2f(RU('uG'), S.gx, S.gy); gl.uniform1f(RU('uGR'), S.gr); gl.uniform2f(RU('uB0'), SBX, SBY); gl.uniform2f(RU('uEn'), en[0], en[1]);
          gl.uniform4f(RU('uS'), S.x0, S.y0, S.x1, S.y1); gl.uniform2f(RU('uAx'), ax, ay); gl.uniform2f(RU('uFan'), lo, hi);
          gl.uniform1f(RU('uScrAmt'), scrAmt); gl.uniform1f(RU('uVidAmt'), vidAmt); gl.uniform1f(RU('uDefocus'), dfs);
          gl.uniform1f(RU('uBeamK'), beamK); gl.uniform1f(RU('uFanK'), fanK);
          gl.uniform1f(RU('uDisp'), 0.003 + 0.035 * Math.abs(dfs)); gl.uniform1f(RU('uOpen'), open);
          gl.uniform1f(RU('uLightA'), projA); gl.uniform1f(RU('uScrim'), 0); gl.uniform1f(RU('uLand'), land);   // case editorial: sin velo sobre el sitio
          gl.uniform1f(RU('uCropT'), cropT); gl.uniform1f(RU('uScrimP'), 0); gl.uniform1f(RU('uScrollK'), port && inCase ? clamp(caseEl.scrollTop / 320, 0, 1) : 0);
          gl.uniform2f(RU('uEx'), ex[0], ex[1]); gl.uniform2f(RU('uDR'), dR[0], dR[1]); gl.uniform2f(RU('uDC'), dC[0], dC[1]);
          gl.uniform1f(RU('uRayA'), rayA); gl.uniform1f(RU('uDuo'), DUO); gl.uniform2f(RU('uCov'), cov[0], cov[1]);
          gl.uniform3f(RU('uTint'), tintR, tintG, tintB); gl.uniform1f(RU('uTintAmt'), tintAmt);
          gl.uniform3f(RU('uAvg'), avR, avG, avB);
          gl.uniform2fv(RU('uSP'), sec.p); gl.uniform2fv(RU('uSD'), sec.d); gl.uniform1fv(RU('uSW'), sec.w); gl.uniform3fv(RU('uSCol'), sec.c);
          gl.uniform3f(RU('uCph'), ry * 5, rx * 6, rz * 8); gl.uniform2f(RU('uLp'), lpool[0], lpool[1]); gl.uniform3f(RU('uHit'), hit[0], hit[1], hit[2]);
          gl.uniform1f(RU('uExpo'), entered && !inCase ? (port ? 1 : 0.55) : 0);
          gl.drawArrays(gl.TRIANGLES, 0, 3);

          // ═ pase 2: gema (viewport cuadrado de lado 2.7·r, encima de la sala; se saltea si está fuera de cuadro) ═
          const side = Math.round(S.gr * 2.7 * RDPR), vx0 = Math.round((S.gx - S.gr * 1.35) * RDPR), vy0 = Math.round(roomC.height - (S.gy + S.gr * 1.35) * RDPR);
          const visible = vx0 < roomC.width && vy0 < roomC.height && vx0 + side > 0 && vy0 + side > 0;
          if (side > 2 && projA > 0.01 && visible) {
            let lx = SBX - S.gx, ly = -(SBY - S.gy); const ll = Math.hypot(lx, ly) || 1;
            const bz = 0.35; const bn = Math.hypot(lx / ll, ly / ll, bz);
            gl.viewport(vx0, vy0, side, side); gl.enable(gl.BLEND); gl.useProgram(GU.pr);
            gl.uniform2f(GU('uRes'), side, side); gl.uniform2f(GU('uOff'), vx0, vy0); gl.uniform1f(GU('uAlpha'), projA);
            gl.uniform1f(GU('uScale'), uScaleV);
            gl.uniform1f(GU('uAber'), aber); gl.uniform1f(GU('uTime'), reduceMotion ? 3.0 : now * 0.001);
            gl.uniform3f(GU('uTint'), tintR, tintG, tintB); gl.uniform1f(GU('uTintAmt'), tintAmt * 0.7);
            gl.uniform3f(GU('uBeam'), lx / ll / bn, ly / ll / bn, bz / bn); gl.uniform1f(GU('uLit'), lit);
            gl.uniform1f(GU('uWordAmt'), wordReady && !entered ? Math.min(1, lit * 1.2) : 0);
            gl.uniformMatrix3fv(GU('uRot'), false, toGL(R));
            gl.drawArrays(gl.TRIANGLES, 0, 3);
            // ═ pase 3: la LUZ adentro (aditiva sobre el cristal) ═
            const mxA = Math.max(avR, avG, avB, 0.2);
            gl.useProgram(IU.pr); gl.blendFunc(gl.ONE, gl.ONE);
            gl.uniform2f(IU('uRes'), roomC.width, roomC.height); gl.uniform1f(IU('uDpr'), RDPR); gl.uniform1f(IU('uTime'), reduceMotion ? 3.0 : now * 0.001);
            gl.uniform1f(IU('uK'), lit * projA * (1 - open)); gl.uniform1f(IU('uW'), Math.max(0.9, S.gr * 0.012));
            gl.uniform2fv(IU('uPR'), inner.pR); gl.uniform2fv(IU('uPC'), inner.pC); gl.uniform1fv(IU('uER'), inner.eR); gl.uniform1fv(IU('uEC'), inner.eC);
            gl.uniform1f(IU('uNR'), inner.nR); gl.uniform1f(IU('uNC'), inner.nC);
            gl.uniform4fv(IU('uGl'), inner.gl); gl.uniform1fv(IU('uGlW'), inner.glW);
            gl.uniform2f(IU('uEn'), en[0], en[1]); gl.uniform2f(IU('uX0'), inner.x0[0], inner.x0[1]);
            const ia = tintAmt * 0.8; gl.uniform3f(IU('uIn'), 1 + (avR / mxA - 1) * ia, 1 + (avG / mxA - 1) * ia, 1 + (avB / mxA - 1) * ia);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
            gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
          }
          return tweening || Math.abs(dfs) > 0.002 || drag.on || Math.abs(dragOff.x) > 0.001;
        };

        // loop: continuo con movimiento; con prefers-reduced-motion, render POR DEMANDA (sólo cuando algo cambia)
        let raf = 0, until = 0;
        let skip = false, ema = 16, adaptT = performance.now(), lastF = 0;
        const frame = (t) => { raf = 0; const pn = performance.now();
          const idle = !reduceMotion && pn - lastInput > 5000 && !drag.on && !tw.from;
          skip = idle ? !skip : false;
          let busy = false;
          if (!glReady()) { raf = requestAnimationFrame(frame); return; }   // compilando: la página sigue viva
          if (!skip) { busy = render(t);
            if (lastF) { ema += ((pn - lastF) / (idle ? 2 : 1) - ema) * 0.08; } lastF = pn;
            if (pn - adaptT > 1500) { adaptT = pn;
              if (ema > 21 && sMul > Q.floor) { sMul *= 0.85; resize(); }
              else if (ema > 28 && Q === QHI && !qParam && pn - T0 > 4000) { Q = QLO; sMul = 1; initGL(); drawWord(); resize(); }   // ni bajando resolución llega: perfil BAJO
              else if (ema < 12.5 && sMul < 1) { sMul = Math.min(1, sMul * 1.1); resize(); } } }
          if (!reduceMotion || busy || performance.now() < until) raf = requestAnimationFrame(frame); };
        invalidate = (ms = 900) => { until = Math.max(until, performance.now() + ms); if (!raf) raf = requestAnimationFrame(frame); };
        invalidate(2500);
      }
      // deep-link al cargar: #proyectos entra al índice; #slug abre el case
      { const h = curH(); if (h === 'proyectos') enter(false); else if (projOf(h)) openCase(h, { push: false }); }
    </script>
  </body>
</html>
