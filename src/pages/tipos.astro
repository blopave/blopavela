---
// HOME — la gema es la ENTRADA; al hacer click se corre y aparecen los proyectos
// (nombres a la izquierda, gema ambiente a la derecha). Click en un nombre abre el case.
import { projects } from '../data/projects';
const yearOf = (ended: string) => (ended ? ended.split('-')[0] : 'En curso');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>blopa — selector de tipografía</title>
    <link rel="preload" href="/fonts/ClashDisplay-600.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-400.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Satoshi'; src:url('/fonts/Satoshi-500.woff2') format('woff2'); font-weight:500; font-display:swap; }
      @font-face { font-family:'Clash Display'; src:url('/fonts/ClashDisplay-600.woff2') format('woff2'); font-weight:600; font-display:swap; }
      /* candidatas del selector */
      @font-face { font-family:'Bebas Neue'; src:url('/fonts/bebas-neue-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      @font-face { font-family:'Space Mono'; src:url('/fonts/space-mono-latin-700-normal.woff2') format('woff2'); font-weight:700; font-display:swap; }
      @font-face { font-family:'Zilla Slab'; src:url('/fonts/zilla-slab-latin-600-normal.woff2') format('woff2'); font-weight:600; font-display:swap; }
      @font-face { font-family:'Chakra Petch'; src:url('/fonts/chakra-petch-latin-600-normal.woff2') format('woff2'); font-weight:600; font-display:swap; }
      @font-face { font-family:'Darker Grotesque'; src:url('/fonts/darker-grotesque-latin-700-normal.woff2') format('woff2'); font-weight:700; font-display:swap; }
      @font-face { font-family:'Anton'; src:url('/fonts/anton-latin-400-normal.woff2') format('woff2'); font-weight:400; font-display:swap; }
      :root{ --bg:#0b0b0e; --ink:#f2f3f5; --soft:#7b7d86; --dim:#4b4d55; --hair:#22222a;
        --aqua:#24e2e8; --red:#ff3a54;
        --display:'Clash Display',Georgia,serif; --body:'Satoshi',-apple-system,sans-serif;
        --mono:ui-monospace,'SF Mono',Menlo,monospace; --ease:cubic-bezier(.22,1,.36,1); --gut:clamp(1.3rem,4vw,4rem); }
      *{box-sizing:border-box;margin:0}
      body{font-family:var(--body);background:var(--bg);color:var(--ink);min-height:100svh;overflow-x:hidden;
        -webkit-font-smoothing:antialiased;line-height:1.5}
      a{color:inherit;text-decoration:none}
      canvas.shard{position:fixed;inset:0;z-index:1;pointer-events:none}

      .top{position:fixed;top:0;left:0;right:0;z-index:5;display:flex;justify-content:space-between;align-items:baseline;
        padding:var(--gut);font-family:var(--mono);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--soft)}
      .top a:hover{color:var(--ink)}

      /* landing: sólo el disparador (la palabra "blopa" vive dentro del cristal) */
      .enter{position:fixed;inset:0;z-index:4;cursor:pointer}
      body.entered .enter{pointer-events:none}
      .hint{position:fixed;left:0;right:0;bottom:clamp(3rem,10vh,6rem);z-index:5;text-align:center;pointer-events:none;
        font-family:var(--mono);font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:var(--soft);
        opacity:0;transition:opacity .6s var(--ease)}
      body:not(.entered):not(.pre) .hint{opacity:.75}
      .hint span{display:inline-block;margin-left:.35em;animation:nudge 1.5s var(--ease) infinite}
      @keyframes nudge{0%,100%{transform:translateX(0);opacity:.55}50%{transform:translateX(6px);opacity:1}}

      /* la gema es la ENTRADA y permanece: al entrar se corre a la derecha y deja los nombres a la izquierda */
      canvas.shard{transition:opacity .8s var(--ease)}

      /* índice: nombres alineados a la izquierda; la gema queda a la derecha (ambiente) */
      .index{position:fixed;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:center;
        gap:.2rem;padding:clamp(5rem,12vh,9rem) var(--gut) 4rem;max-width:min(46vw,40rem);
        opacity:0;pointer-events:none;transition:opacity .7s var(--ease)}
      body.entered .index{opacity:1;pointer-events:auto;transition-delay:.3s}
      body.in-case .index{opacity:0;pointer-events:none;transition-delay:0s}
      .prow{appearance:none;background:none;border:0;cursor:pointer;text-align:left;
        display:flex;align-items:baseline;gap:1rem;padding:.55rem 0;position:relative;
        transition:padding .35s var(--ease)}
      .prow:hover{padding-left:1rem}
      .prow__name{font-family:var(--display);font-weight:var(--dw,600);font-size:var(--dps,clamp(1.9rem,3.8vw,3.1rem));
        letter-spacing:-.03em;line-height:1.02;color:var(--soft);transition:color .35s var(--ease),text-shadow .35s var(--ease)}
      .prow:hover .prow__name{color:var(--ink);text-shadow:-1.4px 0 var(--red),1.4px 0 var(--aqua)}
      .prow__arrow{opacity:0;color:var(--c);transform:translateX(-6px);
        transition:opacity .3s var(--ease),transform .3s var(--ease)}
      .prow:hover .prow__arrow{opacity:1;transform:translateX(0)}
      @media(max-width:860px){
        .index{max-width:none;padding-top:clamp(4rem,9vh,7rem);justify-content:flex-end;padding-bottom:clamp(3rem,10vh,6rem)}
      }

      /* selector de tipografía en vivo (herramienta de comparación) */
      .fontpick{position:fixed;left:50%;top:2.4rem;transform:translateX(-50%);z-index:30;display:flex;gap:.3rem;flex-wrap:wrap;
        justify-content:center;max-width:92vw;background:rgba(12,12,16,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
        border:1px solid var(--hair);border-radius:999px;padding:.35rem}
      .fontpick button{appearance:none;font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;
        white-space:nowrap;color:var(--soft);background:transparent;border:0;border-radius:999px;padding:.4rem .7rem;transition:color .2s,background .2s}
      .fontpick button:hover{color:var(--ink)}
      .fontpick button.on{color:#06131a;background:var(--aqua)}
      @media(max-width:860px){ .fontpick{top:auto;bottom:.6rem;font-size:.55rem} }

      /* case (reusa el patrón editorial) */
      .case{position:fixed;inset:0;z-index:6;background:#0b0b08;overflow-y:auto;opacity:0;visibility:hidden;pointer-events:none;
        transition:opacity .5s var(--ease),visibility .5s var(--ease)}
      body.in-case .case{opacity:1;visibility:visible;pointer-events:auto}
      .case__bar{position:sticky;top:0;display:flex;justify-content:space-between;padding:var(--gut);
        font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);
        background:linear-gradient(#0b0b08 60%,transparent)}
      .case__bar button{appearance:none;background:none;border:0;font:inherit;color:var(--soft);cursor:pointer;letter-spacing:.14em}
      .case__bar button:hover{color:var(--ink)}
      .case__panel{max-width:84rem;margin:0 auto;padding:clamp(1rem,4vh,3rem) var(--gut) 6rem;
        display:grid;grid-template-columns:minmax(0,26rem) 1fr;gap:clamp(2rem,5vw,5rem);align-items:start}
      @media(max-width:860px){.case__panel{grid-template-columns:1fr}}
      .case__head{position:sticky;top:6rem}
      @media(max-width:860px){.case__head{position:static}}
      .case__eye{font-family:var(--mono);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--soft)}
      .case__title{font-family:var(--display);font-weight:var(--dw,600);font-size:var(--dcs,clamp(2.4rem,6vw,4.5rem));line-height:.95;
        letter-spacing:-.03em;margin:.5rem 0 0;text-shadow:-1.5px 0 var(--red),1.5px 0 var(--aqua)}
      .case__role{margin-top:.6rem;color:#c9cbd2;font-size:.9rem}
      .case__blurb{margin-top:1rem;color:var(--soft);line-height:1.55;max-width:34ch}
      .case__live{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.4rem;font-family:var(--mono);font-size:.72rem;
        letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border:1px solid rgba(242,243,245,.26);border-radius:999px;
        padding:.7rem 1.2rem;transition:border-color .3s var(--ease)}
      .case__live span{color:var(--aqua)} .case__live:hover{border-color:var(--aqua)}
      .case__shots{display:flex;flex-direction:column;gap:clamp(1rem,2.5vh,2rem)}
      .case__shots img{width:100%;height:auto;border:1px solid rgba(242,243,245,.1);border-radius:4px;display:block;
        box-shadow:0 30px 80px rgba(0,0,0,.5)}

      @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
    </style>
  </head>
  <body class="pre">
    <canvas class="shard" data-shard aria-hidden="true"></canvas>
    <div class="enter" data-enter role="button" tabindex="0" aria-label="Entrar"></div>

    <div class="top">
      <span class="top__mark">blopa</span>
      <span>Buenos Aires · <time data-clock>—</time></span>
    </div>

    <div class="fontpick" data-fontpick>
      <button type="button" data-f="clash" class="on">Clash</button>
      <button type="button" data-f="d1">Bebas</button>
      <button type="button" data-f="d2">Space Mono</button>
      <button type="button" data-f="d3">Zilla</button>
      <button type="button" data-f="d4">Chakra</button>
      <button type="button" data-f="d5">Darker</button>
      <button type="button" data-f="d6">Anton</button>
    </div>
    <div class="hint" data-hint>entrá <span>→</span></div>

    <section class="index" data-index>
      {projects.map((p) => (
        <button type="button" class="prow" data-row data-slug={p.slug} style={`--c:${p.accent}`}>
          <span class="prow__name">{p.name}</span>
          <span class="prow__arrow" aria-hidden="true">→</span>
        </button>
      ))}
    </section>

    <section class="case" data-case aria-hidden="true">
      <div class="case__bar"><button type="button" data-back>← galería</button><span>blopa</span></div>
      <div class="case__panel">
        <div class="case__head">
          <p class="case__eye" data-cat></p>
          <h2 class="case__title" data-name></h2>
          <p class="case__role" data-role></p>
          <p class="case__blurb" data-blurb></p>
          <a class="case__live" data-live target="_blank" rel="noopener">Ver en vivo <span aria-hidden="true">↗</span></a>
        </div>
        <div class="case__shots" data-shots></div>
      </div>
    </section>

    <script define:vars={{ projects }}>
      const body = document.body;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const coarse = matchMedia('(pointer: coarse)').matches;
      const DPR = Math.min(coarse ? 1.4 : 2, window.devicePixelRatio || 1);
      requestAnimationFrame(() => body.classList.remove('pre'));

      // reloj vivo de Buenos Aires (top-right)
      const clockEl = document.querySelector('[data-clock]');
      if (clockEl) {
        const tick = () => { clockEl.textContent = new Intl.DateTimeFormat('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date()); };
        tick(); setInterval(tick, 15000);
      }

      // ── entrada / galería / case ──
      let entered = false;
      const enter = () => { if (entered) return; entered = true; body.classList.add('entered'); };
      const enterEl = document.querySelector('[data-enter]');
      enterEl.addEventListener('click', enter);
      enterEl.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enter(); } });
      addEventListener('wheel', (e) => { if (!entered && e.deltaY > 6) enter(); }, { passive: true });

      // case
      const caseEl = document.querySelector('[data-case]');
      const catEl = caseEl.querySelector('[data-cat]'), nameEl = caseEl.querySelector('[data-name]'),
        roleEl = caseEl.querySelector('[data-role]'), blurbEl = caseEl.querySelector('[data-blurb]'),
        liveEl = caseEl.querySelector('[data-live]'), shotsEl = caseEl.querySelector('[data-shots]');
      const yearOf = (e) => (e ? e.split('-')[0] : 'En curso');
      const openCase = (slug) => {
        const p = projects.find((x) => x.slug === slug); if (!p) return;
        catEl.textContent = p.category + ' · ' + yearOf(p.ended);
        nameEl.textContent = p.name; roleEl.textContent = p.role; blurbEl.textContent = p.blurb;
        if (p.url) { liveEl.href = p.url; liveEl.style.display = ''; } else { liveEl.style.display = 'none'; }
        shotsEl.innerHTML = ''; [1, 2, 3].forEach((n) => { const im = document.createElement('img'); im.src = '/img/src/' + slug + '-' + n + '.jpg'; im.alt = p.name + ' — ' + n; im.loading = 'lazy'; shotsEl.appendChild(im); });
        body.classList.add('in-case'); caseEl.setAttribute('aria-hidden', 'false'); caseEl.scrollTop = 0;
      };
      const closeCase = () => { body.classList.remove('in-case'); caseEl.setAttribute('aria-hidden', 'true'); };
      // índice: nombres a la izquierda; la gema queda a la derecha (ambiente). click → case
      document.querySelectorAll('[data-row]').forEach((row) => {
        row.addEventListener('click', () => openCase(row.dataset.slug));
      });
      document.querySelector('[data-back]').addEventListener('click', closeCase);
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && body.classList.contains('in-case')) closeCase(); });

      // ── cristal (entrada): icosaedro de hielo con "blopa", idle + parallax; al entrar se achica arriba ──
      const shard = document.querySelector('[data-shard]');
      const gl = shard.getContext('webgl', { alpha: true, premultipliedAlpha: false, antialias: true, powerPreference: 'low-power' });
      if (gl) {
        const STEPS = coarse ? 60 : 92, INSTEPS = coarse ? 26 : 42;
        const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
        const FRAG = `precision highp float;
          uniform vec2 uRes; uniform vec2 uCenter; uniform float uScale; uniform mat3 uRot; uniform float uAber;
          uniform sampler2D uWord; uniform float uWordAmt; uniform float uTime;
          #define PHI 1.61803398875
          float smax(float a,float b,float k){ float h=clamp(0.5+0.5*(a-b)/k,0.,1.); return mix(b,a,h)+k*h*(1.0-h); }
          float sdIco(vec3 p){ p=abs(p); float k=0.085;
            float d=dot(p,normalize(vec3(1.,1.,1.)));
            d=smax(d,dot(p,normalize(vec3(0.,1.,PHI+1.))),k);
            d=smax(d,dot(p,normalize(vec3(PHI+1.,0.,1.))),k);
            d=smax(d,dot(p,normalize(vec3(1.,PHI+1.,0.))),k);
            return d-1.0; }
          float sdC(vec3 p){ return sdIco(p) - (0.008 + 0.008*sin(uTime*0.7)); }
          vec3 nrm(vec3 p){ vec2 e=vec2(0.006,0.);
            return normalize(vec3(sdC(p+e.xyy)-sdC(p-e.xyy),sdC(p+e.yxy)-sdC(p-e.yxy),sdC(p+e.yyx)-sdC(p-e.yyx))); }
          vec3 env(vec3 d){
            float ea=uTime*0.06; float ec=cos(ea), es=sin(ea); d.xz=mat2(ec,-es,es,ec)*d.xz;
            vec3 c=vec3(0.040,0.043,0.055);
            c+=vec3(0.70,0.84,0.98)*pow(max(0.,dot(d,normalize(vec3(-0.55,0.35,0.75)))),7.0)*0.60;
            c+=vec3(0.90,0.94,1.0)*pow(max(0.,dot(d,normalize(vec3(0.1,0.85,-0.2)))),15.0)*0.52;
            c+=vec3(1.0)*pow(max(0.,dot(d,normalize(vec3(0.5,0.62,0.4)))),22.0)*0.45;
            c+=vec3(0.05,0.85,1.0)*pow(max(0.,dot(d,normalize(vec3(-0.55,0.35,0.75)))),6.0)*uAber*1.8;
            c+=vec3(1.0,0.20,0.32)*pow(max(0.,dot(d,normalize(vec3(0.65,-0.25,0.6)))),6.0)*uAber*1.8;
            return c; }
          void main(){
            vec2 uv=(gl_FragCoord.xy-0.5*uRes)/uRes.y; uv=(uv-uCenter)*uScale;
            vec3 ro=vec3(0.,0.,3.0); vec3 rd=normalize(vec3(uv,-1.75));
            float t=0.; float hit=-1.; float md=1e9;
            for(int i=0;i<${STEPS};i++){ vec3 q=uRot*(ro+rd*t); float d=sdC(q); md=min(md,d);
              if(d<0.0008){hit=t;break;} t+=d*0.8; if(t>7.)break; }
            if(hit<0.){
              float e=smoothstep(0.014,0.0,md); float glow=smoothstep(0.17,0.0,md);
              if(e<=0.001&&glow<=0.001){ gl_FragColor=vec4(0.); return; }
              vec3 hc=mix(vec3(0.13,0.85,1.0),vec3(1.0,0.22,0.35),step(0.,uv.x));
              gl_FragColor=vec4(hc*e*0.5+vec3(0.12,0.16,0.24)*glow*glow*0.5, max(e*0.6,glow*glow*0.32)); return;
            }
            vec3 po=uRot*(ro+rd*hit); vec3 n=nrm(po); vec3 nw=n*uRot;
            float ci=clamp(dot(-rd,nw),0.,1.); float fres=0.04+0.96*pow(1.0-ci,4.0);
            float iorG=1.47; float disp=0.03+uAber*0.11; vec3 col;
            vec3 rin=refract(rd,nw,1.0/iorG);
            if(length(rin)<0.5){ col=env(reflect(rd,nw)); }
            else{
              vec3 rinObj=uRot*rin; float ti=0.02;
              for(int i=0;i<${INSTEPS};i++){ float d=sdC(po+rinObj*ti); if(d>0.)break; ti+=max(0.01,-d)*0.9; if(ti>6.)break; }
              vec3 pe=po+rinObj*ti; vec3 neW=(-nrm(pe))*uRot;
              vec3 oR=refract(rin,neW,iorG+disp),oG=refract(rin,neW,iorG),oB=refract(rin,neW,iorG-disp);
              if(length(oR)<0.5)oR=reflect(rin,neW); if(length(oG)<0.5)oG=reflect(rin,neW); if(length(oB)<0.5)oB=reflect(rin,neW);
              col=vec3(env(oR).r,env(oG).g,env(oB).b);
              col*=exp(-ti*vec3(0.55,0.42,0.28)*0.5);
            }
            vec3 rfl=env(reflect(rd,nw)); col=mix(col,rfl,fres*0.7);
            float rim=pow(1.0-ci,2.2);
            vec3 rimC=mix(vec3(0.13,0.85,1.0),vec3(1.0,0.22,0.35),smoothstep(-0.28,0.28,nw.x));
            col+=rim*(0.44+uAber*1.3)*rimC;
            if(uWordAmt>0.001){
              vec2 wuv=uv*vec2(1.0,2.7)+rin.xy*0.05+vec2(0.5,0.5);
              float so=0.005+uAber*0.012;
              float wr=texture2D(uWord,wuv+vec2(so,0.)).r, wg=texture2D(uWord,wuv).r, wb=texture2D(uWord,wuv-vec2(so,0.)).r;
              col+=uWordAmt*vec3(wr,wg,wb)*vec3(0.97,0.98,1.0);
            }
            float al=clamp(0.28+fres*0.8+max(col.r,max(col.g,col.b))*0.6,0.,1.);
            gl_FragColor=vec4(col,al);
          }`;
        const cmp = (ty, s) => { const sh = gl.createShader(ty); gl.shaderSource(sh, s); gl.compileShader(sh);
          if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(sh)); return null; } return sh; };
        const prog = gl.createProgram(); gl.attachShader(prog, cmp(gl.VERTEX_SHADER, VERT)); gl.attachShader(prog, cmp(gl.FRAGMENT_SHADER, FRAG));
        gl.linkProgram(prog); gl.useProgram(prog);
        const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        const U = (n) => gl.getUniformLocation(prog, n);
        const uRes = U('uRes'), uCenter = U('uCenter'), uScale = U('uScale'), uRot = U('uRot'), uAber = U('uAber'),
          uWord = U('uWord'), uWordAmt = U('uWordAmt'), uTime = U('uTime');
        gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA); gl.clearColor(0, 0, 0, 0);
        const wordTex = gl.createTexture(); gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, wordTex);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([0, 0, 0, 0]));
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.uniform1i(uWord, 0);
        let wordReady = false;
        let wmW = 600, wmFam = 'Clash Display', wmFB = 'sans-serif', wmLs = 20, wmSize = 260;
        const drawWord = () => { const c = document.createElement('canvas'); c.width = 1024; c.height = 384; const x = c.getContext('2d');
          x.clearRect(0, 0, 1024, 384); x.fillStyle = '#fff'; x.textAlign = 'center'; x.textBaseline = 'middle';
          x.font = wmW + ' ' + wmSize + 'px "' + wmFam + '", ' + wmFB; x.letterSpacing = wmLs + 'px'; x.fillText('blopa', 512, 200);
          gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, wordTex); gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c); wordReady = true; };
        const loadAndDraw = () => { if (document.fonts && document.fonts.load) document.fonts.load(wmW + ' 300px "' + wmFam + '"').then(drawWord).catch(drawWord); else drawWord(); };
        loadAndDraw();
        // ── selector de tipografía en vivo (cambia nombres + wordmark sin recargar) ──
        const FONTS = {
          clash: { stack:"'Clash Display',Georgia,serif",        w:600, fam:'Clash Display',    fb:'sans-serif', ls:20, prow:'clamp(1.9rem,3.8vw,3.1rem)', casesz:'clamp(2.4rem,6vw,4.5rem)' },
          d1:    { stack:"'Bebas Neue',sans-serif",              w:400, fam:'Bebas Neue',       fb:'sans-serif', ls:4,  prow:'clamp(2.6rem,5.4vw,4.4rem)', casesz:'clamp(3.2rem,8vw,6rem)' },
          d2:    { stack:"'Space Mono',ui-monospace,monospace",  w:700, fam:'Space Mono',       fb:'monospace',  ls:2,  prow:'clamp(1.5rem,3.0vw,2.5rem)', casesz:'clamp(1.9rem,4.4vw,3.4rem)' },
          d3:    { stack:"'Zilla Slab',Georgia,serif",           w:600, fam:'Zilla Slab',       fb:'serif',      ls:6,  prow:'clamp(2.0rem,4.1vw,3.4rem)', casesz:'clamp(2.6rem,6.4vw,4.9rem)' },
          d4:    { stack:"'Chakra Petch',sans-serif",            w:600, fam:'Chakra Petch',     fb:'sans-serif', ls:2,  prow:'clamp(1.8rem,3.6vw,3.0rem)', casesz:'clamp(2.3rem,5.6vw,4.3rem)' },
          d5:    { stack:"'Darker Grotesque',sans-serif",        w:700, fam:'Darker Grotesque', fb:'sans-serif', ls:2,  prow:'clamp(2.6rem,5.4vw,4.4rem)', casesz:'clamp(3.2rem,7.8vw,5.8rem)' },
          d6:    { stack:"'Anton',sans-serif",                   w:400, fam:'Anton',            fb:'sans-serif', ls:2,  prow:'clamp(2.3rem,4.8vw,3.9rem)', casesz:'clamp(2.9rem,7vw,5.3rem)' },
        };
        const rootEl = document.documentElement;
        const pickBtns = Array.from(document.querySelectorAll('[data-fontpick] button'));
        const pickFont = (id) => { const f = FONTS[id]; if (!f) return;
          rootEl.style.setProperty('--display', f.stack);
          rootEl.style.setProperty('--dw', f.w);
          rootEl.style.setProperty('--dps', f.prow);
          rootEl.style.setProperty('--dcs', f.casesz);
          wmW = f.w; wmFam = f.fam; wmFB = f.fb; wmLs = f.ls;
          loadAndDraw();
          pickBtns.forEach((b) => b.classList.toggle('on', b.dataset.f === id));
        };
        pickBtns.forEach((b) => b.addEventListener('click', () => pickFont(b.dataset.f)));

        const SS = coarse ? 1.3 : 1.8; let W = 0, H = 0;
        const resize = () => { W = innerWidth; H = innerHeight; shard.width = Math.round(W * DPR * SS); shard.height = Math.round(H * DPR * SS);
          shard.style.width = W + 'px'; shard.style.height = H + 'px'; gl.viewport(0, 0, shard.width, shard.height); };
        resize(); addEventListener('resize', resize);

        let mtx = 0, mty = 0, pmx = 0, pmy = 0;
        addEventListener('pointermove', (e) => { mtx = e.clientX / innerWidth - 0.5; mty = e.clientY / innerHeight - 0.5; });

        let a = 0, aber = 0, ent = 0, sc = 0, cx = 0, cy = 0, wordAmt = 0;
        const render = () => {
          a += 0.0016;
          ent += (((entered ? 1 : 0)) - ent) * 0.06;   // 0 landing → 1 índice
          const mob = W < H; const fit = mob ? 0.6 + 0.7 * (H / W) : 1;
          // landing: grande y centrado; índice: la gema se corre a la derecha (nombres a la izquierda)
          const scT = (entered ? (mob ? 2.1 : 2.05) : (mob ? 2.2 : 1.95)) * fit;
          sc += (scT - sc) * 0.06;
          const cxT = entered ? (mob ? 0 : 0.30) : 0;      // desktop: gema a la derecha
          cx += (cxT - cx) * 0.06;
          const cyT = entered ? (mob ? 0.28 : 0.0) : 0.02; // mobile: gema arriba, nombres despejados abajo
          cy += (cyT - cy) * 0.06;
          const wt = (wordReady && !entered) ? 1 : 0; wordAmt += (wt - wordAmt) * 0.06;
          pmx += (mtx - pmx) * 0.06; pmy += (mty - pmy) * 0.06;
          const vel = Math.hypot(mtx - pmx, mty - pmy); aber += ((Math.min(1, vel * 30) * 0.5) - aber) * 0.1;
          // idle: mecido desincronizado + mira al cursor (menos parallax cuando es motivo chico)
          const pk = 1 - ent * 0.7;
          const ay = (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07) + pmx * 0.6 * pk;
          const ax = (0.12 + Math.sin(a * 0.33) * 0.07) - pmy * 0.45 * pk;
          const cyw = Math.cos(ay), syw = Math.sin(ay), cxw = Math.cos(ax), sxw = Math.sin(ax);
          const m = new Float32Array([cyw, sxw * syw, -cxw * syw, 0, cxw, sxw, syw, -sxw * cyw, cxw * cyw]);
          gl.uniform2f(uRes, shard.width, shard.height); gl.uniform2f(uCenter, cx, cy); gl.uniform1f(uScale, sc);
          gl.uniform1f(uAber, aber); gl.uniform1f(uWordAmt, wordAmt); gl.uniform1f(uTime, performance.now() * 0.001);
          gl.uniformMatrix3fv(uRot, false, m);
          gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLES, 0, 3);
        };
        if (reduceMotion) { const d = () => render(); d(); addEventListener('resize', d); enterEl.addEventListener('click', () => { let n = 0; const l = () => { render(); if (n++ < 60) requestAnimationFrame(l); }; l(); }); }
        else { const loop = () => { render(); requestAnimationFrame(loop); }; loop(); }
      }
    </script>
  </body>
</html>
