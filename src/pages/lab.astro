          x.fillText(text, 512, 200); uploadTex(c); };
        // sólo dibuja texto si el token es texto (no pisar la ventana en modo imagen 'strip:'/'shot:')
        const initFonts = () => { fontsReady = true; const w = currentWord || 'blopa'; if (w.indexOf(':') < 0) uploadWord(w); };
        if (document.fonts && document.fonts.load) document.fonts.load('400 300px "Bebas Neue"').then(initFonts).catch(initFonts); else initFonts();

        // ── ventana (A): el sitio real refractado dentro del cristal (fija / scroll / flash) ──
        let wordMode = 0;    // 0 = texto · 1 = imagen (lo lee el shader)
        let flashKick = 0;   // timestamp del último corte (flash) → golpe cromático
        const imgEl = {};    // cache de <img> por 'slug:idx'
        const stripCanvas = {};   // cache de la tira apilada por slug (scroll)
        const projBySlug = (s) => projects.find((x) => x.slug === s);
        const imgOf = (slug, idx) => { const k = slug + ':' + idx; let im = imgEl[k];
          if (!im) { im = new Image(); im.src = projBySlug(slug).shots[idx]; imgEl[k] = im; } return im; };
        // una captura, cover-fit en 1024² (modos fija / flash)
        const uploadShot = (im) => { const c = document.createElement('canvas'); c.width = 1024; c.height = 1024; const x = c.getContext('2d');
          x.clearRect(0, 0, 1024, 1024);
          const iw = im.naturalWidth || im.width, ih = im.naturalHeight || im.height;
          const s = Math.max(1024 / iw, 1024 / ih), dw = iw * s, dh = ih * s;
          x.filter = 'blur(3px)';   // disuelve: la captura se vuelve materia difusa, no screenshot
          x.drawImage(im, (1024 - dw) / 2, (1024 - dh) / 2, dw, dh); uploadTex(c); };
        const drawShot = (proj, idx, token) => { const im = imgOf(proj.slug, idx);
          if (im.complete && (im.naturalWidth || 0) > 0) uploadShot(im);
          else im.addEventListener('load', () => { if (currentWord === token) uploadShot(im); }, { once: true }); };
        // la tira: todas las capturas apiladas en vertical → la gema la recorre (scroll)
        const drawStrip = (proj, token) => {
          if (stripCanvas[proj.slug]) { uploadTex(stripCanvas[proj.slug]); return; }
          const ims = proj.shots.map((_, i) => imgOf(proj.slug, i));
          const build = () => { const Wt = 1024; let y = 0;
            const bands = ims.map((im) => { const iw = im.naturalWidth || 1600, ih = im.naturalHeight || 1000;
              const h = Math.round(Wt * (ih / iw)); const b = { im, y, h }; y += h; return b; });
            const c = document.createElement('canvas'); c.width = Wt; c.height = y; const x = c.getContext('2d');
            x.filter = 'blur(3px)';   // disuelve la tira igual que la captura fija
            bands.forEach((b) => x.drawImage(b.im, 0, b.y, Wt, b.h));
            stripCanvas[proj.slug] = c; if (currentWord === token) uploadTex(c); };
          if (ims.every((im) => im.complete && im.naturalWidth)) build();
          else Promise.all(ims.map((im) => im.complete ? Promise.resolve() : new Promise((r) => im.addEventListener('load', r, { once: true })))).then(() => { if (currentWord === token) build(); });
        };
        // aplica lo que la gema sostiene; sólo re-sube la textura cuando cambia el token (no cada frame)
        const applyTexture = (token, mode, proj) => {
          wordMode = mode;
          if (token === currentWord) return;
          currentWord = token;
          if (!token) return;
          if (mode === 1 && proj) {
            if (token.indexOf('strip:') === 0) drawStrip(proj, token);
            else { const idx = parseInt(token.split(':')[2] || '0', 10); drawShot(proj, idx, token);
              if (FX.vmode === 'flash') flashKick = performance.now(); }
          } else if (fontsReady) uploadWord(token);
        };

        const SS = coarse ? 1.2 : 1.5; let W = 0, H = 0;   // el AA de silueta permite bajar el supersampling global
        const resize = () => { W = innerWidth; H = innerHeight; shard.width = Math.round(W * DPR * SS); shard.height = Math.round(H * DPR * SS);
          shard.style.width = W + 'px'; shard.style.height = H + 'px'; gl.viewport(0, 0, shard.width, shard.height); };
        resize(); addEventListener('resize', resize);

        let mtx = 0, mty = 0, pmx = 0, pmy = 0;
        addEventListener('pointermove', (e) => { mtx = e.clientX / innerWidth - 0.5; mty = e.clientY / innerHeight - 0.5; });

        let a = 0, aber = 0, ent = 0, sc = 0, cx = 0, cy = 0, wordAmt = 0, brk = reduceMotion ? 0 : 0.85, last = 0, scInit = false, att = 0;
        let chSpin = 1, chRip = 0, chPulse = 0, chBreath = 0;   // carácter (B) suavizado
        let tintR = 1, tintG = 1, tintB = 1, tintAmt = 0, tX = 0, tY = 0;
        // rotación completa (yaw+pitch+roll), transpuesta para llevar el rayo a espacio objeto
        const rotM = (ax, ay, az) => {
          const cX = Math.cos(ax), sX = Math.sin(ax), cY = Math.cos(ay), sY = Math.sin(ay), cZ = Math.cos(az), sZ = Math.sin(az);
          const rxy = [[cY, 0, sY], [sX * sY, cX, -sX * cY], [-cX * sY, sX, cX * cY]];
          const rz = [[cZ, -sZ, 0], [sZ, cZ, 0], [0, 0, 1]];
          const m = [];
          for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) { let s = 0; for (let k = 0; k < 3; k++) s += rz[r][k] * rxy[k][c]; m[r * 3 + c] = s; }
          return new Float32Array([m[0], m[3], m[6], m[1], m[4], m[7], m[2], m[5], m[8]]);
        };
        const render = (now) => {
          now = now || performance.now();
          const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016); last = now;
          const lp = (r) => 1 - Math.exp(-r * dt);   // easing independiente del framerate
          // ② atención (cabeceo): al señalar, la gema "escucha" — se orienta y frena su idle
          const attT = (entered && hoverProj && FX.cabeceo && !gemBroken) ? 1 : 0;
          att += (attT - att) * lp(5);
          // carácter (B): la gema toma el temperamento del proyecto señalado (o neutro)
          const ch = (FX.caracter && hoverProj && hoverProj.character) ? hoverProj.character : NEUTRAL;
          chSpin += (ch.spin - chSpin) * lp(4); chRip += (ch.ripple - chRip) * lp(4);
          chPulse += (ch.pulse - chPulse) * lp(4); chBreath += (ch.breathe - chBreath) * lp(4);
          a += 0.096 * dt * (1 - att * 0.7) * chSpin;   // idle desacelera al escuchar; el carácter cambia su velocidad
          ent += (((entered ? 1 : 0)) - ent) * lp(3.7);   // 0 landing → 1 índice
          // quiebre: 0 = gema entera · 1 = rota (case abierto). burst = violencia a mitad de transición
          // línea de tiempo del quiebre: fractura (gema visible) → HOLD → se apaga + collage
          const es = (x) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
          let brkT = 0;
          if (gemBroken) { const ts = (performance.now() - caseT0) / 1000;
            if (ts < 0.4) brkT = es(ts / 0.4) * 0.5;                    // 1) se fractura, gema aún visible
            else if (ts < 0.85) brkT = 0.5;                             // 2) HOLD: gema rota a la vista
            else brkT = 0.5 + 0.5 * es(Math.min(1, (ts - 0.85) / 0.5)); // 3) se apaga (collage emerge)
          } else if (!reduceMotion) {
            // carga / vuelta al home: quiebre invertido — de rota (0.85) a entera, rápido al
            // principio y asentando al final (el burst cromático del medio sale gratis)
            const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const x = cs / 1.15; brkT = 0.85 * Math.pow(1 - x, 3); }
          }
          // tinte del rim (accent del proyecto hovereado) + micro-pulso de fractura en hover
          tintAmt += (gemTint.amt - tintAmt) * lp(6);
          tintR += (gemTint.r - tintR) * lp(6); tintG += (gemTint.g - tintG) * lp(6); tintB += (gemTint.b - tintB) * lp(6);
          if (!gemBroken) brkT = Math.max(brkT, tintAmt * 0.012);   // temblor apenas perceptible: el tinte es el evento
          // tensión (C): sostener la atención carga la fractura hacia el estallido (recompensa la curiosidad)
          if (FX.tension && entered && hoverProj && !gemBroken) {
            const tension = Math.min(1, (now - hoverT0) / 1300);
            brkT = Math.max(brkT, tension * 0.42);
          }
          brk += (brkT - brk) * lp(gemBroken ? 30 : 7.5);
          const burst = brk * (1 - brk) * 4.0;
          // nacimiento: la gema se origina en el centro y crece hacia afuera mientras se arma
          // (uScale es inverso: más grande = gema más chica en pantalla)
          let birth = 1;
          if (!inCase && !reduceMotion) { const cs = (now - bootT0) / 1000;
            if (cs < 1.15) { const g = 1 - Math.pow(1 - cs / 1.15, 3); birth = 1 / (0.06 + 0.94 * g); } }
          const mob = W < H; const fit = mob ? 0.6 + 0.7 * (H / W) : 1;
          // landing: grande y centrado; índice: la gema se corre a la derecha (nombres a la izquierda)
          const scT = (entered ? (mob ? MOB_SC : 2.05) : (mob ? 2.2 : 1.95)) * fit * (1 + brk * 0.75);
          if (!scInit) { sc = scT; scInit = true; }   // sin zoom-lerp inicial: el nacimiento manda
          sc += (scT - sc) * lp(3.7);
          const cxT = entered ? (mob ? 0 : 0.30 - att * 0.05) : 0;   // desktop: gema a la derecha; se recuesta hacia los nombres al escuchar
          cx += (cxT - cx) * lp(3.7);
          const cyT = entered ? (mob ? MOB_CY : 0.0) : 0.02; // mobile: gema arriba, nombres despejados abajo
          cy += (cyT - cy) * lp(3.7);
          // qué sostiene la gema (según FX): landing = 'blopa'; índice = ventana (fija/scroll/flash) o nombre
          let token = null, tmode = 0, winFracV = 1, scrollV = 0;
          if (!entered) { token = 'blopa'; tmode = 0; }
          else if (hoverProj && !gemBroken) {
            if (FX.ventana) {
              tmode = 1; const N = (hoverProj.shots || []).length || 1;
              if (FX.vmode === 'flash') { const idx = Math.floor(now / 480) % N; token = 'shot:' + hoverProj.slug + ':' + idx; }
              else if (FX.vmode === 'scroll') { token = 'strip:' + hoverProj.slug;
                winFracV = 0.42; const ph = ((now / 1000) / 6.5) % 1;   // recorre la tira: ping-pong suave arriba↔abajo
                scrollV = (1 - winFracV) * (0.5 - 0.5 * Math.cos(ph * 6.28318)); }
              else { token = 'shot:' + hoverProj.slug + ':0'; }   // fija
            } else if (FX.nombre) { token = hoverProj.name; tmode = 0; }
          }
          applyTexture(token, tmode, hoverProj);
          const wt = (wordReady && token && !gemBroken && brk < 0.55) ? 1 : 0;   // tolera la pre-fractura de tensión
          wordAmt += (wt - wordAmt) * lp(entered ? 8.5 : 3.7);
          pmx += (mtx - pmx) * lp(3.7); pmy += (mty - pmy) * lp(3.7);
          const vel = Math.hypot(mtx - pmx, mty - pmy) * (0.0166 / Math.max(dt, 0.008));
          aber += ((Math.min(1, vel * 30) * 0.5) - aber) * lp(6.3);
          aber = Math.max(aber, burst * 1.4);   // estallido cromático al romperse
          aber = Math.max(aber, Math.max(0, 1 - (now - flashKick) / 260) * 0.6);   // golpe cromático en cada corte (flash)
          // idle: mecido desincronizado + mira al cursor (menos parallax cuando es motivo chico)
          // al escuchar (att), sigue al cursor con más ganas: se "clava" en el nombre señalado
          const pk = (1 - ent * 0.7) * (1 + att * 1.3);
          // sesgo de orientación hacia los nombres: desktop están a la izquierda (yaw); mobile abajo (pitch)
          const aimYaw = mob ? 0 : -0.5 * att;
          const aimPitch = mob ? 0.32 * att : 0;
          // rotación orgánica: varias frecuencias desincronizadas (no mecánico) + parallax + atención
          const ay = (Math.sin(a * 0.5) * 0.2 + Math.sin(a * 0.23) * 0.07 + Math.sin(a * 0.12 + 1.3) * 0.055) + pmx * 0.6 * pk + aimYaw;
          const ax = (0.12 + Math.sin(a * 0.33) * 0.07 + Math.sin(a * 0.17 + 0.6) * 0.045) - pmy * 0.45 * pk + aimPitch;
          const az = Math.sin(a * 0.21 + 2.0) * 0.06 + Math.sin(a * 0.09) * 0.04;   // roll sutil: tumble orgánico
          const m = rotM(ax, ay, az);
          const fx = Math.sin(a * 0.6) * 0.004, fy = Math.sin(a * 0.42 + 0.8) * 0.006;   // flotación suave
          // tilt del collage: misma física exponencial que todo lo demás (nada de transition-chasing)
          tX += (tilt.tx - tX) * lp(5.5); tY += (tilt.ty - tY) * lp(5.5);
          stageEl.style.setProperty('--rx', tX.toFixed(2) + 'deg'); stageEl.style.setProperty('--ry', tY.toFixed(2) + 'deg');
          // carácter: latido (pulse) y respiración (breathe) modulan la escala (uScale es inverso: menor = gema más grande)
          const beat = chPulse * Math.pow(Math.max(0, Math.sin(now * 0.006)), 8.0);
          const breathe = chBreath * Math.sin(now * 0.0016);
          const scMod = 1 - beat * 0.06 + breathe * 0.045;
          gl.uniform2f(uRes, shard.width, shard.height); gl.uniform2f(uCenter, cx + fx, cy + fy); gl.uniform1f(uScale, sc * birth * scMod);
          gl.uniform1f(uAber, aber); gl.uniform1f(uWordAmt, wordAmt); gl.uniform1f(uTime, performance.now() * 0.001);
          gl.uniform1f(uBreak, brk); gl.uniform3f(uTint, tintR, tintG, tintB); gl.uniform1f(uTintAmt, tintAmt);
          gl.uniform1f(uWordMode, wordMode); gl.uniform1f(uRipple, chRip * 0.7);
          gl.uniform1f(uWinFrac, winFracV); gl.uniform1f(uScroll, scrollV);
          gl.uniformMatrix3fv(uRot, false, m);
          gl.clear(gl.COLOR_BUFFER_BIT);
          if (brk < 0.93) gl.drawArrays(gl.TRIANGLES, 0, 3);   // gema rota y apagada (case abierto): no raymarchear de fondo
        };
        if (reduceMotion) { const d = () => render(); d(); addEventListener('resize', d); enterEl.addEventListener('click', () => { let n = 0; const l = () => { render(); if (n++ < 60) requestAnimationFrame(l); }; l(); }); }
        else { const loop = (t) => { render(t); requestAnimationFrame(loop); }; requestAnimationFrame(loop); }
      }
    </script>
  </body>
</html>
